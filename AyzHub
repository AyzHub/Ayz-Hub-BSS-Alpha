        need("Events.PlayerHiveCommand", events:FindFirstChild("PlayerHiveCommand"))
        if S.PolarQuest then
            need("Events.GiveQuest", events:FindFirstChild("GiveQuest"))
            need("Events.CompleteQuest", events:FindFirstChild("CompleteQuest"))
        end
    end
    need("workspace.FlowerZones", workspace:FindFirstChild("FlowerZones"))
    need("workspace.Honeycombs", workspace:FindFirstChild("Honeycombs"))
    need("workspace.Collectibles", workspace:FindFirstChild("Collectibles"))
    if S.PolarQuest then
        need("workspace.NPCs.Polar Bear", workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("Polar Bear"))
