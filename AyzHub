local function stepper(tab, text, key, step, minV, maxV, suffix, hint, onChange)
    local r = row(tab, hint and 46 or 34)
    rowTexts(r, text, hint, 160)
    local function mk(txt, xOff)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(26, 24), Position = UDim2.new(1, xOff, 0.5, -12),
            BackgroundColor3 = THEME.panel2, TextColor3 = THEME.accent, Text = txt,
            Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0,
        }, r)
        round(b, 6)
        return b
    end
    local plus = mk("+", -36)
    local minus = mk("-", -142)
    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(74, 24), Position = UDim2.new(1, -112, 0.5, -12),
        TextColor3 = THEME.text, Font = Enum.Font.GothamMedium, TextSize = 12, Text = "",
    }, r)
    local function refresh()
        valueLabel.Text = fmtNumber(S[key], suffix)
    end
    local function change(dir)
        local v = S[key] + dir * step
        v = math.max(minV, math.min(maxV, v))
        S[key] = math.floor(v * 1000 + 0.5) / 1000
        refresh()
        if onChange then onChange() end
        save()
    end
    connect(plus.MouseButton1Click, function() change(1) end)
    connect(minus.MouseButton1Click, function() change(-1) end)
    refresh()
    refreshers[#refreshers + 1] = refresh
end

