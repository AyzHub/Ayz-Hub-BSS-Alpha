        local sp = player:FindFirstChild("SpawnPos")
        print("[BSSFarm] player.SpawnPos:", sp and sp.ClassName or "none", tostring(posOf(sp)))
        print("[BSSFarm] hive SpawnPos / hivePos:", tostring(hive and posOf(hive:FindFirstChild("SpawnPos"))),
            "/", tostring(hive and hivePos(hive)))
        local root = hrp()
