    nextAt = 0,
    defaults = {
        { key = "BoostBlue", name = "Blue Field Booster", match = "blue" },
        { key = "BoostRed", name = "Red Field Booster", match = "red" },
        { key = "BoostWhite", name = "Field Booster", match = "white" },
    },
