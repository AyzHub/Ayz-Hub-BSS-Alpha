-- Gece spawn olabilen tarlalar (Rogue Vicious Bee)
local PATROL_KEYS = { "clover", "spider", "cactus", "rose", "mountain", "pepper" }

-- Bu gece henuz kontrol edilmemis en yakin spawn tarlasi
local function nextPatrolZone(fromPos)
    local fz = workspace:FindFirstChild("FlowerZones")
    if not fz then
        return nil
    end
    local best, bestKey, bestD = nil, nil, math.huge
    for _, key in ipairs(PATROL_KEYS) do
        if not patrolVisited[key] then
            local found = false
            for _, z in ipairs(fz:GetChildren()) do
                if z:IsA("BasePart") and string.find(string.lower(z.Name), key, 1, true) then
                    found = true
                    local d = flat(z.Position, fromPos)
                    if d < bestD then
                        best, bestKey, bestD = z, key, d
                    end
                    break
                end
            end
            if not found then
                patrolVisited[key] = true -- bu isimde tarla yok, atla
            end
        end
    end
    return best, bestKey
end

-- Bir noktanin ait oldugu tarla (icindeyse o, degilse yeterince yakin olan en yakin tarla)
local function fieldOfPos(p)
    local fz = workspace:FindFirstChild("FlowerZones")
    if not fz then
        return nil
    end
    -- Her tarla icin: noktanin tarlanin merkezine goreli konumu (0 = merkez, 1 = kenar)
    -- ve yukseklik farki. Ic ice / ust uste tarlalarda en "merkezi" olan secilir.
    local best, bestScore = nil, math.huge
    local near, nearD = nil, math.huge
    for _, z in ipairs(fz:GetChildren()) do
        if z:IsA("BasePart") then
            local l = z.CFrame:PointToObjectSpace(p)
            local hx, hz = math.max(1, z.Size.X / 2), math.max(1, z.Size.Z / 2)
            local nx, nz = math.abs(l.X) / hx, math.abs(l.Z) / hz
            local dy = p.Y - fieldTop(z)
            if dy > -20 and dy < 60 and nx <= 1.08 and nz <= 1.08 then
                local score = math.max(nx, nz) + math.abs(dy) / 300
                if score < bestScore then
                    best, bestScore = z, score
                end
            end
            local ex, ez = math.max(0, math.abs(l.X) - hx), math.max(0, math.abs(l.Z) - hz)
            local edge = math.sqrt(ex * ex + ez * ez) + math.abs(dy) * 0.5
            if edge < nearD then
                near, nearD = z, edge
            end
        end
    end
    if best then
        return best
    end
    if near and nearD < 50 then
        return near
    end
    return nil
end

-- Rogue Vicious Bee, tarlada kucuk gri bir SIVRI (spike) olarak bekler; ona dokunmak / yaklasmak
-- bee'yi dogurur. Adini kesin bilmedigimiz icin "spike" / "stinger" iceren, canli Humanoid'i
-- olmayan, 6 spawn tarlasindan birinin icindeki nesneleri aday sayariz.
viciousSignal.skip = setmetatable({}, { __mode = "k" })
viciousSignal.spikeCache = nil
viciousSignal.spikeScanAt = 0

viciousSignal.isSpike = function(inst)
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then
        return false
    end
    local n = string.lower(inst.Name)
    if not (string.find(n, "spike", 1, true) or string.find(n, "stinger", 1, true)) then
        return false
    end
    if string.find(n, "thorn", 1, true) then
        return false -- bee'nin firlattigi dikenler
    end
    for _, w in ipairs(DECOR_WORDS) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
        return false
    end
    if inOwnArea(inst) then
        return false
    end
    local pos = targetPos(inst)
    if not pos or not strictlyInAField(pos) then
        return false
    end
    -- sadece Vicious'in dogabildigi tarlalar
    local z = fieldOfPos(pos)
    if not z then
        return false
    end
    local zn = string.lower(z.Name)
    for _, key in ipairs(PATROL_KEYS) do
        if string.find(zn, key, 1, true) then
            return true
        end
    end
    return false
end

viciousSignal.findSpike = function()
    local now = tick()
    local c = viciousSignal.spikeCache
    if c and c.Parent and (viciousSignal.skip[c] or 0) < now then
        return c
    end
    viciousSignal.spikeCache = nil
    if now < viciousSignal.spikeScanAt then
        return nil
    end
    -- geceleri / oyun bildirim verdiyse sik, gunduz seyrek tara (tarama pahali)
    local active = nightInfo.night or (now - viciousSignal.at < 60)
    viciousSignal.spikeScanAt = now + (active and 4 or 20)
    local found
    pcall(boundedWalk, workspace, 4, 8000, function(d)
        if (viciousSignal.skip[d] or 0) < now and viciousSignal.isSpike(d) then
            found = d
            return true
        end
        return false
    end)
    viciousSignal.spikeCache = found
    return found
end

