        dump("Character", c)
        dump("Backpack", bp)
        local anyTool = (c and c:FindFirstChildOfClass("Tool") ~= nil) or (bp and bp:FindFirstChildOfClass("Tool") ~= nil)
        print("[BSSFarm] Tool objects found:", tostring(anyTool),
            anyTool and "" or "(none: the game likely handles tools itself; script will use Events.ToolCollect)")
        print("[BSSFarm] Events.ToolCollect exists:", tostring(RS:FindFirstChild("Events")
            and RS.Events:FindFirstChild("ToolCollect") ~= nil))
        local ev = RS:FindFirstChild("Events")
        if ev then
            for _, e in ipairs(ev:GetChildren()) do
                local n = string.lower(e.Name)
                if string.find(n, "tool", 1, true) or string.find(n, "click", 1, true)
                    or string.find(n, "collect", 1, true) or string.find(n, "swing", 1, true) then
                    print("[BSSFarm] remote:", e.ClassName, e.Name)
                end
            end
        end
        setStatus("tool debug printed to the console (F9)")
    end

    task.spawn(function()
        while running do
            local interval = math.max(0.2, S.ToolInterval)
            if S.AutoFarm and not converting and S.AutoTool then
                local tool = equipCollector()
                if tool and tool.Parent == player.Character then
