-- ======================================================== Auto Sprinkler
-- Tarlaya girince Sprinkler Builder'i (envanterdeki kalici arac) kullanarak sprinkler yerlestirir.
-- Tarla basina bir kez; tarla degisince / karakter olunce yeniden yerlestirir.
-- (Yeni top-level local acilmasin diye env.BSSSprinkler icinde.)
env.BSSSprinkler = { zone = nil, n = 0, tries = 0 }

env.BSSSprinkler.reset = function()
    local C = env.BSSSprinkler
    C.zone, C.n, C.tries = nil, 0, 0
end
connect(player.CharacterAdded, function()
    env.BSSSprinkler.reset()
end)

env.BSSSprinkler.fire = function()
    local events = RS:FindFirstChild("Events")
    local r = events and events:FindFirstChild("PlayerActivesCommand")
    if not r then
        return false
    end
    return (pcall(function() r:FireServer({ Name = "Sprinkler Builder" }) end))
end

env.BSSSprinkler.offsets = function(n, s)
    if n <= 1 then
        return { { 0, 0 } }
    elseif n == 2 then
        return { { -s, 0 }, { s, 0 } }
    elseif n == 3 then
        return { { -s, -s * 0.6 }, { s, -s * 0.6 }, { 0, s * 0.9 } }
    elseif n == 4 then
        return { { -s, -s }, { s, -s }, { -s, s }, { s, s } }
    end
    return { { 0, 0 }, { -s, -s }, { s, -s }, { -s, s }, { s, s } }
end

-- Bir adim: sirada yerlestirilecek sprinkler varsa oraya gidip yerlestirir. Is yaptiysa true doner.
env.BSSSprinkler.step = function(zone)
    local C = env.BSSSprinkler
    if not S.AutoSprinkler then
        return false
    end
    if C.zone ~= zone.Name then
        C.zone, C.n, C.tries = zone.Name, 0, 0
    end
    local want = math.max(1, math.min(5, math.floor(S.SprinklerCount)))
    if C.n >= want or C.tries >= want * 3 then
        return false
    end
    local o = env.BSSSprinkler.offsets(want, S.SprinklerSpacing)[C.n + 1]
    local hx = math.max(1, zone.Size.X / 2 - math.max(3, S.FieldMargin))
    local hz = math.max(1, zone.Size.Z / 2 - math.max(3, S.FieldMargin))
    local wp = zone.CFrame:PointToWorldSpace(Vector3.new(math.clamp(o[1], -hx, hx), 0, math.clamp(o[2], -hz, hz)))
    setStatus(string.format("sprinkler %d/%d: moving to the spot...", C.n + 1, want))
    moveTo(Vector3.new(wp.X, groundY(zone, wp.X, wp.Z) + S.TweenHeight, wp.Z))
    if not (running and S.AutoFarm) then
        return true
    end
    task.wait(0.6) -- yere insin (cicekin ustunde dururken yerlestirilir)
    C.tries = C.tries + 1
    if C.fire() then
        C.n = C.n + 1
        setStatus(string.format("sprinkler %d/%d placed", C.n, want))
    else
        setStatus("sprinkler: Events.PlayerActivesCommand not found")
    end
    task.wait(1.1) -- oyunda 1 sn bekleme suresi var
    return true
end

-- ======================================================== Discord webhook
-- Vicious Bee'den gelen stinger'lari envanter farkindan sayar ve istege bagli her N dakikada
-- (varsayilan 20) Discord'a rapor yollar. (Yeni top-level local acilmasin diye env.BSSWebhook icinde.)
env.BSSWebhook = {
    base = nil, last = nil, lastReport = nil, kills = 0, startAt = tick(), nextAt = 0,
    info = "Webhook: not configured", label = nil,
}
do
    local WH = env.BSSWebhook

    local function requestFn()
        if syn and type(syn.request) == "function" then return syn.request end
        if http and type(http.request) == "function" then return http.request end
        if type(http_request) == "function" then return http_request end
        if type(request) == "function" then return request end
        if fluxus and type(fluxus.request) == "function" then return fluxus.request end
        return nil
    end

    WH.url = function()
        return (tostring(S.WebhookUrl or ""):gsub("%s+", "")) -- yapistirirken kalan bosluk / satir sonu
    end

    WH.validUrl = function(u)
        u = (tostring(u or ""):gsub("%s+", ""))
        return string.find(u, "^https://discord%.com/api/webhooks/") ~= nil
            or string.find(u, "^https://discordapp%.com/api/webhooks/") ~= nil
            or string.find(u, "^https://ptb%.discord%.com/api/webhooks/") ~= nil
            or string.find(u, "^https://canary%.discord%.com/api/webhooks/") ~= nil
    end

    WH.send = function(embed, content)
        if not WH.validUrl(S.WebhookUrl) then
            WH.info = "Webhook: URL is empty or not a Discord webhook link"
            return false
        end
        local req = requestFn()
        if not req then
            WH.info = "Webhook: this executor has no request function"
            return false
        end
        local code, ok, res
        for attempt = 1, 3 do
            ok, res = pcall(function()
                return req({
                    Url = WH.url(), Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({
                        username = "AyzHub", content = content, embeds = embed and { embed } or nil,
                    }),
                })
            end)
            code = ok and type(res) == "table" and (res.StatusCode or res.status_code) or nil
            if code == 429 and attempt < 3 then
                task.wait(2.5 * attempt) -- Discord hiz siniri: biraz bekleyip tekrar dene
            else
                break
            end
        end
        if ok and type(code) == "number" and code >= 200 and code < 300 then
            WH.info = "Webhook: last message sent at " .. os.date("%H:%M:%S")
            return true
        end
        if ok and code == nil and type(res) == "table" and res.Success == true then
            WH.info = "Webhook: last message sent at " .. os.date("%H:%M:%S")
            return true
        end
        WH.info = "Webhook: send failed" .. (code and (" (HTTP " .. tostring(code) .. ")") or "")
        return false
    end

    local function findKey(t, depth)
        if type(t) ~= "table" or depth > 3 then
            return nil
        end
        for k, v in pairs(t) do
            if type(k) == "string" and type(v) == "number" then
                local nk = string.gsub(string.lower(k), "[^%a]", "")
                if nk == "stinger" or nk == "stingers" then
                    return v
                end
            end
        end
        for _, v in pairs(t) do
            if type(v) == "table" then
                local r = findKey(v, depth + 1)
                if r then
                    return r
                end
            end
        end
        return nil
    end

    -- Envanterdeki Stinger sayisi (oyunun ClientStatCache'inden). Okunamazsa nil.
    WH.readStatTable = function()
        local m = RS:FindFirstChild("ClientStatCache")
        if not m then
            return nil
        end
        local cache = require(m)
        local st = cache:Get()
        return type(st) == "table" and st or nil
    end
    WH.readStinger = function()
        local ok, res = pcall(function()
            local st = WH.readStatTable()
            if not st then
                return nil
            end
            if type(st.Eggs) == "table" then
                local v = findKey(st.Eggs, 0)
                if v then
                    return v
                end
            end
            -- baska bir yerde tutuluyor olabilir: tum tabloda ara (esya hic yoksa anahtar da yoktur: 0)
            return findKey(st, 0) or (type(st.Eggs) == "table" and 0 or nil)
        end)
        return ok and res or nil
    end

    WH.sample = function()
        local cur = WH.readStinger()
        if cur then
            WH.last = cur
            if not WH.base then
                WH.base, WH.lastReport = cur, cur
            end
        end
    end

    WH.report = function()
        local cur = WH.readStinger()
        local fields
        if cur == nil then
            fields = { { name = "Stingers", value = "Could not read the stinger count", inline = false } }
        else
            WH.base = WH.base or cur
            WH.lastReport = WH.lastReport or cur
            local secs = math.floor(tick() - WH.startAt)
            fields = {
                { name = "Stingers gained (session)", value = tostring(cur - WH.base), inline = true },
                { name = "Since last report", value = tostring(cur - WH.lastReport), inline = true },
                { name = "Stingers now", value = tostring(cur), inline = true },
                { name = "Vicious Bees killed (session)", value = tostring(WH.kills), inline = true },
                { name = "Running for", value = string.format("%dh %02dm", math.floor(secs / 3600), math.floor(secs % 3600 / 60)), inline = true },
            }
        end
        local ok = WH.send({
            title = "Stinger report", color = 4676316, fields = fields,
            footer = { text = player.Name }, timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        })
        if ok and cur then
            WH.lastReport = cur
            WH.last = cur
        end
        return ok
    end

    WH.test = function()
        local ok = WH.send({
            title = "AyzHub webhook test", color = 4676316,
            description = "If you can read this, the webhook works.",
            footer = { text = player.Name },
        })
        setStatus(ok and "webhook: test message sent" or WH.info)
    end

    WH.reset = function()
        WH.sample()
        WH.base, WH.lastReport, WH.kills, WH.startAt = WH.last, WH.last, 0, tick()
        setStatus("stinger counter reset")
    end

    -- savas BASLARKEN cagrilir: stinger sayisini o an kaydeder (loot dusmeden onceki taban)
    WH.beginFight = function()
        local v = WH.readStinger()
        WH.fightBefore = v or WH.last or WH.base
    end

    -- farm dongusu bir Vicious Bee'nin oldugunu fark edince cagrilir
    WH.onKill = function()
        WH.kills = WH.kills + 1
        if not (S.WebhookOnKill and WH.validUrl(S.WebhookUrl)) then
            return
        end
        local before = WH.fightBefore or WH.last or WH.base
        WH.fightBefore = nil
        local killNo = WH.kills
        task.spawn(function()
            -- stinger'lar olunce otomatik envantere gelir: artis olup 3 sn degismezse (en az 3 sn sonra)
            -- hemen gonder, artis yoksa en fazla 15 sn bekle
            local t0 = tick()
            local cur, lastVal, stableSince
            while running and tick() - t0 < 15 do
                task.wait(1)
                local v = WH.readStinger()
                if v then
                    cur = v
                    if v ~= lastVal then
                        lastVal, stableSince = v, tick()
                    end
                    if before and v > before and tick() - t0 >= 3 and tick() - stableSince >= 3 then
                        break
                    end
                end
            end
            if not running then
                return
            end
            local desc = "Stinger count could not be read"
            local gained
            if cur and before then
                gained = cur - before
                if gained > 0 then
                    desc = string.format("Stingers from this kill: **+%d** (now %d)", gained, cur)
                else
                    desc = string.format("No new stingers detected (now %d).", cur)
                end
            elseif cur then
                desc = string.format("Stingers now: %d (the count before the fight was not readable)", cur)
            end
            WH.send({
                title = "Vicious Bee killed", color = 14721072, description = desc,
                fields = {
                    { name = "Vicious kills (session)", value = tostring(killNo), inline = true },
                    { name = "Stingers gained (session)",
                        value = (cur and WH.base) and tostring(cur - WH.base) or "?", inline = true },
                },
                footer = { text = player.Name }, timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            })
            if cur then
                WH.last = cur
            end
        end)
    end

    WH.summary = function()
        local lines = { WH.info }
        if WH.base and WH.last then
            lines[#lines + 1] = string.format("Stingers: %d now, +%d this session", WH.last, WH.last - WH.base)
        else
            lines[#lines + 1] = "Stingers: not readable yet"
        end
        lines[#lines + 1] = "Vicious kills seen: " .. WH.kills
        if S.WebhookReport and WH.nextAt > 0 then
            lines[#lines + 1] = string.format("Next report in ~%d min", math.max(0, math.ceil((WH.nextAt - tick()) / 60)))
        end
        return table.concat(lines, "\n")
    end

    WH.debug = function()
        print("[BSSFarm] ---------------- webhook / stinger debug ----------------")
        print("[BSSFarm] url valid:", tostring(WH.validUrl(S.WebhookUrl)), "| request fn:", tostring(requestFn() ~= nil))
        local ok, st = pcall(WH.readStatTable)
        if not ok or not st then
            print("[BSSFarm] ClientStatCache could not be read:", tostring(st))
        else
            local keys = {}
            for k, v in pairs(st) do
                keys[#keys + 1] = tostring(k) .. (type(v) == "table" and "{}" or "")
            end
            print("[BSSFarm] stat table keys:", table.concat(keys, ", "))
        end
        print("[BSSFarm] stinger count:", tostring(WH.readStinger()), "| base:", tostring(WH.base), "| kills:", WH.kills,
            "| before-fight:", tostring(WH.fightBefore))
        setStatus("webhook debug printed to the console (F9)")
    end

    task.spawn(function()
        while running do
            pcall(WH.sample)
            if S.WebhookReport and WH.validUrl(S.WebhookUrl) then
                if WH.nextAt == 0 then
                    WH.nextAt = tick() + math.max(1, S.WebhookMinutes) * 60
                end
                if tick() >= WH.nextAt then
                    WH.nextAt = tick() + math.max(1, S.WebhookMinutes) * 60
                    pcall(WH.report)
                end
            else
                WH.nextAt = 0
            end
            if WH.label then
                WH.label.Text = WH.summary()
            end
            task.wait(10)
        end
    end)
end

-- ======================================================== Farm Blooms
-- Tarlada beliren Bloom'lari bulur, secili renklerdekine gidip patlatir ve (secili renkteki)
-- Bloom Petal'lerini toplar. Renk: nesnenin adindan, yoksa rengine bakilarak anlasilir.
-- (Yeni top-level local acilmasin diye env.BSSBloom icinde.)
env.BSSBloom = {
    set = {}, skip = setmetatable({}, { __mode = "k" }), petalSkip = setmetatable({}, { __mode = "k" }),
    petalTries = setmetatable({}, { __mode = "k" }), colCache = setmetatable({}, { __mode = "k" }),
    cur = nil, curZone = nil, startAt = 0, zoneName = nil, lootUntil = 0, lootZone = nil, popped = 0,
    deepAt = 0, pNext = 0, pRes = nil, label = nil, info = "Blooms: off",
    COLORS = { "Black", "Gray", "Yellow", "White", "Pink", "Red", "Scarlet", "Cyan", "Violet", "Merrygold", "Green" },
    RGB = {
        Black = { 25, 25, 28 }, Gray = { 128, 128, 134 }, Yellow = { 250, 215, 40 }, White = { 245, 245, 245 },
        Pink = { 255, 150, 200 }, Red = { 215, 45, 45 }, Scarlet = { 150, 15, 35 }, Cyan = { 50, 210, 235 },
        Violet = { 150, 70, 220 }, Merrygold = { 245, 170, 30 }, Green = { 60, 190, 70 },
    },
    badParents = { Toys = true, Planters = true, PlanterModels = true, Honeycombs = true, NPCs = true,
        Bees = true, Collectibles = true,
        -- yanlis algilananlar: dukkanlar, dekorlar, event klasorleri (Brick Blooms vs.)
        Shops = true, Decorations = true, Happenings = true },
    badWords = { "shaker", "petal", "gui", "icon", "bar", "beam", "attach", "shadow", "summon",
        "shuriken", "shop", "brick", "decoration" },
    -- Petal olarak sayilmayacak isimler (Petal Shop, PetalShuriken, Petal Wand modeli vs.)
    badPetalWords = { "shuriken", "shop", "wand", "brick", "decoration", "shaker", "gui", "icon", "beam", "attach", "shadow" },
    -- Ustlerinden biri bu kelimeleri iceriyorsa (ornegin "Petal Shop" altindaki her sey) yok sayilir
    badAncestorWords = { "shop", "shuriken", "brick", "decoration" },
}

-- inst'in kendisi ya da ustlerinden biri yasakli klasor / isim mi? (Shops, Decorations, Happenings, "* Shop" ...)
env.BSSBloom.badPath = function(inst)
    local C = env.BSSBloom
    local a = inst
    while a and a ~= workspace do
        if C.badParents[a.Name] then
            return true
        end
        local ln = string.lower(a.Name)
        for _, w in ipairs(C.badAncestorWords) do
            if string.find(ln, w, 1, true) then
                return true
            end
        end
        a = a.Parent
    end
    return false
end

-- Gercek bir Bloom Petal mi? (ismi "petal" iceren HER SEY degil)
env.BSSBloom.isPetal = function(inst)
    local C = env.BSSBloom
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then
        return false
    end
    local n = string.lower(inst.Name)
    if not string.find(n, "petal", 1, true) then
        return false
    end
    for _, w in ipairs(C.badPetalWords) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    local a = inst.Parent
    while a and a ~= workspace do
        if C.badParents[a.Name] and a.Name ~= "Collectibles" then
            return false
        end
        local ln = string.lower(a.Name)
        for _, w in ipairs(C.badAncestorWords) do
            if string.find(ln, w, 1, true) then
                return false
            end
        end
        a = a.Parent
    end
    -- sadece Collectibles / Particles icindeki petal'ler gercek (Shops, Decorations, workspace koku vs. degil)
    local par = inst.Parent
    if not par or (par.Name ~= "Collectibles" and par.Name ~= "Particles") then
        return false
    end
    return true
end

-- Auto farm'in o an kastigi tarla (bloom'un kendi tarla secimi haric): sprout > quest > secili tarla
env.BSSBloom.baseFieldName = function()
    local sp = env.BSSSprout
    if (S.AutoSprouts or S.AutoPuffshrooms) and sp and sp.zoneName then
        return sp.zoneName
    end
    if S.PolarQuest and S.QuestFarmFields and questState.field then
        return questState.field
    end
    return S.Field
end

env.BSSBloom.reset = function()
    local C = env.BSSBloom
    C.cur, C.curZone, C.zoneName = nil, nil, nil
    C.deepAt = 0
end

-- Bloom / Petal'in rengi: once ad / ozellik, sonra gorunen renk (belirsizse nil)
env.BSSBloom.colorOf = function(inst)
    local C = env.BSSBloom
    local cached = C.colCache[inst]
    if cached ~= nil then
        return cached or nil
    end
    local found
    local function byText(t)
        t = string.lower(t)
        for _, c in ipairs(C.COLORS) do
            if string.find(t, string.lower(c), 1, true) then
                return c
            end
        end
        return nil
    end
    found = byText(inst.Name)
    if not found then
        pcall(function()
            for _, v in pairs(inst:GetAttributes()) do
                if type(v) == "string" then
                    found = found or byText(v)
                end
            end
        end)
    end
    if not found then
        local part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
        if part then
            local col = part.Color
            local r, g, b = col.R * 255, col.G * 255, col.B * 255
            local bestD
            for _, c in ipairs(C.COLORS) do
                local v = C.RGB[c]
                local d = math.sqrt((r - v[1]) ^ 2 + (g - v[2]) ^ 2 + (b - v[3]) ^ 2)
                if not bestD or d < bestD then
                    found, bestD = c, d
                end
            end
            if bestD and bestD > 70 then
                found = nil
            end
        end
    end
    C.colCache[inst] = found or false
    return found
end

env.BSSBloom.allowed = function(color)
    if color == nil then
        return S.BloomOther ~= false
    end
    return S["Bloom" .. color] ~= false
end

env.BSSBloom.isBloom = function(inst)
    local C = env.BSSBloom
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then
        return false
    end
    local n = string.lower(inst.Name)
    if not string.find(n, "bloom", 1, true) then
        return false
    end
    for _, w in ipairs(C.badWords) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    if inst:IsA("BasePart") and inst.Size.Magnitude < 1.5 then
        return false
    end
    if inOwnArea(inst) then
        return false
    end
    if C.badPath(inst) then
        return false
    end
    return true
end

env.BSSBloom.register = function(inst)
    local C = env.BSSBloom
    local a = inst.Parent
    while a and a ~= workspace do
        if C.set[a] then
            return
        end
        a = a.Parent
    end
    for k in pairs(C.set) do
        if k ~= inst and k:IsDescendantOf(inst) then
            C.set[k] = nil
        end
    end
    if not C.set[inst] then
        C.set[inst] = tick()
    end
end

connect(workspace.DescendantAdded, function(inst)
    local C = env.BSSBloom
    if S.FarmBlooms and string.find(string.lower(inst.Name), "bloom", 1, true) and C.isBloom(inst) then
        C.register(inst)
    end
end)

-- Her saniye: bloom'lari bul / sec / patlamasini izle; hangi tarlada farm edilecegini guncelle
env.BSSBloom.update = function()
    local C = env.BSSBloom
    if not S.FarmBlooms then
        C.cur, C.curZone, C.zoneName = nil, nil, nil
        C.info = "Blooms: off"
        return
    end
    local now = tick()
    local root = hrp()
    if now >= C.deepAt then
        C.deepAt = now + 60
        pcall(boundedWalk, workspace, 4, 6000, function(d)
            if string.find(string.lower(d.Name), "bloom", 1, true) and C.isBloom(d) then
                C.register(d)
            end
            return false
        end)
    end
    for k in pairs(C.set) do
        if not k.Parent or C.badPath(k) then
            C.set[k] = nil
        end
    end
    local only = S.BloomOnlyFarmField
    local baseName = only and C.baseFieldName() or nil
    if C.cur and only and (not C.curZone or C.curZone.Name ~= baseName) then
        C.cur, C.curZone = nil, nil -- hedef farm tarlasinin disinda kaldi: birak
    end
    if C.cur then
        if not C.cur.Parent then
            C.popped = C.popped + 1
            C.lootUntil = now + 8 -- petal'ler dusene kadar tarlada kal
            C.lootZone = C.curZone and C.curZone.Name
            C.cur, C.curZone = nil, nil
        elseif now - C.startAt > math.max(10, S.BloomGiveUpSec) then
            C.skip[C.cur] = true
            C.cur, C.curZone = nil, nil
        end
    end
    if not C.cur then
        local best, bestD, bestZ
        for inst in pairs(C.set) do
            if not C.skip[inst] and C.allowed(C.colorOf(inst)) then
                local p = targetPos(inst)
                local z = p and fieldOfPos(p)
                if z and (not only or z.Name == baseName) and not (env.BSSSprout and env.BSSSprout.isAntField(z))
                    and inField(z, p, 0) and math.abs(p.Y - fieldTop(z)) < 40 then
                    local d = root and (p - root.Position).Magnitude or 0
                    if not bestD or d < bestD then
                        best, bestD, bestZ = inst, d, z
                    end
                end
            end
        end
        if best then
            C.cur, C.curZone, C.startAt = best, bestZ, now
            C.lootUntil = 0
        end
    end
    if C.cur then
        -- "sadece farm tarlasi" aciksa tarla degistirilmez (zoneName hep nil kalir)
        C.zoneName = (not only) and C.curZone and C.curZone.Name or nil
        C.info = string.format("Popping %s bloom in %s (%d s)", C.colorOf(C.cur) or "?",
            C.curZone and C.curZone.Name or "?", math.floor(now - C.startAt))
    elseif now < C.lootUntil and C.lootZone and not only then
        C.zoneName = C.lootZone
        C.info = "Popped! collecting petals in " .. C.lootZone
    else
        C.zoneName = nil
        C.info = (only and ("Blooms: none in " .. tostring(baseName)) or "Blooms: none found")
            .. (C.popped > 0 and (" (" .. C.popped .. " popped)") or "")
    end
end

