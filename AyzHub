-- ------------------------------------------------------------------ yardimcilar

local function hrp()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function hum()
    local c = player.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function stat(name)
    local cs = player:FindFirstChild("CoreStats")
    local v = cs and cs:FindFirstChild(name)
    return (v and v.Value) or 0
end

local function posOf(inst)
    if not inst then
        return nil
    end
    -- kovan "SpawnPos" degeri CFrameValue / Vector3Value olabilir
    if inst:IsA("CFrameValue") then
        return inst.Value.Position
    elseif inst:IsA("Vector3Value") then
        return inst.Value
    end
    if inst:IsA("ObjectValue") then
        inst = inst.Value
    end
    if not inst then
        return nil
    end
    if inst:IsA("BasePart") then
        return inst.Position
    end
    if inst:IsA("Model") then
        return inst:GetPivot().Position
    end
    return nil
end

local function flat(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Noclip: Vicious / firefly ararken duvar, cit, dekor icinden gec.
-- Hareket donguleri her karede env.BSSNoclipUntil'i ileri iter; hareket bitince
-- ~0.3 sn icinde kendiliginden kapanir (karakter dususe gecmesin diye hizi da sifirlar).
env.BSSNoclipUntil = 0
connect(RunService.Stepped, function()
    if tick() >= (env.BSSNoclipUntil or 0) then
        return
    end
    local c = player.Character
    if not c then
        return
    end
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
    local r = c:FindFirstChild("HumanoidRootPart")
    if r then
        r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
end)

--- Hizli yolculuk (uzun mesafeler). Farm kapanir kapanmaz durur.
local function moveTo(pos, speed)
    speed = speed or S.MoveSpeed
    while running and S.AutoFarm do
        local root = hrp()
        if not root then
            return false
        end
        local delta = pos - root.Position
        local dist = delta.Magnitude
        if dist < 2 then
            return true
        end
        local dt = RunService.Heartbeat:Wait()
        root = hrp() -- beklerken karakter olmus olabilir
        if not root then
            return false
        end
        local step = math.min(dist, speed * dt)
        local rotation = root.CFrame - root.CFrame.Position
        root.CFrame = CFrame.new(root.Position + delta.Unit * step) * rotation
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
    return false
end

--- Normal yuruyus (tarla icinde).
local function walkTo(pos, timeout, interrupt)
    local h = hum()
    if not h then
        return false
    end
    h:MoveTo(pos)
    local t0 = tick()
    while running and S.AutoFarm and tick() - t0 < (timeout or 2) do
        local root = hrp()
        if not root then
            return false
        end
        if flat(root.Position, pos) < 3 then
            return true
        end
        -- yeni bir token / bubble belirdiyse yuruyusu hemen birak
        if interrupt and interrupt() then
            return false
        end
        task.wait(0.05)
    end
    return false
end

--- Hedefi TAKIP EDEREK tween (hareketli hedefler icin). getGoal() her karede cagrilir.
--- arriveDist icine girince true doner. Farm kapanirsa / sure dolarsa false.
local function tweenFollow(getGoal, arriveDist, maxTime)
    local t0 = tick()
    local speed = math.max(20, S.TravelSpeed)
    while running and S.AutoFarm and tick() - t0 < (maxTime or 12) do
        if S.Noclip then
            env.BSSNoclipUntil = tick() + 0.3
        end
        local root = hrp()
        if not root then
            return false
        end
        local goal = getGoal()
        if not goal then
            return false
        end
        local delta = goal - root.Position
        local dist = delta.Magnitude
        if dist <= arriveDist then
            return true
        end
        local dt = RunService.Heartbeat:Wait()
        root = hrp()
        if not root then
            return false
        end
        local step = math.min(dist, speed * dt)
        local rotation = root.CFrame - root.CFrame.Position
        root.CFrame = CFrame.new(root.Position + delta.Unit * step) * rotation
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
    return false
end

--- Sabit bir noktaya tween
