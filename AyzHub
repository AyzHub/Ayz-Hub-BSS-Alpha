local function myHive()
    local mine = player:FindFirstChild("Honeycomb")
    if mine and mine:IsA("ObjectValue") and mine.Value then
        return mine.Value
    end
    local hc = workspace:FindFirstChild("Honeycombs")
    if not hc then
        return nil
    end
    for _, h in ipairs(hc:GetChildren()) do
        local owner = h:FindFirstChild("Owner")
        if owner and owner.Value == player then
            return h
        end
    end
    return nil
end

local function hivePos(h)
    return posOf(h:FindFirstChild("SpawnPos")) or posOf(h)
end

local function claimHive()
    if myHive() then
        return true
    end
    local hc = workspace:FindFirstChild("Honeycombs")
    local events = RS:FindFirstChild("Events")
    local claim = events and events:FindFirstChild("ClaimHive")
    if not hc or not claim then
        return false
    end
    for _, h in ipairs(hc:GetChildren()) do
        local owner = h:FindFirstChild("Owner")
        local id = h:FindFirstChild("HiveID")
        local pos = hivePos(h)
        if owner and owner.Value == nil and id and pos then
            moveTo(pos + Vector3.new(0, 3, 0))
            task.wait(0.4)
            pcall(function() claim:FireServer(id.Value) end)
            task.wait(1)
            if myHive() then
                return true
            end
        end
    end
    return false
end

local converting = false
local eventPendingFn = nil -- asagida doldurulur: Vicious / firefly bekliyor mu?

local function convert()
    local hive = myHive()
    if not hive then
        return
    end
    -- once oyuncunun kendi spawn noktasi (kovandaki platform), sonra kovanin SpawnPos'u, en son modelin merkezi
    local pos = posOf(player:FindFirstChild("SpawnPos")) or hivePos(hive)
    if not pos then
        return
    end
    local events = RS:FindFirstChild("Events")
    local cmd = events and events:FindFirstChild("PlayerHiveCommand")
    if not cmd then
        setStatus("Events.PlayerHiveCommand not found")
        task.wait(2)
        return
    end

    local function fire()
        if cmd:IsA("RemoteFunction") then
            task.spawn(function() pcall(function() return cmd:InvokeServer("ToggleHoneyMaking") end) end)
        else
            pcall(function() cmd:FireServer("ToggleHoneyMaking") end)
        end
    end

    converting = true
    setStatus("going home to convert...")
    if moveTo(pos + Vector3.new(0, 3, 0)) then
        task.wait(0.8)
        setStatus("converting pollen...")
        -- komut bir TOGGLE: polen zaten azaliyorsa basma
        local before = stat("Pollen")
        task.wait(1)
        local attempts = 0
        if stat("Pollen") >= before then
            attempts = 1
            fire()
            task.wait(1.5)
        end
        local last = stat("Pollen")
        local started, lastCheck = tick(), tick()
        while running and S.AutoFarm and stat("Pollen") > 0 and tick() - started < S.ConvertTimeout do
            -- donusturme sirasinda Vicious / firefly cikarsa: birak, once onlara git
            if S.EventPriority and eventPendingFn and eventPendingFn() then
                setStatus("event spotted: leaving the hive before converting is done...")
                break
            end
            if tick() - lastCheck > 3 then
                local now = stat("Pollen")
                if now >= last then
                    -- polen azalmiyor: kovandan uzaklasmis olabiliriz, geri don; sonra tekrar dene
                    local root = hrp()
                    if root and (root.Position - pos).Magnitude > 12 then
                        moveTo(pos + Vector3.new(0, 3, 0))
                        task.wait(0.5)
                    end
                    if attempts >= 4 then
                        setStatus("convert: pollen is not decreasing (see 'Convert debug')")
                        break
                    end
                    attempts = attempts + 1
                    fire()
                end
                last = stat("Pollen")
                lastCheck = tick()
            end
            task.wait(0.25)
        end
        task.wait(0.5)
    end
    converting = false
end

