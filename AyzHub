env.BSSMondo.find = function()
    local C = env.BSSMondo
    if C.alive(C.cache) then
        return C.cache
    end
    C.cache = nil
    if C.alive(C.hint) then
        C.cache = C.hint
        return C.cache
    end
    C.hint = nil
    local now = tick()
    if now < C.scanAt then
        return nil
    end
    C.scanAt = now + 2
    C.cache = scanFor({ "Monsters", "Enemies", "Mobs" }, "mondo", true, C.isMondo)
    if not C.cache and now - C.signalAt < 120 and now >= C.deepAt then
        -- bildirim geldi ama klasorlerde yok: workspace'i (sinirli derinlik / sayida) tara
        C.deepAt = now + 5
        local found
        pcall(boundedWalk, workspace, 4, 8000, function(d)
            if d:IsA("Model") and C.isMondo(d) and C.alive(d) then
                found = d
                return true
            end
            return false
        end)
        C.cache = found
    end
    if not C.cache and now >= C.streamAt then
        -- uzakta yuklenmemis olabilir (streaming): Mountain Top cevresini yuklet
        C.streamAt = now + 60
        local z = C.zone()
        if z then
            task.spawn(function()
                pcall(function() player:RequestStreamAroundAsync(z.Position, 2) end)
            end)
        end
    end
    return C.cache
end

