            return true
        end
        local okA, attrs = pcall(function() return p:GetAttributes() end)
        if okA and type(attrs) == "table" then
            for k, v in pairs(attrs) do
                if string.find(string.lower(tostring(k)), "sticker", 1, true)
                    or (type(v) == "string" and string.find(string.lower(v), "sticker", 1, true)) then
                    stickerCache[p] = true
                    return true
                end
            end
        end
        local ids = {}
        for id in string.gmatch(key, "%d+") do
            ids[#ids + 1] = id
        end
        local inspected = false
        local okd, list = pcall(function() return p:GetDescendants() end)
        local candidates = okd and list or {}
        candidates[#candidates + 1] = p
        for _, d in ipairs(candidates) do
            if d ~= p and string.find(string.lower(d.Name), "sticker", 1, true) then
                stickerCache[p] = true
                return true
            end
            local okt, tex = pcall(textureOf, d)
            if okt and tex and tex ~= "" then
                inspected = true
                if string.find(string.lower(tex), "sticker", 1, true) then
                    stickerCache[p] = true
                    return true
                end
                for _, id in ipairs(ids) do
                    if string.find(tex, id, 1, true) then
                        stickerCache[p] = true
                        return true
                    end
                end
            end
        end
        if inspected then
