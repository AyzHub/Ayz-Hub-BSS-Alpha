-- (Lua'da bir fonksiyonda en fazla 200 yerel degisken olabilir: alet kodu bu yuzden
--  bir do-blogu icinde; disariya sadece toolKit.debug / toolKit.spy cikar.)
local toolKit = {}
do
    -- Toplayici alet: tercihen ClickEvent'i olan; yoksa Backpack'teki ilk Tool
    local function isCollectorTool(t)
        return t:IsA("Tool") and t:FindFirstChild("ClickEvent") ~= nil
    end

    local function equipCollector()
        local c = player.Character
        local h = hum()
        if not c or not h or h.Health <= 0 then
            return nil
        end
        -- elde zaten toplayici varsa onu kullan
        for _, t in ipairs(c:GetChildren()) do
            if isCollectorTool(t) then
                return t
            end
        end
        local bp = player:FindFirstChild("Backpack")
        local pick
        if bp then
            -- once Petal Wand (varsa), sonra ClickEvent'li herhangi bir alet
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), "petal", 1, true) then
                    pick = t
                    break
                end
            end
            if not pick then
                for _, t in ipairs(bp:GetChildren()) do
                    if isCollectorTool(t) then
                        pick = t
                        break
                    end
                end
            end
            -- ClickEvent'li alet bulunamadiysa (oyun degismis olabilir) ilk Tool'u dene
            if not pick and not c:FindFirstChildOfClass("Tool") then
                pick = bp:FindFirstChildOfClass("Tool")
            end
        end
        if pick then
            pcall(function() h:EquipTool(pick) end)
            task.wait(0.15)
        end
        return c:FindFirstChildOfClass("Tool")
    end

    local function isPetalWand(tool)
        return tool and string.find(string.lower(tool.Name), "petal", 1, true) ~= nil
    end

    -- Petal Wand: her savurma ~0.7 sn surer; ustune tiklamak animasyonu bozar / yok sayilir.
    local PETAL_INTERVAL = 0.75

    local function useCollector(tool)
        if not tool or tool.Parent ~= player.Character then
            return
        end
        -- 1) Aleti oyunun kendi istemci koduyla calistir (animasyon + dogru argumanlar):
        --    Tool.Activated tetiklenir. Petal Wand gibi ozel aletler buna bagli.
        pcall(function() tool:Activate() end)
        -- 2) ClickEvent varsa dogrudan da tetikle (argumansiz, oyunun kendi cagrisi gibi)
        local click = tool:FindFirstChild("ClickEvent")
        if click and click:IsA("RemoteEvent") then
            pcall(function() click:FireServer() end)
        end
    end

    -- Yeni BSS'te alet bir Roblox Tool nesnesi olmayabilir (Character / Backpack bos).
    -- Bu durumda oyunun kendi "ToolCollect" olayi tetiklenir.
    local function fireToolCollect()
        local ev = RS:FindFirstChild("Events")
        local r = ev and ev:FindFirstChild("ToolCollect")
        if r and r:IsA("RemoteEvent") then
            pcall(function() r:FireServer() end)
            return true
        end
        return false
    end

    -- "Click spy": sen aleti elle sallarken oyunun kendi FireServer cagrilarini (ad + argumanlar)
    -- konsola yazar. Argumanlari ogrenip scripti ona gore ayarlamak icin.
    local spy = env.BSSSpy
    if not spy then
        spy = { on = false, hooked = false, count = 0 }
        env.BSSSpy = spy
    end

    local function describeArg(v, depth)
        local tv = typeof(v)
        if tv == "Instance" then
            local ok, n = pcall(function() return v:GetFullName() end)
            return "Instance(" .. (ok and n or v.Name) .. ")"
        elseif tv == "table" then
            if (depth or 0) >= 2 then
                return "{...}"
            end
            local parts, c = {}, 0
            for k, x in pairs(v) do
                c = c + 1
                if c > 6 then
                    parts[#parts + 1] = "..."
                    break
                end
                parts[#parts + 1] = describeArg(k, (depth or 0) + 1) .. "=" .. describeArg(x, (depth or 0) + 1)
            end
            return "{" .. table.concat(parts, ", ") .. "}"
        end
        return tv .. "(" .. tostring(v) .. ")"
    end

    local function spyRelevant(name)
        local n = string.lower(name)
        return string.find(n, "tool", 1, true) or string.find(n, "collect", 1, true)
            or string.find(n, "click", 1, true) or string.find(n, "swing", 1, true)
            or string.find(n, "petal", 1, true) or string.find(n, "pollen", 1, true)
    end

    toolKit.spy = function()
        if not (hookmetamethod and getnamecallmethod) then
            setStatus("click spy needs hookmetamethod (your executor lacks it)")
            warn("[BSSFarm] click spy: hookmetamethod / getnamecallmethod not available")
            return
        end
        if not spy.hooked then
            local old
            local fn = function(self, ...)
                if spy.on and getnamecallmethod() == "FireServer"
                    and not (checkcaller and checkcaller()) then
                    local args = table.pack(...)
                    pcall(function()
                        if typeof(self) == "Instance" and self:IsA("RemoteEvent") and spyRelevant(self.Name) then
                            spy.count = spy.count + 1
                            if spy.count <= 40 then
                                local parts = {}
                                for i = 1, math.min(args.n, 6) do
                                    parts[#parts + 1] = describeArg(args[i], 0)
                                end
                                print("[BSSFarm] SPY FireServer:", self:GetFullName(), "| args(" .. args.n .. "):",
                                    table.concat(parts, ", "))
                            end
                        end
                    end)
                end
                return old(self, ...)
            end
            if newcclosure then
                fn = newcclosure(fn)
            end
            old = hookmetamethod(game, "__namecall", fn)
            spy.hooked = true
        end
        spy.on = not spy.on
        spy.count = 0
        if spy.on then
            setStatus("click spy ON: swing your Petal Wand by hand, then read the F9 console")
            print("[BSSFarm] click spy ON - swing/click the tool manually a few times (stop with the same button)")
        else
            setStatus("click spy OFF")
            print("[BSSFarm] click spy OFF")
        end
    end

    toolKit.convertDebug = function()
        print("[BSSFarm] ---------------- convert debug ----------------")
        local cs = player:FindFirstChild("CoreStats")
