-- Bir adim: en yakin sticker'a git, uzerinde dur, tetikle. Bir sey yaptiysa true doner.
stickerKit.step = function(root)
    local st = stickerKit.nearest(root.Position)
    if not st then
        return false
    end
    local p0 = targetPos(st)
    setStatus(string.format("sticker: collecting %s (%d st)...", st.Name, p0 and (p0 - root.Position).Magnitude or 0))
    tweenFollow(function()
        if not st.Parent then
            return nil
        end
        local p = targetPos(st)
        return p and (p + Vector3.new(0, 1.5, 0)) or nil
    end, 2.5, 12)
    if st.Parent then
        local hold = tick()
        while running and S.AutoFarm and st.Parent and tick() - hold < 0.6 do
            local r, p = hrp(), targetPos(st)
            if not r or not p then
                break
            end
            if S.Noclip then
                env.BSSNoclipUntil = tick() + 0.3
            end
            r.CFrame = CFrame.new(p + Vector3.new(0, 1.5, 0)) * (r.CFrame - r.CFrame.Position)
            r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            RunService.Heartbeat:Wait()
        end
        if st.Parent then
            pcall(stickerKit.trigger, st)
            task.wait(0.3)
        end
    end
    if st.Parent then
        -- hala duruyor: toplanamadi / dekor olabilir; kisa sure sonra bir kez daha, sonra uzun sure birak
        stickerKit.tries[st] = (stickerKit.tries[st] or 0) + 1
        stickerKit.skip[st] = tick() + (stickerKit.tries[st] >= 2 and 300 or 15)
    else
        stickerKit.count = stickerKit.count + 1
    end
    return true
end

