-- Arama: eslesmeyen satirlari gizler, eslesen bolumleri acar
local function applySearch(q)
    q = string.lower(q or "")
    ST.searching = q ~= ""
    local counts, hitGroups = {}, {}
    for _, w in ipairs(ST.widgets) do
        local g = w.group
        local hit = (not ST.searching) or string.find(w.text, q, 1, true) ~= nil
            or (g ~= nil and string.find(g.name, q, 1, true) ~= nil)
        w.frame.Visible = hit
        if hit then
            counts[w.tab] = (counts[w.tab] or 0) + 1
            if g then hitGroups[g] = true end
        end
    end
    for _, g in ipairs(ST.groups) do
        if ST.searching then
            g.frame.Visible = hitGroups[g] == true
            g.body.Visible = hitGroups[g] == true
        else
            g.frame.Visible = true
            g.setOpen(g.open)
        end
    end
    local firstHit
    for _, d in ipairs(TAB_DEFS) do
        local n = d[1]
        local has = (not ST.searching) or (counts[tabs[n]] or 0) > 0
        if has and not firstHit then firstHit = n end
        ST.tabButtons[n].Visible = true
        ST.tabLabels[n].TextTransparency = has and 0 or 0.6
    end
    if ST.searching and firstHit and (counts[tabs[ST.cur]] or 0) == 0 then
        selectTab(firstHit)
    end
end
