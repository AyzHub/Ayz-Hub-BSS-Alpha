local FIREFLY_KEYS = { "spider", "bamboo", "strawberry", "pineapple", "cactus", "rose" }

local function setFireflySignal(zone, pos, source)
    local now = tick()
    if zone and fireflySignal.zone == zone and fireflySignal.at > 0 then
        if fireflySignal.arrivedAt then
            local waited = now - fireflySignal.arrivedAt
            if waited > 8 and waited < 90 then
                return -- ulastik, bocek yok: ayni tarla icin hemen tekrar gitme
            end
            if waited >= 90 then
                fireflySignal.arrivedAt = nil -- uzun sure sonra yeniden gelmis olabilirler
            end
        end
        fireflySignal.at = now
        fireflySignal.pos = pos or fireflySignal.pos
        fireflySignal.src = source
        return
    end
    fireflySignal.at = now
    fireflySignal.zone = zone
    fireflySignal.pos = pos
    fireflySignal.src = source
    fireflySignal.arrivedAt = nil
end

-- Gelen bir olayin argumanlarindan yazi / konum topla
local function harvestArgs(v, out, depth)
    local tv = typeof(v)
    if tv == "string" then
        out.strings[#out.strings + 1] = v
    elseif tv == "Vector3" then
        out.pos = out.pos or v
    elseif tv == "CFrame" then
        out.pos = out.pos or v.Position
    elseif tv == "Instance" then
        if not out.pos and isFireflyInst(v) then
            out.pos = targetPos(v)
        end
    elseif tv == "table" and depth < 3 then
        for k, x in pairs(v) do
            out.count = out.count + 1
            if out.count > 60 then
                return
            end
            harvestArgs(k, out, depth + 1)
            harvestArgs(x, out, depth + 1)
        end
    end
end

-- RemoteEvent: adinda "firefl" varsa VEYA argumanlarda "firefl" gecen yazi varsa
fireflyArgsHandler = function(remote, ...)
    if not running or not S.ChaseFireflies then
        return
    end
    local byName = string.find(remote.Name, "[Ff][Ii][Rr][Ee][Ff][Ll]") ~= nil
    local out = { strings = {}, pos = nil, count = 0 }
    for i = 1, math.min(select("#", ...), 6) do
        harvestArgs((select(i, ...)), out, 0)
    end
    local flagged, zone = byName, nil
    if not flagged then
        for _, s in ipairs(out.strings) do
            if #s <= 300 and string.find(s, "[Ff][Ii][Rr][Ee][Ff][Ll]") then
                flagged = true
                break
            end
        end
    end
    if not flagged then
        return
    end
    for _, s in ipairs(out.strings) do
        if #s <= 300 then
            zone = zone or zoneFromText(s)
        end
    end
    -- konumu sadece olayin adi firefly ise guven (aksi halde rastgele bir konum olabilir)
    local pos = byName and out.pos or nil
    if not zone and pos then
        zone = fieldOfPos(pos)
    end
    if zone or pos then
        setFireflySignal(zone, pos, "remote:" .. remote.Name)
    end
end

