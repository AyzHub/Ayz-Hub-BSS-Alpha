tokenKit.moonSkip = setmetatable({}, { __mode = "k" })
tokenKit.moonTries = setmetatable({}, { __mode = "k" })
tokenKit.moonCount = 0
tokenKit.moonNext, tokenKit.moonRes = 0, nil
tokenKit.moonStep = function(root)
    local now = tick()
    local tok = nil
    if now < tokenKit.moonNext then
        tok = tokenKit.moonRes
        if tok and (not tok.Parent or (tokenKit.moonSkip[tok] or 0) > now) then
            tok = nil
        end
    else
        tokenKit.moonNext = now + 0.15
        local col = workspace:FindFirstChild("Collectibles")
        local bestD
        if col then
            for _, p in ipairs(col:GetChildren()) do
                if (tokenKit.moonSkip[p] or 0) < now and (p:IsA("BasePart") or p:IsA("Model")) then
                    local pos = posOf(p)
                    if pos then
                        local d = (pos - root.Position).Magnitude
                        if d <= S.MoonRange and (not bestD or d < bestD) and tokenKit.isMoon(p) then
                            tok, bestD = p, d
