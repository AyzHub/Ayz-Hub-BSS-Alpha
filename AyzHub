-- araya task.wait() koyar. fn(inst) true donerse durur.
local SKIP_SCAN = { Collectibles = true, Terrain = true, Camera = true }
local function boundedWalk(root, maxDepth, maxNodes, fn)
    local level = { root }
    local count = 0
    for _ = 1, maxDepth do
        local nextLevel = {}
        for _, parent in ipairs(level) do
            for _, ch in ipairs(parent:GetChildren()) do
                count = count + 1
                if fn(ch) then
                    return ch
                end
                if count % 400 == 0 then
                    task.wait()
                    if not running then
                        return nil
                    end
                end
                if count >= maxNodes then
                    return nil
                end
                if not SKIP_SCAN[ch.Name] and #nextLevel < 20000
                    and (ch:IsA("Folder") or ch:IsA("Model")) then
                    nextLevel[#nextLevel + 1] = ch
                end
            end
        end
        level = nextLevel
        if #level == 0 then
            break
        end
    end
    return nil
end

local fireflySet = {}      -- bulunan adaylar
local fireflyDone = {}     -- yaklasilmis / atlanmis olanlar (bitis zamani)
local fireflyTries = {}    -- ulasamadigimiz denemeler
local fireflyState = { center = nil, size = 0, lastSeen = 0, deepAt = 0, centerUntil = 0, donePos = {},
    spots = {}, lingerUntil = 0, lastPos = nil, lastCount = 0, sessPos = {} }

-- Bocek bir tarlanin ICINDE ve yere yakin mi? (havada ucanlari kovalamayiz)
fireflyState.onGround = function(p)
    local fz = workspace:FindFirstChild("FlowerZones")
    if not fz then
        return true -- tarla bilgisi yoksa eleme yapma
    end
    local maxH = S.FireflyMaxHeight
    if tick() < (fireflyState.lingerUntil or 0) then
        maxH = maxH + 15 -- az once bocek kovaladik: biraz daha yuksektekileri de dene
    end
    for _, z in ipairs(fz:GetChildren()) do
        if z:IsA("BasePart") and inField(z, p, 4) then
            local h = p.Y - fieldTop(z)
            if h <= maxH and h > -15 then
                return true
            end
        end
    end
    return false
end

-- Bir bocegi (ve bulundugu noktayi) kisa sure "tamam" say. Eskiden 40 sn boyunca birakiliyordu,
-- bu yuzden sadece ilk bocek kovalaniyordu. Simdi sure kisa ve nokta bazli: bocek
-- yerinden oynarsa ya da sure dolarsa tekrar kovalanir.
fireflyState.markDone = function(inst, pos, secs)
    local untilT = tick() + secs
    if inst and fireflyDone[inst] ~= math.huge then
        fireflyDone[inst] = untilT
    end
    if pos then
        local spots = fireflyState.spots
        spots[#spots + 1] = { pos = pos, untilT = untilT }
        if #spots > 40 then
            table.remove(spots, 1)
        end
    end
end

fireflyState.spotDone = function(pos, now)
    for _, sp in ipairs(fireflyState.spots) do
        if sp.untilT > now and (sp.pos - pos).Magnitude < 4 then
            return true
        end
    end
    return false
end

local function isFireflyInst(inst)
    if not string.find(inst.Name, "[Ff][Ii][Rr][Ee][Ff][Ll]") then
        return false -- ucuz on-filtre (kucuk harfe cevirip yeni string uretmez)
    end
    if not (inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder")) then
        return false
    end
    local c = player.Character
    if c and inst:IsDescendantOf(c) then
        return false
    end
    return true
end

connect(workspace.DescendantAdded, function(inst)
    if S.ChaseFireflies and isFireflyInst(inst) then
        fireflySet[inst] = true
    end
end)

local deepScanning = false
local function deepScanFireflies()
    if deepScanning then
        return
    end
    deepScanning = true
    task.spawn(function()
        pcall(boundedWalk, workspace, 4, 8000, function(d)
            if isFireflyInst(d) then
                fireflySet[d] = true
            end
            return false
        end)
        deepScanning = false
    end)
end

task.spawn(function()
    task.wait(2)
    if running then
        deepScanFireflies()
    end
end)

-- "Fireflies" gibi bir kapsayicinin (Folder / grup modeli) icindeki bocek hedeflerini topla.
-- Ic ice klasorler (ornegin Fireflies/Rose Field/...) icin 3 seviye iner.
local function collectFireflyTargets(inst, out, depth)
    if inst:IsA("BasePart") then
        out[#out + 1] = inst
        return
    end
    local kids = inst:GetChildren()
    local container = inst:IsA("Folder")
        or (inst:IsA("Model") and #kids > 1 and string.find(string.lower(inst.Name), "fireflies", 1, true) ~= nil)
    if container and depth < 3 then
        local any = false
        for _, ch in ipairs(kids) do
            if ch:IsA("BasePart") or ch:IsA("Model") or ch:IsA("Folder") then
                any = true
                collectFireflyTargets(ch, out, depth + 1)
            end
        end
        if any then
            return
        end
    end
    if inst:IsA("Model") then
        -- Tek bir "Firefly" modelinin icinde birden cok bocek (parca) olabilir: aralarinda
        -- mesafe varsa her biri ayri hedef olur (yakin parcalar asagida birlestirilir).
        local parts = {}
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") and d.Size.Magnitude <= 15 then
                parts[#parts + 1] = d
                if #parts >= 60 then
                    break
                end
            end
        end
        if #parts >= 2 then
            local p1 = parts[1].Position
            for i = 2, #parts do
                if (parts[i].Position - p1).Magnitude > 4 then
                    for _, part in ipairs(parts) do
                        out[#out + 1] = part
                    end
                    return
                end
            end
        end
        out[#out + 1] = inst
    end
end

-- Su an dunyada bulunan ates bocekleri: { {inst=, pos=}, ... }
-- Klasor / "Fireflies" grubu ise icindeki her bocek ayri hedef olur.
local function fireflyTargets()
    local out = {}
    for inst in pairs(fireflySet) do
        if not inst.Parent then
            fireflySet[inst] = nil
        else
            local nested = false
            local a = inst.Parent
            while a and a ~= workspace do
                if fireflySet[a] then
                    nested = true
                    break
                end
                a = a.Parent
            end
            if not nested then
                local list = {}
                collectFireflyTargets(inst, list, 0)
                for _, t in ipairs(list) do
                    local p = targetPos(t)
                    if p then
                        out[#out + 1] = { inst = t, pos = p }
                    end
                end
            end
        end
    end
    -- kararli sira + 3.5 st icindekileri birlestir (ayni bocegin parcalari)
    table.sort(out, function(a, b)
        if a.pos.X ~= b.pos.X then
            return a.pos.X < b.pos.X
        end
        if a.pos.Z ~= b.pos.Z then
            return a.pos.Z < b.pos.Z
        end
        return a.pos.Y < b.pos.Y
    end)
    local merged = {}
    for _, t in ipairs(out) do
        local dup = false
        for _, k in ipairs(merged) do
            if (k.pos - t.pos).Magnitude < 3.5 then
                dup = true
                break
            end
        end
        if not dup then
            merged[#merged + 1] = t
        end
    end
    return merged
end

-- Adi tam "Fireflies" / "Firefly" olan nesneyi yerel ozyinelemeli aramayla bul
-- (liste uretmez, ucuz; 5 sn'de bir)
local function quickFireflyCheck()
    local now = tick()
    if now < (fireflyState.quickAt or 0) then
        return
    end
    fireflyState.quickAt = now + 5
    for _, nm in ipairs({ "Fireflies", "Firefly" }) do
        local ok, f = pcall(function() return workspace:FindFirstChild(nm, true) end)
        if ok and f and isFireflyInst(f) then
            fireflySet[f] = true
        end
    end
end

-- Kac ates bocegi var (gece algilama icin). Hic yoksa ara sira tum workspace'i tara.
local function fireflyCount()
    local n = #fireflyTargets()
    local now = tick()
    if n == 0 and S.ChaseFireflies then
        quickFireflyCheck()
    end
    if n == 0 and S.ChaseFireflies and now > fireflyState.deepAt then
        fireflyState.deepAt = now + 30
        deepScanFireflies()
    end
    return n
end

-- Oyuncuya en yakin, henuz yaklasilmamis ates bocegi
local function findFirefly()
    local root = hrp()
    local origin = root and root.Position or Vector3.new(0, 0, 0)
    local now = tick()
    local list = fireflyTargets()
    if #list == 0 and S.ChaseFireflies then
        quickFireflyCheck()
    end
    if #list == 0 and S.ChaseFireflies and now > fireflyState.deepAt then
        fireflyState.deepAt = now + 30
        deepScanFireflies()
    end
    local best, bestD
    local live = 0 -- onceki olaydan kalan (huge ile isaretli) nesneler sayilmaz
    for _, t in ipairs(list) do
        local dn = fireflyDone[t.inst]
        if dn == math.huge then
            -- moon charm sonrasi "bitti" diye isaretlenen nesne baska yerde yeniden dogduysa
            -- (oyun ayni nesneyi tekrar kullaniyorsa) yeni olay say
            local p0 = fireflyState.donePos[t.inst]
            if p0 and (t.pos - p0).Magnitude > 20 then
                fireflyDone[t.inst] = nil
                fireflyState.donePos[t.inst] = nil
                dn = nil
            end
        end
        if dn ~= math.huge then
            live = live + 1
        end
        if (dn or 0) < now and not fireflyState.spotDone(t.pos, now) and fireflyState.onGround(t.pos) then
            local d = (t.pos - origin).Magnitude
            if not bestD or d < bestD then
                best, bestD = t.inst, d
            end
        end
    end
    fireflyState.lastCount = live
    if best and fireflyState.charmBlockUntil == math.huge then
        -- yeni bir firefly olayi basladi: moon charm takibi tekrar acilsin
        fireflyState.charmBlockUntil = 0
        fireflyState.centerUntil = 0
        fireflyState.center, fireflyState.size = nil, 0
    end
    -- grubun merkezi (hepsi toplaninca ortadaki token icin)
    if #list > 0 then
        fireflyState.lastSeen = now
        if now > fireflyState.centerUntil and #list >= fireflyState.size then
            local sum = Vector3.new(0, 0, 0)
            for _, t in ipairs(list) do
                sum = sum + t.pos
            end
            fireflyState.center = sum / #list
            fireflyState.size = #list
        end
    elseif now - fireflyState.lastSeen > 10 then
        fireflyState.center, fireflyState.size = nil, 0
    end
    return best
end

-- ---------------------------------------------------- gece algilama (BSS)
-- Gercek saat KULLANILMAZ. Oyunun kendi durumuna bakilir, sirayla:
--   1) oyunun kendi "night" BoolValue / attribute degeri (varsa, en guvenilir)
--   2) Lighting.ClockTime (sadece oyun onu gercekten degistiriyorsa)
--   3) ates bocekleri (sadece geceleri dogar)
--   4) gece muzigi
--   5) isik olcusu: otomatik ogrenme VEYA elle "gece/gunduz" isaretleme
local nightInfo = { night = false, source = "day", sky = 0, flag = "none", patrolRounds = 1 }

local function lum(c)
    return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

-- Lighting + efektlerden tek bir "isik olcusu" uretir
local function skyMetric()
    local ok, m = pcall(function()
        local v = lum(Lighting.Ambient) * 0.3 + lum(Lighting.OutdoorAmbient) * 0.3
            + Lighting.Brightness * 0.15 + lum(Lighting.FogColor) * 0.15
            + Lighting.ExposureCompensation * 0.1
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("ColorCorrectionEffect") and e.Enabled then
                v = v + e.Brightness * 0.5 + (lum(e.TintColor) - 1) * 0.3
            elseif e:IsA("Atmosphere") then
                v = v + (lum(e.Color) - 0.5) * 0.2 - e.Density * 0.1
            end
        end
        return v
    end)
    return ok and m or nil
end

local lastSkySave = 0
local function widenSky(m)
    if S.SkyHi <= S.SkyLo then
        S.SkyLo, S.SkyHi = m, m
        return true
    end
    local widened = false
    if m > S.SkyHi then S.SkyHi = m widened = true end
    if m < S.SkyLo then S.SkyLo = m widened = true end
    return widened
end

-- true = karanlik, false = aydinlik, nil = henuz bilinmiyor
local function skyLooksDark()
    local m = skyMetric()
    if not m then
        return nil
    end
    nightInfo.sky = m
    -- elle isaretlenmis gunduz + gece varsa en yakin olana bak
    if S.SkyHasDay and S.SkyHasNight and math.abs(S.SkyDay - S.SkyNight) > 0.01 then
        return math.abs(m - S.SkyNight) < math.abs(m - S.SkyDay)
    end
    if widenSky(m) and tick() - lastSkySave > 30 then
        lastSkySave = tick()
        save()
    end
    local range = S.SkyHi - S.SkyLo
    if range < 0.03 then
        return nil -- henuz hem gunduz hem gece gorulmedi
    end
    return m <= S.SkyLo + range * 0.35
end

-- Elle kalibrasyon: butona basildigi andaki isigi "gece" / "gunduz" olarak kaydet
local function markSky(isNightNow)
    local m = skyMetric()
    if not m then
        return false
    end
    if isNightNow then
        S.SkyNight, S.SkyHasNight = m, true
    else
        S.SkyDay, S.SkyHasDay = m, true
    end
    widenSky(m)
    save()
    return true
end

local function resetSky()
    S.SkyLo, S.SkyHi, S.SkyDay, S.SkyNight = 0, 0, 0, 0
    S.SkyHasDay, S.SkyHasNight = false, false
    save()
end

-- Lighting.ClockTime: sadece oyun onu gercekten oynatiyorsa guvenilir
local clockMin, clockMax
local function clockSaysNight()
    local ok, ct = pcall(function() return Lighting.ClockTime end)
    if not ok or type(ct) ~= "number" then
        return nil
    end
    clockMin = math.min(clockMin or ct, ct)
    clockMax = math.max(clockMax or ct, ct)
    if clockMax - clockMin < 0.5 then
        return nil
    end
    return ct >= 18 or ct < 6
end

-- Oyunun kendi gece degiskeni: "night", "isnight", "nighttime", "nightmode"
local function isNightFlagName(n)
    n = string.gsub(string.lower(n), "[^%a]", "")
    return n == "night" or n == "isnight" or n == "nighttime" or n == "isnighttime"
        or n == "nightmode" or n == "isnightmode" or n == "itsnight"
end

local nightFlag, nightFlagScanAt = nil, 0
local function gameNightFlag()
    if nightFlag and nightFlag.inst.Parent then
        if nightFlag.attr then
            local v = nightFlag.inst:GetAttribute(nightFlag.attr)
            if type(v) == "boolean" then
                return v
            end
        elseif nightFlag.inst:IsA("BoolValue") then
            return nightFlag.inst.Value
        end
        nightFlag = nil
    end
    local now = tick()
    if now < nightFlagScanAt then
        return nil
    end
    nightFlagScanAt = now + 120
    local roots = { Lighting, RS, workspace, player }
    for _, r in ipairs(roots) do
        local okA, attrs = pcall(function() return r:GetAttributes() end)
        if okA then
            for k, v in pairs(attrs) do
                if type(v) == "boolean" and isNightFlagName(k) then
                    nightFlag = { inst = r, attr = k }
                    return v
                end
            end
        end
        local list = (r == workspace or r == player) and r:GetChildren() or r:GetDescendants()
        for _, d in ipairs(list) do
            if d:IsA("BoolValue") and isNightFlagName(d.Name) then
                nightFlag = { inst = d }
                return d.Value
            end
        end
    end
    return nil
end

local musicCache = { at = 0, v = false }
local function nightMusicPlaying()
    -- sonuc 4 sn onbellekte; sadece SoundService taranir (PlayerGui cok buyuk)
    if tick() - musicCache.at < 4 then
        return musicCache.v
    end
    musicCache.at = tick()
    local ok, res = pcall(function()
        for _, d in ipairs(game:GetService("SoundService"):GetDescendants()) do
            if d:IsA("Sound") and d.IsPlaying then
                local n = string.lower(d.Name)
                if string.find(n, "mountaincall", 1, true) or string.find(n, "night", 1, true) then
                    return true
                end
            end
        end
        return false
    end)
    musicCache.v = ok and res or false
    return musicCache.v
end

local patrolVisited = {} -- bu gece kontrol edilen tarlalar
local wasNight = false

local function updateNight()
    local src
    local flag = gameNightFlag()
    local clk = clockSaysNight()
    local dark = skyLooksDark() -- her saniye cagrilir: otomatik ogrenme icin
    if flag ~= nil then
        nightInfo.flag = nightFlag and nightFlag.inst:GetFullName() or "?"
        if flag then
            src = "game flag"
        end
    elseif clk then
        src = "game clock"
    elseif fireflyCount() > 0 or (fireflySignal.at > 0 and tick() - fireflySignal.at < 60) then
        src = "fireflies"
    elseif nightMusicPlaying() then
        src = "night music"
    elseif dark then
        src = "dark sky"
    end
    if not src and wasNight then
        -- Gece bitene kadar gece say: ates bocekleri / muzik kayboldu diye geceyi bitirme.
        -- Sadece oyunun bayragi, saati ya da olculu isik net "gunduz" derse (ya da gecenin
        -- baslangicindan 2 dk 40 sn gectiyse) gece biter.
        local definiteDay = flag == false
            or (flag == nil and clk == false)
            or (flag == nil and clk == nil and dark == false)
        if not definiteDay and tick() - (nightInfo.startAt or 0) < 160 then -- gece suresi: 2 dk 40 sn
            src = "night (held)"
        end
    end
    nightInfo.night = src ~= nil
    nightInfo.source = src or "day"
    if nightInfo.night and not wasNight then
        nightInfo.startAt = tick()
        patrolVisited = {} -- yeni gece: tum tarlalar yeniden kontrol edilir
        nightInfo.patrolRounds = 1
        nightInfo.patrolFails = {}
        fireflyState.charmBlockUntil = 0
        fireflyState.centerUntil = 0
        fireflyDone = {}
        fireflyState.donePos = {}
        fireflyState.spots = {}
        fireflyState.lingerUntil = 0
        fireflyState.lastPos = nil
    end
    wasNight = nightInfo.night
end

local function isNight()
    return nightInfo.night
end

task.spawn(function()
    while running do
        if S.ChaseFireflies or S.KillVicious then
            pcall(updateNight)
        else
            nightInfo.night, nightInfo.source = false, "day"
            wasNight = false
        end
        task.wait(1)
    end
end)

-- Firefly kovalamasi su an aktif mi?
local function fireflyActive()
    if not S.ChaseFireflies then
        return false
    end
    if (not S.FireflyNightOnly) or nightInfo.night then
        return true
    end
    -- Gece algilamasi yanlis "gunduz" dese bile: ates bocekleri sadece geceleri vardir,
    -- bir tane gorunuyorsa ya da oyun bildirdiyse kovala.
    return #fireflyTargets() > 0 or (fireflySignal.at > 0 and tick() - fireflySignal.at < 60)
end

-- ------------------------------------------------------- Vicious Bee (BSS)
-- Gece spawn olan yabani ("Rogue") Vicious Bee. Uc yoldan anlasilir:
--   1) workspace'e model eklenince (DescendantAdded) ve duzenli tarama
--   2) oyunun kendi RemoteEvent / sohbet / ekran mesajlari ("... Vicious ... spawned in X")
--   3) gece olunca spawn tarlalarini tek tek gezip bakmak (ViciousPatrol)

-- Oyuncunun kendi (evcil) Vicious Bee'si veya karakteri degil mi?
local function inOwnArea(inst)
    local c = player.Character
    if c and inst:IsDescendantOf(c) then
        return true
    end
    local a = inst.Parent
    while a and a ~= workspace do
        if a.Name == "Honeycombs" or a.Name == "Bees" or a.Name == "NPCs" then
            return true
        end
        if a:IsA("Model") and Players:GetPlayerFromCharacter(a) then
            return true
        end
        a = a.Parent
    end
    return false
end

-- "Vicious Bee" modeli mi? (stinger / thorn gibi yan urunler ve evcil bee degil)
-- Nokta herhangi bir tarlanin TAM icinde mi? (haritadaki dekorlari ayirmak icin)
local function strictlyInAField(p)
    local fz = workspace:FindFirstChild("FlowerZones")
    if not fz or not p then
        return false
    end
    for _, z in ipairs(fz:GetChildren()) do
        if z:IsA("BasePart") and inField(z, p, 0) and math.abs(p.Y - fieldTop(z)) < 60 then
            return true
        end
    end
    return false
end

local DECOR_WORDS = { "statue", "wanted", "poster", "sign", "display", "npc", "hologram", "board", "trophy", "decor" }

-- Gercek (canli) Wild Vicious Bee mi?  Haritadaki "WANTED" tabelasi / heykel / platform
-- dekorlari adinda "vicious" gecse de BURADA elenir.
local function isViciousBee(inst)
    if not string.find(inst.Name, "[Vv][Ii][Cc][Ii][Oo][Uu][Ss]") then
        return false -- ucuz on-filtre
    end
    if not inst:IsA("Model") then
        return false
    end
    local n = string.lower(inst.Name)
    if string.find(n, "stinger", 1, true)
        or string.find(n, "thorn", 1, true)
        or string.find(n, "spike", 1, true) then
        return false
    end
    for _, w in ipairs(DECOR_WORDS) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    if inOwnArea(inst) then
        return false
    end

    -- 1) Canavarlar klasorunun icindeyse: gercek canavar
    for _, rn in ipairs({ "Monsters", "Enemies", "Mobs" }) do
        local folder = workspace:FindFirstChild(rn)
        if folder and inst:IsDescendantOf(folder) then
            return true
        end
    end

    -- 2) Baska bir yerdeyse sadece su kosullarla: adi Wild/Rogue Vicious Bee, canli bir
    --    Humanoid'i var ve bir ates/cicek tarlasinin icinde (dekor tabela tarlada olmaz)
    local letters = string.gsub(n, "[^%a]", "")
    if not (string.find(letters, "wildvicious", 1, true) or string.find(letters, "roguevicious", 1, true)
        or string.find(letters, "viciousbee", 1, true)) then
        return false
    end
    local h = inst:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then
        return false
    end
    local ok, pos = pcall(function() return inst:GetPivot().Position end)
    return ok and strictlyInAField(pos)
end

local function viciousAlive(inst)
    if not inst or not inst.Parent then
        return false
    end
    local h = inst:FindFirstChildOfClass("Humanoid")
    return (not h or h.Health > 0) and targetPos(inst) ~= nil
end

-- Vicious'in gercek konumu. Model pivotu (GetPivot) dikenlere / isiga bagli olup
-- govdeden uzak olabilir; bu da yanlis tarla secilmesine yol aciyordu.
local function viciousPositionOf(inst)
    if not inst then
        return nil
    end
    local ok, p = pcall(function()
        local body = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
        if body and body:IsA("BasePart") then
            return body.Position
        end
        local cf = inst:GetBoundingBox()
        return cf.Position
    end)
    if ok and p then
        return p
    end
    return targetPos(inst)
end

local viciousScanAt, viciousCache, viciousHint = 0, nil, nil
local viciousSignal = { at = 0, zone = nil, text = "" } -- oyunun bildirimi

local function deepFindVicious()
    local found
    pcall(boundedWalk, workspace, 4, 8000, function(d)
        if d:IsA("Model") and isViciousBee(d) and viciousAlive(d) then
            found = d
            return true
        end
        return false
    end)
    return found
end

local function findViciousBee()
    if viciousAlive(viciousCache) then
        return viciousCache
    end
    viciousCache = nil
    -- oyun workspace'e eklerken yakaladigimiz aday (asagidaki spawn dinleyicisi)
    if viciousAlive(viciousHint) then
        viciousCache = viciousHint
        return viciousCache
    end
    viciousHint = nil
    local now = tick()
    if now < viciousScanAt then
        return nil
    end
    local signalRecent = now - viciousSignal.at < 60
    viciousScanAt = now + (signalRecent and 2 or 3)
    local found = scanFor({ "Monsters", "Enemies", "Mobs" }, "vicious", true, isViciousBee)
    if not found then
        -- son care: workspace'in dogrudan cocuklari
        for _, inst in ipairs(workspace:GetChildren()) do
            if isViciousBee(inst) and targetPos(inst) then
                found = inst
                break
            end
        end
    end
    if not found and signalRecent then
        found = deepFindVicious() -- oyun spawn dedi ama klasorlerde yok: her yere bak
    end
    viciousCache = found
    return found
end

