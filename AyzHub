-- ---------------------------------------------------------------- gorev remote'lari
-- Oyun gorev remote'larinin adini / argumanini degistirmis olabilir. Bu yuzden:
--   1) "Learn" ile elle yaptigin cagri (remote adi + argumanlar) kaydedilir ve aynen tekrarlanir
--   2) kayit yoksa Events icindeki "quest" iceren remote'lar siniflandirilip (give / complete) denenir
questState.KNOWN = {
    give = { "GiveQuestFromPool", "GiveQuest" },
    complete = { "CompleteQuestFromPool", "CompleteQuest" },
}

questState.classify = function(name)
    local n = string.lower(name)
    if not string.find(n, "quest", 1, true) then
        return nil
    end
    if string.find(n, "complet", 1, true) or string.find(n, "turnin", 1, true)
        or string.find(n, "finish", 1, true) or string.find(n, "claim", 1, true)
        or string.find(n, "reward", 1, true) or string.find(n, "submit", 1, true) then
        return "complete"
    end
    if string.find(n, "give", 1, true) or string.find(n, "accept", 1, true)
        or string.find(n, "start", 1, true) or string.find(n, "take", 1, true)
        or string.find(n, "begin", 1, true) then
        return "give"
    end
    return nil
end

questState.remotes = function(kind)
    local events = RS:FindFirstChild("Events")
    local out, seen = {}, {}
    if not events then
        return out
    end
    local function add(r)
        if r and not seen[r] and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
            seen[r] = true
            out[#out + 1] = r
        end
    end
    for _, nm in ipairs(questState.KNOWN[kind]) do
        add(events:FindFirstChild(nm))
    end
    for _, r in ipairs(events:GetChildren()) do
        if questState.classify(r.Name) == kind then
            add(r)
        end
    end
    return out
end

questState.call = function(r, args)
    local n = args.n or #args
    if r:IsA("RemoteEvent") then
        return (pcall(function() r:FireServer(table.unpack(args, 1, n)) end))
    elseif r:IsA("RemoteFunction") then
        task.spawn(function() pcall(function() return r:InvokeServer(table.unpack(args, 1, n)) end) end)
        return true
    end
    return false
end

-- kind = "give" | "complete". Ne gonderildigini yazi olarak dondurur (hicbir sey gonderilemediyse nil).
questState.send = function(kind)
    local events = RS:FindFirstChild("Events")
    local raw = S[kind == "give" and "QuestLearnGive" or "QuestLearnComplete"]
    if type(raw) == "string" and raw ~= "" then
        local ok, entry = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(entry) == "table" and type(entry.remote) == "string" then
            local r = (events and events:FindFirstChild(entry.remote)) or RS:FindFirstChild(entry.remote, true)
            if r then
                local args = type(entry.args) == "table" and entry.args or {}
                args.n = tonumber(entry.n) or #args
                if questState.call(r, args) then
                    return "learned call " .. entry.remote
                end
            end
        end
    end
    local used = {}
    for _, r in ipairs(questState.remotes(kind)) do
        if questState.call(r, { "Polar Bear", n = 1 }) then
            used[#used + 1] = r.Name
        end
        task.wait(0.15)
    end
    if #used == 0 then
        return nil
    end
    return table.concat(used, ", ")
end

-- NPC uzerinde ProximityPrompt / ClickDetector varsa tetikle (zararsiz; executor destegi gerekir)
questState.interact = function(npc)
    if not npc then
        return
    end
    local fpp = env.fireproximityprompt or fireproximityprompt
    local fcd = env.fireclickdetector or fireclickdetector
    local n = 0
    for _, d in ipairs(npc:GetDescendants()) do
        n = n + 1
        if n > 120 then
            break
        end
        if d:IsA("ProximityPrompt") and type(fpp) == "function" then
            pcall(fpp, d)
        elseif d:IsA("ClickDetector") and type(fcd) == "function" then
            pcall(fcd, d)
        end
    end
end

-- ---------------------------------------------------------------- "Learn" (cagri ogrenme)
questState.learning = nil -- nil | "give" | "complete"

questState.ser = function(v, depth)
    local t = type(v)
    if t == "string" or t == "number" or t == "boolean" then
        return v, true
    end
    if t == "table" and depth < 3 then
        local out = {}
        for k, x in pairs(v) do
            if type(k) ~= "string" and type(k) ~= "number" then
                return nil, false
            end
            local sx, ok = questState.ser(x, depth + 1)
            if not ok then
                return nil, false
            end
            out[k] = sx
        end
        return out, true
    end
    return nil, false
end

questState.record = function(remote, args)
    local kind = questState.learning
    if not kind then
        return
    end
    local cls = remote.ClassName
    if cls ~= "RemoteEvent" and cls ~= "RemoteFunction" then
        return
    end
    local n = string.lower(remote.Name)
    local relevant = false
    for _, w in ipairs({ "quest", "npc", "dialog", "talk", "bear", "chat" }) do
        if string.find(n, w, 1, true) then
            relevant = true
            break
        end
    end
    if not relevant then
        return
    end
    local list = {}
    for i = 1, args.n do
        local v, ok = questState.ser(args[i], 0)
        if not ok then
            questState.learning = nil
            task.defer(setStatus, "learn: " .. remote.Name .. " has arguments that cannot be saved (instances etc.)")
            return
        end
        list[i] = v
    end
    local entry = { remote = remote.Name, class = cls, args = list, n = args.n }
    local okj, json = pcall(function() return HttpService:JSONEncode(entry) end)
    if not okj then
        questState.learning = nil
        return
    end
    S[kind == "give" and "QuestLearnGive" or "QuestLearnComplete"] = json
    questState.learning = nil
    task.defer(function()
        save()
        setStatus("learned " .. (kind == "give" and "ACCEPT" or "TURN-IN") .. " call: " .. remote.Name)
        print("[BSSFarm] quest learn (" .. kind .. "):", json)
        pcall(updateQuest)
    end)
end

questState.hook = function()
    if questState.hooked then
        return true
    end
    if not (hookmetamethod and getnamecallmethod) then
        return false
    end
    local old
    local fn = function(self, ...)
        if questState.learning then
            local m = getnamecallmethod()
            if (m == "FireServer" or m == "InvokeServer") and not (checkcaller and checkcaller()) then
                local args = table.pack(...)
                pcall(questState.record, self, args)
            end
        end
        return old(self, ...)
    end
    if newcclosure then
        fn = newcclosure(fn)
    end
    old = hookmetamethod(game, "__namecall", fn)
    questState.hooked = true
    return true
end

questState.learn = function(kind)
    if not questState.hook() then
        setStatus("learn needs hookmetamethod (your executor lacks it)")
        warn("[BSSFarm] quest learn: hookmetamethod / getnamecallmethod not available")
        return
    end
    if questState.learning == kind then
        questState.learning = nil
        setStatus("learn cancelled")
        return
    end
    questState.learning = kind
    local label = kind == "give" and "ACCEPT" or "TURN-IN"
    setStatus("learning " .. label .. ": now " .. (kind == "give" and "accept" or "turn in") .. " the quest from Polar Bear BY HAND (60 s)")
    task.delay(60, function()
        if questState.learning == kind then
            questState.learning = nil
            setStatus("learn timed out - nothing was recorded")
        end
    end)
end

questState.clearLearned = function()
    S.QuestLearnGive, S.QuestLearnComplete = "", ""
    questState.learning = nil
    save()
    setStatus("learned quest calls cleared")
    pcall(updateQuest)
end

-- Farm dongusunun icinden cagrilir (baska bir thread hareket ettirmez)
local function polarVisit()
    local npc = questState.npc()
    if S.QuestWalkToNpc then
        local pos = polarPos()
        if not pos then
            setStatus("Polar Bear not found in workspace.NPCs")
            task.wait(1)
        else
            setStatus("visiting Polar Bear...")
            if not moveTo(pos + Vector3.new(0, 3, 0)) then
                return
            end
            task.wait(0.8) -- platforma insin
        end
    end
    pcall(questState.interact, npc)
    if S.QuestAutoTurnIn then
        local how = questState.send("complete")
        setStatus(how and ("quest turn-in sent: " .. how)
            or "no quest turn-in remote found - use 'Learn TURN-IN call' in the Quest tab")
        task.wait(1)
    end
