-- Ates bocekleri bittikten sonra ortada cikan token (moon charm) icin:
-- merkeze yakin (radius st) en yakin collectible
local function tokenNear(center, radius)
    local col = workspace:FindFirstChild("Collectibles")
    local root = hrp()
    if not col or not root then
        return nil
    end
    local now = tick()
    local best, bestD = nil, math.huge
    for _, p in ipairs(col:GetChildren()) do
        if (skipped[p] or 0) < now and (p:IsA("BasePart") or p:IsA("Model"))
            and (S.CollectHoney or not tokenKit.isHoney(p)) then
            local ok, pos = pcall(posOf, p)
            if ok and pos and flat(pos, center) <= radius and math.abs(pos.Y - center.Y) < 30 then
                local d = (pos - root.Position).Magnitude
                if d < bestD then
                    best, bestD = p, d
                end
            end
        end
    end
    return best
end

