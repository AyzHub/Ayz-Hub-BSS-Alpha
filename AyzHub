        local ev = RS:FindFirstChild("Events")
        local cmd = ev and ev:FindFirstChild("PlayerHiveCommand")
        print("[BSSFarm] Events.PlayerHiveCommand:", cmd and cmd.ClassName or "NOT FOUND")
        if ev then
            for _, e in ipairs(ev:GetChildren()) do
                local n = string.lower(e.Name)
