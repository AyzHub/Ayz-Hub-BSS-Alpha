local function fieldNames()
    local list = {}
    local fz = workspace:FindFirstChild("FlowerZones")
    if fz then
        for _, f in ipairs(fz:GetChildren()) do
            if f:IsA("BasePart") then
                list[#list + 1] = f.Name
            end
