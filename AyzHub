-- Oyunun deger / attribute'lari: adinda "firefl" gecen StringValue, Vector3Value,
-- CFrameValue, ObjectValue veya attribute'u oku
local ffValueCache, ffValueScanAt = {}, 0
local function pollFireflyValues()
    local now = tick()
    if now >= ffValueScanAt then
        ffValueScanAt = now + 120
        ffValueCache = {}
        for _, r in ipairs({ Lighting, RS, workspace, player }) do
            local okA, attrs = pcall(function() return r:GetAttributes() end)
            if okA then
                for k in pairs(attrs) do
                    if string.find(string.lower(k), "firefl", 1, true) then
                        ffValueCache[#ffValueCache + 1] = { inst = r, attr = k }
                    end
                end
            end
            local list = (r == workspace or r == player) and r:GetChildren() or r:GetDescendants()
            for _, d in ipairs(list) do
                if d:IsA("ValueBase") and string.find(string.lower(d.Name), "firefl", 1, true) then
                    ffValueCache[#ffValueCache + 1] = { inst = d }
                end
            end
        end
    end
    for _, e in ipairs(ffValueCache) do
        if e.inst.Parent then
            local v
            if e.attr then
                v = e.inst:GetAttribute(e.attr)
            else
                v = e.inst.Value
            end
            local tv = typeof(v)
            local zone, pos
            if tv == "string" then
                zone = zoneFromText(v)
            elseif tv == "Vector3" then
                pos = v
            elseif tv == "CFrame" then
                pos = v.Position
            elseif tv == "Instance" then
                pos = targetPos(v)
            end
            if pos and not zone then
                zone = fieldOfPos(pos)
            end
            if zone or pos then
                setFireflySignal(zone, pos, "value:" .. e.inst.Name)
            end
        end
    end
end

-- Aktif ve henuz yaklasilmamis firefly bilgisi var mi?
local function fireflyHint()
    if fireflySignal.at <= 0 or tick() - fireflySignal.at > 60 then
        return nil
    end
    if fireflySignal.arrivedAt and tick() - fireflySignal.arrivedAt > 8 then
        return nil
    end
    if fireflySignal.zone or fireflySignal.pos then
        return fireflySignal
    end
    return nil
end

-- Firefly tarafinda GERCEKTEN yapilacak is var mi? (sadece "gece" olmasi yetmez:
-- gece boyunca fireflyActive() true kalir, bu yuzden canta dolu iken bos yere kovana
-- donmeyi engellememek icin hedef / charm / ipucu / bekleme suresi aranir.)
local function fireflyBusy()
    if not S.ChaseFireflies then
        return false
    end
    local st = fireflyState
    if st.charmCenter then
        return true
    end
    if not fireflyActive() then
        return false
    end
    if targetPos(findFirefly()) then
        return true
    end
    if fireflyHint() then
        return true
    end
    return st.lastPos ~= nil and tick() < (st.lingerUntil or 0)
end

