-- ------------------------------------------------------- Balonlar
-- Tarlada balon varsa kasma desenini balonun ALTINA kaydirir (balonlar altinda polen toplayinca
-- buyuyup patlar). Sadece "diger isler" bittikten sonraki en son adimda devreye girer: sprout /
-- puffshroom / bloom tarlasinda, loot toplarken, token kovalarken devreye GIRMEZ.
-- Balon adlari kesin bilinmedigi icin adinda "balloon" gecen nesneler aranir ("Balloon debug (F9)").
-- (Yeni top-level local acilmasin diye env.BSSBalloon icinde.)
env.BSSBalloon = {
    list = {}, scanAt = 0, label = nil, info = "Balloons: off",
    bad = { "hive", "gui", "icon", "string", "rope", "shadow", "attach", "beam", "particle", "shop",
        "dispenser", "toy", "decor", "statue", "sign", "board", "npc" },
    badParents = { Toys = true, Planters = true, PlanterModels = true, Honeycombs = true, NPCs = true,
        Bees = true, Collectibles = true, Shops = true },
}

env.BSSBalloon.isBalloon = function(inst)
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then
        return false
    end
    local n = string.lower(inst.Name)
    if not string.find(n, "balloon", 1, true) then
        return false
    end
    for _, w in ipairs(env.BSSBalloon.bad) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    local a = inst.Parent
    while a and a ~= workspace do
        if env.BSSBalloon.badParents[a.Name] then
            return false
        end
        local an = string.lower(a.Name)
        if string.find(an, "hive", 1, true) or string.find(an, "honeycomb", 1, true) then
            return false -- kovan balonlari / kovan alani
        end
        a = a.Parent
    end
    return true
end

-- Balon adayi: ust nesne (Model / Part) bulununca icine inilmez; klasorlere en fazla 3 seviye inilir.
env.BSSBalloon.scan = function()
    local C = env.BSSBalloon
    local found, seen = {}, 0
    local function visit(inst, depth)
        if seen > 600 then
            return
        end
        seen = seen + 1
        if inst:IsA("BasePart") or inst:IsA("Model") then
            if C.isBalloon(inst) then
                found[#found + 1] = inst
            end
            return -- ust nesnenin icine inilmez (ayni balonun parcalari tekrar eklenmesin)
        end
        if depth < 3 then
            for _, ch in ipairs(inst:GetChildren()) do
                visit(ch, depth + 1)
            end
        end
    end
    for _, ch in ipairs(workspace:GetChildren()) do
        local n = string.lower(ch.Name)
        if string.find(n, "balloon", 1, true) then
            -- "Balloons" klasoru ya da dogrudan balon nesnesi
            if ch:IsA("Folder") then
                visit(ch, 0)
            elseif ch:IsA("BasePart") or ch:IsA("Model") then
                if C.isBalloon(ch) then
                    found[#found + 1] = ch
                else
                    for _, sub in ipairs(ch:GetChildren()) do
                        visit(sub, 1)
                    end
                end
            end
        end
    end
    C.list = found
end

-- Bu tarlada balon varsa en yakin olanin konumu (yoksa nil)
env.BSSBalloon.find = function(zone, root)
    local C = env.BSSBalloon
    local now = tick()
    if now >= C.scanAt then
        C.scanAt = now + 1.5
        pcall(C.scan)
    end
    local best, bestD
    for _, inst in ipairs(C.list) do
        if inst.Parent then
            local p = targetPos(inst)
            if p and inField(zone, p, 0) then
                local d = flat(p, root.Position)
                if not bestD or d < bestD then
                    best, bestD = p, d
                end
            end
        end
    end
    if best then
        C.info = "Farming under a balloon in " .. zone.Name
    else
        C.info = "Balloons: none in " .. zone.Name
    end
    if C.label then
        C.label.Text = C.info
    end
    return best
end

-- Sprout / puffshroom / bloom tarlasinda balon yok sayilir (onlarin onceligi var)
env.BSSBalloon.allowed = function(zone)
    local sp = env.BSSSprout
    if (S.AutoSprouts or S.AutoPuffshrooms) and sp and sp.zoneName == zone.Name then
        return false
    end
    local bl = env.BSSBloom
    if S.FarmBlooms and bl and bl.zoneName == zone.Name then
        return false
    end
    return true
end

-- Hedefi tarlanin icinde tut (Y'ye dokunma)
env.BSSBalloon.clampXZ = function(zone, p)
    local l = zone.CFrame:PointToObjectSpace(p)
    local hx = math.max(1, zone.Size.X / 2 - S.FieldMargin)
    local hz = math.max(1, zone.Size.Z / 2 - S.FieldMargin)
    local inside = zone.CFrame:PointToWorldSpace(
        Vector3.new(math.clamp(l.X, -hx, hx), l.Y, math.clamp(l.Z, -hz, hz)))
    return Vector3.new(inside.X, p.Y, inside.Z)
end

