function stepper(tab, text, key, step, minV, maxV, suffix, hint, onChange)
    local r = new("Frame", {
        Size = UDim2.new(1, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = nextOrder(tab),
    }, host(tab))
    new("UIPadding", { PaddingTop = UDim.new(0, 1), PaddingBottom = UDim.new(0, 1) }, r)
    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 3), Size = UDim2.new(1, -104, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, RichText = true, Text = rich(text, hint),
        TextColor3 = THEME.text, Font = Enum.Font.GothamMedium, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
    }, r)
    local function mk(txt, xOff)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, xOff, 0, 0),
            BackgroundColor3 = THEME.panel2, TextColor3 = THEME.text, Text = txt,
            Font = Enum.Font.GothamBold, TextSize = 14, BorderSizePixel = 0,
        }, r)
        round(b, 4)
        return b
    end
    local plus = mk("+", -22)
    local minus = mk("-", -98)
    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(50, 22), Position = UDim2.new(1, -74, 0, 0),
        TextColor3 = THEME.text, Font = Enum.Font.GothamMedium, TextSize = 11, Text = "",
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, r)
    local function refresh()
        valueLabel.Text = string.format("%g", S[key]) .. (suffix or "")
    end
    local function change(dir)
        local v = S[key] + dir * step
        v = math.max(minV, math.min(maxV, v))
        S[key] = math.floor(v * 1000 + 0.5) / 1000
        refresh()
        if onChange then onChange() end
        save()
    end
    connect(plus.MouseButton1Click, function() change(1) end)
    connect(minus.MouseButton1Click, function() change(-1) end)
    refresh()
    refreshers[#refreshers + 1] = refresh
    register(tab, r, text .. " " .. (hint or ""))
end

