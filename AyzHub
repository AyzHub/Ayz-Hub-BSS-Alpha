-- Tarlanin ust yuzeyi
local function fieldTop(zone)
    return zone.Position.Y + zone.Size.Y / 2
end

-- p noktasi tarlanin icinde mi? (pad > 0 genisletir, pad < 0 daraltir)
local function inField(zone, p, pad)
    local l = zone.CFrame:PointToObjectSpace(p)
    return math.abs(l.X) <= zone.Size.X / 2 + pad and math.abs(l.Z) <= zone.Size.Z / 2 + pad
end

-- Tarlanin gercek zemin yuksekligi (ray ile), bulunamazsa ust yuzey
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() rayParams.RespectCanCollide = true end)

local function groundY(zone, x, z)
    local top = fieldTop(zone)
    local ignore = {}
    if player.Character then ignore[#ignore + 1] = player.Character end
    local col = workspace:FindFirstChild("Collectibles")
    if col then ignore[#ignore + 1] = col end
    local particles = workspace:FindFirstChild("Particles")
    if particles then ignore[#ignore + 1] = particles end
    rayParams.FilterDescendantsInstances = ignore
    local ok, hit = pcall(function()
        return workspace:Raycast(Vector3.new(x, top + 8, z), Vector3.new(0, -40, 0), rayParams)
    end)
    if ok and hit and hit.Position.Y > top - 8 and hit.Position.Y < top + 6 then
        return hit.Position.Y
    end
    return top
end

-- Noktayi tarlanin icine sikistirir, yuksekligi zemin + TweenHeight yapar
local function clampToField(zone, p)
    local l = zone.CFrame:PointToObjectSpace(p)
    local hx = math.max(1, zone.Size.X / 2 - S.FieldMargin)
    local hz = math.max(1, zone.Size.Z / 2 - S.FieldMargin)
    local inside = zone.CFrame:PointToWorldSpace(
        Vector3.new(math.clamp(l.X, -hx, hx), 0, math.clamp(l.Z, -hz, hz)))
    return Vector3.new(inside.X, groundY(zone, inside.X, inside.Z) + S.TweenHeight, inside.Z)
end

