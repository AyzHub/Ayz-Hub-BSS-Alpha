-- ------------------------------------------------------------ Vicious savasi
-- BSS'te oyuncu dogrudan vurmaz: Vicious'i senin bee'lerin oldurur, bee'ler de yakindaki
-- canavara saldirir. Bu yuzden onemli olan Vicious'in HEMEN YANINDA kalmak ve onun
-- saldirilarindan kacmak. Eski kod tarlaya girince rastgele dolasiyordu (bee'den uzaklasip
-- bee'lerin vurmasini engelliyordu) ya da yanina gidip hareketsiz bekliyordu (olunuyordu).
viciousSignal.fightState = { angle = 0, dir = 1, flipAt = 0, jumpAt = 0, stepAt = 0,
    seenAt = 0, lastPos = nil, fought = false, lootUntil = 0 }

viciousSignal.fight = function(vicious, vpos, vzone, zname)
    local fs = viciousSignal.fightState
    local root, h = hrp(), hum()
    if not root or not h then
        task.wait(0.2)
        return
    end
    fs.seenAt = tick()
    fs.lastPos = vpos
    if not fs.fought and env.BSSWebhook and env.BSSWebhook.beginFight then
        pcall(env.BSSWebhook.beginFight) -- loot dusmeden onceki stinger sayisi
    end
    fs.fought = true
    local R = math.clamp(S.ViciousDistance, 6, 30)
    local dist = flat(root.Position, vpos)

    -- uzaktaysak once yanina git (bee hareket ederse takip et)
    if dist > R + 14 or math.abs(root.Position.Y - vpos.Y) > 40 then
        setStatus("Wild Vicious Bee" .. zname .. ": tweening to it...")
        tweenFollow(function()
            local p = viciousPositionOf(findViciousBee())
            if not p then
                return nil
            end
            local z = fieldOfPos(p)
            local gy = z and (groundY(z, p.X, p.Z) + S.TweenHeight) or p.Y
            return Vector3.new(p.X, gy, p.Z)
        end, R + 2, 12)
        fs.stepAt = 0
        return
    end

    -- Yakindaki tokenlari topla (Vicious'in cevresinde kalarak)
    local tok = tokenNear(vpos, math.max(R + 8, 18))
    if tok then
        setStatus("fighting Wild Vicious Bee" .. zname .. " (grabbing a token)...")
        chaseToken(tok, vzone)
        return
    end

    setStatus("fighting Wild Vicious Bee" .. zname .. " (staying close, dodging)...")
    if tick() - fs.stepAt > 1 then
        -- yeni basladik: bee'nin etrafindaki mevcut acimizdan devam et
        fs.angle = math.atan2(root.Position.Z - vpos.Z, root.Position.X - vpos.X)
    end
    local t0 = tick()
    while running and S.AutoFarm and tick() - t0 < 0.6 do
        local r, hh = hrp(), hum()
        if not r or not hh or hh.Health <= 0 or not viciousAlive(vicious) then
            break
        end
        local vp = viciousPositionOf(vicious) or vpos
        fs.stepAt = tick()
        fs.seenAt = tick()
        fs.lastPos = vp
        if tick() > fs.flipAt then
            fs.dir = -fs.dir -- yonu ara sira degistir: tahmin edilemez ol
            fs.flipAt = tick() + 2.5 + math.random() * 3
        end
        fs.angle = fs.angle + fs.dir * 0.06
        local target = vp + Vector3.new(math.cos(fs.angle) * R, 0, math.sin(fs.angle) * R)
        if vzone then
            target = clampToField(vzone, target)
        end
        hh:MoveTo(target)
        if tick() > fs.jumpAt then
            hh.Jump = true
            fs.jumpAt = tick() + 1.2 + math.random() * 1.5
        end
        task.wait(0.05)
    end
end

-- Bir tarlanin icindeki (yukleniyorsa) Vicious Bee ya da sivrisini ara. Eskiden sadece
-- 8000 nesnelik genel tarama vardi ve tarlada olan bee bazen hic bulunmuyordu.
viciousSignal.scanField = function(z)
    local bee, spike
    local ok, parts = pcall(function()
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = {}
        if player.Character then
            ignore[#ignore + 1] = player.Character
        end
        local col = workspace:FindFirstChild("Collectibles")
        if col then
            ignore[#ignore + 1] = col
        end
        params.FilterDescendantsInstances = ignore
        local cf = (z.CFrame - z.CFrame.Position) + Vector3.new(z.Position.X, fieldTop(z) + 25, z.Position.Z)
        return workspace:GetPartBoundsInBox(cf, Vector3.new(z.Size.X + 30, 90, z.Size.Z + 30), params)
    end)
    if not ok or not parts then
        return nil, nil
    end
    local seen = {}
    for i, part in ipairs(parts) do
        if i > 2000 then
            break
        end
        local a = part
        for _ = 1, 6 do
            if not a or a == workspace then
                break
            end
            if not seen[a] then
                seen[a] = true
                if a:IsA("Model") and isViciousBee(a) and viciousAlive(a) then
                    bee = a
                    break
                elseif not spike and (viciousSignal.skip[a] or 0) < tick() and viciousSignal.isSpike(a) then
                    spike = a
                end
            end
            a = a.Parent
        end
        if bee then
            break
        end
    end
    return bee, spike
end

-- ------------------------------------------------------- Sprout grind
-- Oyunda bir sprout / puffshroom cikinca (nesne gorununce ya da sunucu duyurusu gelince) o
-- tarlaya gidip PATLAYANA kadar orada farm eder. Ikisinin de bir buyume / polen cubugu var;
-- tarlada polen toplayinca dolar ve nesne patlar (sprout token sacar, puffshroom baska
-- tarlalarda yeni puffshroom tohumlari birakabilir: sonraki en yakin olan otomatik secilir).
-- Vicious / Mondo / firefly gibi olaylar ve kovana donme (canta dolu) once calisir; sprout
-- sadece "hangi tarlada farm edilecek" kararini degistirir. Ant Field'da sprout cikmaz.
-- (Yeni top-level local acilmasin diye env.BSSSprout icinde.)
env.BSSSprout = {
    set = {}, seen = setmetatable({}, { __mode = "k" }), skip = setmetatable({}, { __mode = "k" }),
    kind = setmetatable({}, { __mode = "k" }),
    cur = nil, curZone = nil, startAt = 0, zoneName = nil,
    hintZone = nil, hintAt = 0, signalAt = 0, scanAt = 0, deepAt = 0,
    lootUntil = 0, lootZone = nil, popped = 0, label = nil,
    info = "Sprouts / puffshrooms: off",
    bad = { "summon", "gui", "planter", "seed", "dispenser", "icon", "bar", "beam", "attach", "shadow", "bean",
        "spore", "smoke" },
    badParents = { Toys = true, Planters = true, PlanterModels = true, Honeycombs = true, NPCs = true,
        Bees = true, Collectibles = true },
}

-- Sprout / puffshroom grind sirasinda (hedef tarla belli iken) o tarlanin DISINDAKI sticker / sticker
-- token'lari toplama: hive hub'da dogan sticker karakteri sprout tarlasindan cekip goturmesin.
-- true donerse o konumdaki pickup yok sayilir.
env.BSSSprout.blocksPickup = function(pos)
    local C = env.BSSSprout
    if not pos or not (S.AutoSprouts or S.AutoPuffshrooms) or not C.zoneName then
        return false
    end
    local z = fieldOfPos(pos)
    return not (z and z.Name == C.zoneName)
end

env.BSSSprout.isAntField = function(z)
    return z ~= nil and string.find(string.lower(z.Name), "^ant%s*field") ~= nil
end

-- Ad -> tur: "puff" (adinda puffshroom) / "sprout" / nil. (Sadece "puff" degil: duman / efekt
-- parcaciklari da "puff" icerebilir.)
env.BSSSprout.kindOf = function(name)
    if string.find(name, "[Pp][Uu][Ff][Ff][Ss][Hh][Rr][Oo][Oo][Mm]") then
        return "puff"
    end
    if string.find(name, "[Ss][Pp][Rr][Oo][Uu][Tt]") then
        return "sprout"
    end
    return nil
end

env.BSSSprout.enabled = function(kind)
    return (kind == "puff" and S.AutoPuffshrooms) or (kind == "sprout" and S.AutoSprouts) or false
end

-- Nesne takip edilecek bir sprout / puffshroom mu? Tur dondurur (yoksa false).
-- forced: klasor adindan bilinen tur (ad kontrolu atlanir, ama diger filtreler gecerli)
env.BSSSprout.isSprout = function(inst, forced)
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then
        return false
    end
    local n = string.lower(inst.Name)
    local kind = forced or env.BSSSprout.kindOf(inst.Name)
    if not kind then
        return false
    end
    for _, w in ipairs(env.BSSSprout.bad) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    if string.find(n, "sticker", 1, true) then
        return false -- sticker sprout hive hub'da dogar, tarla sprout'u degil
    end
    if inst:IsA("BasePart") and inst.Size.Magnitude < 2 then
        return false
    end
    if inOwnArea(inst) then
        return false
    end
    local a = inst.Parent
    while a and a ~= workspace do
        if env.BSSSprout.badParents[a.Name] then
            return false
        end
        local an = string.lower(a.Name)
        if string.find(an, "hive", 1, true) or string.find(an, "hub", 1, true)
            or string.find(an, "honeycomb", 1, true) then
            return false -- hive hub alanindaki nesneler sprout sayilmaz
        end
        a = a.Parent
    end
    return kind
end

env.BSSSprout.register = function(inst, kind)
    local C = env.BSSSprout
    -- ust nesnesi zaten listedeyse (ayni sprout'un parcasi) ekleme
    local a = inst.Parent
    while a and a ~= workspace do
        if C.set[a] then
            return
        end
        a = a.Parent
    end
    -- alt parcalari daha once eklendiyse onlari cikar (kapsayici gelince tek hedef kalsin)
    for k in pairs(C.set) do
        if k ~= inst and k:IsDescendantOf(inst) then
            C.set[k] = nil
        end
    end
    if not C.set[inst] then
        C.set[inst] = tick()
    end
    C.kind[inst] = kind or C.kindOf(inst.Name) or "sprout"
end

connect(workspace.DescendantAdded, function(inst)
    local C = env.BSSSprout
    if (S.AutoSprouts or S.AutoPuffshrooms) and C.kindOf(inst.Name) then
        local kind = C.isSprout(inst)
        if kind and C.enabled(kind) then
            C.register(inst, kind)
        end
    end
end)

-- Ucuz tarama: workspace'in cocuklari + "Sprouts" / "Puffshrooms" / "Happenings" / "Particles"
-- klasorleri (en fazla 2 alt seviye). Sprouts / Puffshrooms klasorundeki her sey o turdur.
env.BSSSprout.scanTop = function()
    local C = env.BSSSprout
    local function look(inst, forced)
        if C.seen[inst] then
            return
        end
        local kind = forced or C.kindOf(inst.Name)
        if kind and C.enabled(kind) and C.isSprout(inst, forced) then
            C.seen[inst] = true
            C.register(inst, kind)
        end
    end
    local function folderKind(name)
        local n = string.lower(name)
        if n == "sprouts" then
            return "sprout"
        elseif n == "puffshrooms" then
            return "puff"
        end
        return nil
    end
    for _, ch in ipairs(workspace:GetChildren()) do
        look(ch)
    end
    for _, fname in ipairs({ "Sprouts", "Puffshrooms", "Happenings", "Particles" }) do
        local folder = workspace:FindFirstChild(fname)
        if folder then
            local fk = folderKind(fname)
            for _, ch in ipairs(folder:GetChildren()) do
                look(ch, fk)
                if ch:IsA("Folder") then
                    local subs = ch:GetChildren()
                    if #subs <= 200 then
                        local sk = fk or folderKind(ch.Name)
                        for _, sub in ipairs(subs) do
                            look(sub, sk)
                        end
                    end
                end
            end
        end
    end
end

-- Oyunun herhangi bir yazisi: "A Rare Sprout has spawned in the Pine Tree Forest" gibi duyuru
env.BSSSprout.onText = function(text)
    local C = env.BSSSprout
    if not running or not (S.AutoSprouts or S.AutoPuffshrooms) or type(text) ~= "string" or #text > 300 then
        return
    end
    local t = string.lower(text)
    local kind = C.kindOf(text)
    if not kind or not C.enabled(kind) then
        return
    end
    -- "Sticker Sprouts are about to spawn in the Hive Hub..." gibi duyurular tarla sprout'u degil:
    -- hive hub'da dogar, tarlaya gidilmez
    if string.find(t, "sticker", 1, true) or string.find(t, "hive hub", 1, true)
        or string.find(t, "hub", 1, true) or string.find(t, "about to", 1, true) then
        return
    end
    for _, w in ipairs({ "summoner", "cooldown", "popped", "burst", "pop!", "next ", "despawn", "available",
        "ready", "exploded", "defeated", "spores" }) do
        if string.find(t, w, 1, true) then
            return
        end
    end
    -- sayac / zamanlayici yazilari bildirim degil
    if string.find(t, "%d+:%d+") or string.find(t, "%d+%s*min") or string.find(t, "%d+%s*sec")
        or string.find(t, "%d+%s*hour") then
        return
    end
    local spawnish = false
    for _, w in ipairs({ "spawn", "appear", "plant", "grow", "arriv", "has come", "found" }) do
        if string.find(t, w, 1, true) then
            spawnish = true
            break
        end
    end
    if not spawnish then
        return
    end
    C.signalAt = tick()
    C.deepAt, C.scanAt = 0, 0
    local z = zoneFromText(text)
    if z and not C.isAntField(z) then
        C.hintZone, C.hintAt = z, tick()
    end
end

-- Puffshroom patladiktan sonra dusen loot'u toplar. true = bu adimda loot ile ilgilendik
-- (farmStep geri donsun), false = yapacak is yok. (Mondo loot mantigiyla ayni.)
env.BSSSprout.step = function(root)
    local C = env.BSSSprout
    local L = C.puffLoot
    if not L then
        return false
    end
    if not root or not (S.PuffLoot and S.AutoPuffshrooms) then
        C.puffLoot = nil
        return false
    end
    local now = tick()
    if now >= L.untilAt then
        C.puffLoot = nil
        setStatus("Puffshroom loot: done")
        return false
    end
    local tok = tokenNear(L.pos, S.PuffLootRadius)
    if tok then
        L.got = now
        setStatus("Puffshroom popped: collecting loot...")
        chaseToken(tok, nil)
        return true
    end
    if now - L.got < 4 then
        setStatus("Puffshroom popped: waiting for loot...")
        if flat(root.Position, L.pos) > 10 then
            travelTo(L.pos + Vector3.new(0, 3, 0), 4)
        else
            task.wait(0.3)
        end
        return true
    end
    C.puffLoot = nil
    setStatus("Puffshroom loot: done")
    return false
end

-- Her saniye: sprout'lari bul / sec / bitisini izle ve hangi tarlada farm edilecegini guncelle
env.BSSSprout.update = function()
    local C = env.BSSSprout
    if not (S.AutoSprouts or S.AutoPuffshrooms) then
        C.cur, C.curZone, C.zoneName, C.hintZone = nil, nil, nil, nil
        C.info = "Sprouts / puffshrooms: off"
        return
    end
    local now = tick()
    local root = hrp()

    if now >= C.scanAt then
        C.scanAt = now + 4
        pcall(C.scanTop)
    end
    -- duyuru geldiyse (ya da ozellik yeni acildiysa) workspace'i sinirli derinlikte tara
    if now - C.signalAt < 60 and now >= C.deepAt then
        C.deepAt = now + 6
        pcall(boundedWalk, workspace, 4, 8000, function(d)
            local kind = C.kindOf(d.Name)
            if kind and C.enabled(kind) then
                local k2 = C.isSprout(d)
                if k2 then
                    C.register(d, k2)
                end
            end
            return false
        end)
    end

    for k in pairs(C.set) do
        if not k.Parent then
            C.set[k] = nil
        end
    end

    -- aktif sprout: patladi mi / cok uzun surdu mu
    if C.cur then
        if C.cur.Parent and C.kind[C.cur] == "puff" then
            local lp = targetPos(C.cur)
            if lp then
                C.puffPos = lp -- patlayinca loot buraya duser
            end
        end
        if not C.cur.Parent then
            if C.kind[C.cur] == "puff" and S.PuffLoot and C.puffPos then
                C.puffLoot = { pos = C.puffPos, untilAt = now + math.max(5, S.PuffLootSec), got = now }
            end
            C.puffPos = nil
            C.popped = C.popped + 1
            C.lootUntil = now + 8 -- patlayinca tarlaya token sacar: kisa sure orada kal, topla
            C.lootZone = C.curZone and C.curZone.Name
            C.cur, C.curZone, C.hintZone = nil, nil, nil
        elseif not C.enabled(C.kind[C.cur]) then
            C.cur, C.curZone = nil, nil -- bu tur kapatildi
        elseif now - C.startAt > math.max(1, C.kind[C.cur] == "puff" and S.PuffGiveUpMin or S.SproutGiveUpMin) * 60 then
            C.skip[C.cur] = true
            C.cur, C.curZone, C.hintZone = nil, nil, nil
        end
    end

    -- yeni sprout sec: en yakin, bir tarlanin icinde olan (Ant Field degil)
    if not C.cur then
        local best, bestD, bestZ
        for inst in pairs(C.set) do
            if not C.skip[inst] and C.enabled(C.kind[inst]) then
                local p = targetPos(inst)
                local z = p and fieldOfPos(p)
                if z and not C.isAntField(z) and inField(z, p, 0) and math.abs(p.Y - fieldTop(z)) < 40 then
                    local d = root and (p - root.Position).Magnitude or 0
                    if not bestD or d < bestD then
                        best, bestD, bestZ = inst, d, z
                    end
                end
            end
        end
        if best then
            C.cur, C.curZone, C.startAt = best, bestZ, now
            C.lootUntil = 0
        end
    end

    if C.cur then
        C.zoneName = C.curZone and C.curZone.Name
        C.info = string.format("Grinding %s in %s (%d s)", C.cur.Name,
            C.zoneName or "?", math.floor(now - C.startAt))
    elseif now < C.lootUntil and C.lootZone then
        C.zoneName = C.lootZone
        C.info = "Popped! collecting the drop in " .. C.lootZone
    elseif C.hintZone and C.hintZone.Parent and now - C.hintAt < 150 then
        -- duyuru var ama nesne henuz bulunamadi: tarlaya git, orada farm et
        C.zoneName = C.hintZone.Name
        C.info = "Announced in " .. C.zoneName .. ", looking for it..."
    else
        C.zoneName = nil
        C.info = "Sprouts / puffshrooms: none found" .. (C.popped > 0 and (" (" .. C.popped .. " popped)") or "")
    end
end

task.spawn(function()
    while running do
        local ok, err = pcall(env.BSSSprout.update)
        if not ok then
            warn("[BSSFarm] sprout: " .. tostring(err))
        end
