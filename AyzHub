-- Secili olmayan renkteki petal'ler normal token toplamada da atlanir
env.BSSBloom.skipToken = function(p)
    if not S.FarmBlooms then
        return false
    end
    if not string.find(string.lower(p.Name), "petal", 1, true) then
        return false
    end
    if not env.BSSBloom.isPetal(p) then
        return false -- PetalShuriken / Petal Shop gibi sahte petal'lere karisma
    end
    return not env.BSSBloom.allowed(env.BSSBloom.colorOf(p))
end

-- Menzildeki en yakin SECILI renkte petal'e gidip toplar. Is yaptiysa true.
env.BSSBloom.petalStep = function(root)
    local C = env.BSSBloom
    local now = tick()
    local tok = nil
    if now < C.pNext then
        tok = C.pRes
        if tok and (not tok.Parent or (C.petalSkip[tok] or 0) > now) then
            tok = nil
        end
    else
        C.pNext = now + 0.15
        local bestD
        for _, fname in ipairs({ "Collectibles", "Particles" }) do
            local folder = workspace:FindFirstChild(fname)
            if folder then
                for _, p in ipairs(folder:GetChildren()) do
                    if (C.petalSkip[p] or 0) < now and C.isPetal(p) then
                        local pos = posOf(p)
                        if pos then
                            local d = (pos - root.Position).Magnitude
                            if d <= S.BloomPetalRange and (not bestD or d < bestD) and C.allowed(C.colorOf(p)) then
                                tok, bestD = p, d
                            end
                        end
                    end
                end
            end
        end
        C.pRes = tok
    end
    if not tok then
        return false
    end
    setStatus(string.format("bloom petal (%s): collecting...", C.colorOf(tok) or "?"))
    tweenFollow(function()
        if not tok.Parent then
            return nil
        end
        local p = posOf(tok)
        return p and (p + Vector3.new(0, 2, 0)) or nil
    end, 2.5, 6, math.max(60, S.TokenTweenSpeed))
    if tok.Parent then
        C.petalTries[tok] = (C.petalTries[tok] or 0) + 1
        C.petalSkip[tok] = tick() + (C.petalTries[tok] >= 2 and 60 or 3)
    end
    return true
end

-- Hedef bloom bu tarladaysa uzerine git / yaninda dur (bee'ler ve alet patlatsin). Is yaptiysa true.
env.BSSBloom.popStep = function(zone, root)
    local C = env.BSSBloom
    if not (S.FarmBlooms and C.cur and C.cur.Parent and C.curZone == zone) then
        return false
    end
    local p = targetPos(C.cur)
    if not p then
        return false
    end
    if flat(root.Position, clampToField(zone, p)) > 5 then
        setStatus("bloom: going to the " .. (C.colorOf(C.cur) or "") .. " bloom in " .. zone.Name .. "...")
        tweenFollow(function()
            local q = C.cur and C.cur.Parent and targetPos(C.cur)
            return q and clampToField(zone, q) or nil
        end, 3, 4, S.MoveSpeed)
    else
        setStatus("bloom: popping the " .. (C.colorOf(C.cur) or "") .. " bloom...")
        task.wait(0.25)
    end
    return true
end

