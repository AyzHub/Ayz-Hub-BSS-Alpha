function textbox(tab, text, key, placeholder, onChange)
    local r = new("Frame", {
        Size = UDim2.new(1, 0, 0, 44), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = nextOrder(tab),
    }, host(tab))
    new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, r)
    new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), Text = text, TextColor3 = THEME.text,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
    }, r)
    local box = new("TextBox", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = THEME.side, TextColor3 = THEME.text,
        PlaceholderText = placeholder or "", PlaceholderColor3 = THEME.sub, Font = Enum.Font.Gotham,
        TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
        BorderSizePixel = 0, LayoutOrder = 2, Text = "", TextTruncate = Enum.TextTruncate.AtEnd,
    }, r)
    round(box, 4)
    new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, box)
    local function shown()
        local v = S[key] or ""
        return v == "" and "" or (string.sub(v, 1, 33) .. " ••••••••")
    end
    connect(box.Focused, function()
        box.Text = S[key] or ""
    end)
    connect(box.FocusLost, function()
        S[key] = string.match(box.Text, "^%s*(.-)%s*$") or ""
        box.Text = shown()
        if onChange then onChange() end
        save()
    end)
    box.Text = shown()
    refreshers[#refreshers + 1] = function() box.Text = shown() end
    register(tab, r, text)
end

