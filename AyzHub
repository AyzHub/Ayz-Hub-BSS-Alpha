env.BSSMondo.posOf = function(inst)
    if not inst then
        return nil
    end
    local ok, p = pcall(function()
        local body = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
        if body and body:IsA("BasePart") then
            return body.Position
        end
        return nil
    end)
    if ok and p then
        return p
    end
    return targetPos(inst)
end

env.BSSMondo.isMondo = function(inst)
    if not string.find(inst.Name, "[Mm][Oo][Nn][Dd][Oo]") or not inst:IsA("Model") then
        return false
    end
    local n = string.lower(inst.Name)
    local letters = string.gsub(n, "[^%a]", "")
    local inMonsters = false
    for _, rn in ipairs({ "Monsters", "Enemies", "Mobs" }) do
        local folder = workspace:FindFirstChild(rn)
        if folder and inst:IsDescendantOf(folder) then
            inMonsters = true
            break
        end
    end
    if not (string.find(letters, "mondochick", 1, true) or (inMonsters and string.find(letters, "mondo", 1, true))) then
        return false
    end
    for _, w in ipairs(DECOR_WORDS) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    return not inOwnArea(inst)
end

env.BSSMondo.alive = function(inst)
    if not inst or not inst.Parent then
        return false
    end
    local h = inst:FindFirstChildOfClass("Humanoid")
    return (not h or h.Health > 0) and env.BSSMondo.posOf(inst) ~= nil
end

env.BSSMondo.zone = function()
    local fz = workspace:FindFirstChild("FlowerZones")
    if not fz then
        return nil
    end
    for _, z in ipairs(fz:GetChildren()) do
        if z:IsA("BasePart") and string.find(string.lower(z.Name), "mountain", 1, true) then
            return z
        end
    end
    return nil
end

