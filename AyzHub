env.BSSMondo = {
    cache = nil, hint = nil, scanAt = 0, deepAt = 0, streamAt = 0, ignoreUntil = 0,
    signalAt = 0, firstSeen = nil, holdBase = nil, lastPos = nil,
    lootUntil = nil, lootGot = 0, loot = false,
