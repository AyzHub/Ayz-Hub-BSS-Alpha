env.BSSBooster.names = function()
    local C = env.BSSBooster
    local found = {}
    local toys = workspace:FindFirstChild("Toys")
    if toys then
        for _, ch in ipairs(toys:GetChildren()) do
            local n = string.lower(ch.Name)
            if string.find(n, "booster", 1, true) then
                found[#found + 1] = ch.Name
            end
        end
    end
    local list, used = {}, {}
    for _, d in ipairs(C.defaults) do
        if S[d.key] then
            local use = d.name
            for _, fname in ipairs(found) do
                local n = string.lower(fname)
                local isBlue = string.find(n, "blue", 1, true) ~= nil
                local isRed = string.find(n, "red", 1, true) ~= nil
                local hit = (d.match == "blue" and isBlue) or (d.match == "red" and isRed)
                    or (d.match == "white" and not isBlue and not isRed)
                if hit then
                    use = fname
                    break
                end
            end
            if not used[use] then
                used[use] = true
                list[#list + 1] = use
            end
        end
    end
    return list
end

env.BSSBooster.use = function()
    local C = env.BSSBooster
    local events = RS:FindFirstChild("Events")
    local toyEvent = events and events:FindFirstChild("ToyEvent")
    if not toyEvent then
        setStatus("Events.ToyEvent not found")
        C.nextAt = tick() + 30
        return
    end
    local names = C.names()
    if #names == 0 then
        C.nextAt = tick() + 30
        return
    end
    for _, name in ipairs(names) do
        if not running or not S.AutoBoosters then
            return
        end
        pcall(function() toyEvent:FireServer(name) end)
        task.wait(0.3)
    end
    setStatus("used boosters: " .. table.concat(names, ", "))
    C.nextAt = tick() + math.max(5, S.BoosterMinutes) * 60
end

