local function stripTags(s)
    return (string.gsub(s, "<[^>]+>", ""))
end

local questContainerCache
local function findQuestContainer()
    if questContainerCache and questContainerCache.Parent then
        return questContainerCache
    end
    questContainerCache = nil
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then
        return nil
    end
    for _, d in ipairs(pg:GetDescendants()) do
        if d.Name == "Quests" and (d:IsA("Frame") or d:IsA("ScrollingFrame"))
            and not d:FindFirstAncestor("BSSFarm") then
            questContainerCache = d
            return d
        end
    end
    return nil
end

-- Her gorev kutusunun icindeki yazilari tek metin olarak toplar
local function questBlocks(container)
    local content = container:FindFirstChild("Content") or container
    local blocks = {}
    for _, b in ipairs(content:GetChildren()) do
        if b:IsA("GuiObject") then
            local parts = {}
            for _, d in ipairs(b:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
                    parts[#parts + 1] = stripTags(d.Text)
                end
            end
            if #parts > 0 then
                blocks[#blocks + 1] = table.concat(parts, "\n")
            end
        end
    end
    return blocks
end

local function fieldKeys(name)
    local full = string.lower(name)
    local short = full:gsub(" field$", ""):gsub(" patch$", ""):gsub(" forest$", "")
    return full, short
end

-- Metinlerde gecen tarla adlarini, gecis sirasina gore dondurur
local function questFieldsIn(texts)
    local found, seen = {}, {}
    local names = fieldNames()
    for _, text in ipairs(texts) do
        local low = string.lower(text)
        local hits = {}
        for _, n in ipairs(names) do
            local full, short = fieldKeys(n)
            local pos = string.find(low, full, 1, true)
            if not pos and #short >= 4 then
                pos = string.find(low, short, 1, true)
            end
            if pos then
                hits[#hits + 1] = { pos = pos, name = n }
            end
        end
        table.sort(hits, function(a, b) return a.pos < b.pos end)
        for _, h in ipairs(hits) do
            if not seen[h.name] then
                seen[h.name] = true
                found[#found + 1] = h.name
            end
        end
    end
    return found
end

local function updateQuest()
    local container = findQuestContainer()
    questState.guiFound = container ~= nil
    if not container then
        questState.fields, questState.field = {}, nil
        if questInfoLabel then
            questInfoLabel.Text = "Quest menu not found in the GUI. Use 'Quest debug' and check the console (F9)."
        end
        return
    end

    local blocks = questBlocks(container)
    local polar = {}
    for _, t in ipairs(blocks) do
        if string.find(string.lower(t), "polar", 1, true) then
            polar[#polar + 1] = t
        end
    end
    local use = polar
    if #use == 0 and S.QuestAnyGiver then
        use = blocks
    end

    local fields = questFieldsIn(use)
    local sig = table.concat(fields, "|")
    if sig ~= questState.sig then
        questState.sig = sig
        questState.since = tick()
    end
    questState.fields = fields

    if #fields == 0 then
        questState.field = nil
    else
        local slot = math.floor((tick() - questState.since) / math.max(30, S.QuestRotateMin * 60))
        questState.field = fields[(slot % #fields) + 1]
    end

    if questInfoLabel then
        local src = (#polar > 0) and "Polar Bear" or (S.QuestAnyGiver and "all quests" or "no Polar Bear quest")
        questInfoLabel.Text = string.format("Source: %s\nQuest fields: %s\nFarming: %s",
            src,
            #fields > 0 and table.concat(fields, ", ") or "none found",
            questState.field or "(your selected field)")
    end
end

