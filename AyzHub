                    or string.find(n, "convert", 1, true) then
                    print("[BSSFarm] remote:", e.ClassName, e.Name)
                end
            end
        end
        setStatus("convert debug printed to the console (F9)")
    end

    toolKit.debug = function()
        print("[BSSFarm] ---------------- tool debug ----------------")
        local c = player.Character
        local bp = player:FindFirstChild("Backpack")
        local function dump(label, parent)
            if not parent then
                print("[BSSFarm] " .. label .. ": none")
