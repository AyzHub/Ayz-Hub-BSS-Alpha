-- AyzHub | Panda Auth + Key GUI (PUSL-V4)
-- ============================================================================
do
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local lp = Players.LocalPlayer
    local genv = (getgenv and getgenv()) or _G

    local KEY_FILE = "ayzhub_key.txt"

    local PUSL = loadstring(game:HttpGet("https://secure.pandauth.com/pv4/lib"))()
    if not PUSL or type(PUSL.configure) ~= "function" then
        return warn("[Panda] Library failed to initialize.")
    end
    PUSL.configure({ serviceId = "ayzhub" })

    local function readSavedKey()
        local ok, data = pcall(function()
            if isfile and readfile and isfile(KEY_FILE) then
                return readfile(KEY_FILE)
            end
        end)
        if ok and type(data) == "string" then
            return (data:gsub("%s+", ""))
        end
        return ""
    end

    local function saveKey(k)
        pcall(function()
            if writefile then
                writefile(KEY_FILE, k)
            end
        end)
    end

    local function tryValidate(k)
        local ok, res = pcall(PUSL.validate, k)
        if not ok then
            return false, "Connection error. Try again.", nil
        end
        if type(res) == "table" and res.success then
            return true, "Key accepted", res
        end
        local msg = (type(res) == "table" and (res.message or res.error or res.reason)) or "Invalid or expired key"
        return false, tostring(msg), res
    end

    -- Kayitli key hala gecerliyse GUI hic acilmaz
    local passed, passedResult = false, nil
    do
        local saved = readSavedKey()
        if saved ~= "" then
            local ok, _, res = tryValidate(saved)
            if ok then
                passed, passedResult = true, res
            end
        end
    end

    if not passed then
        local T = {
            bg = Color3.fromRGB(17, 18, 24),
            panel = Color3.fromRGB(27, 29, 39),
            panel2 = Color3.fromRGB(38, 41, 56),
            accent = Color3.fromRGB(255, 190, 60),
            text = Color3.fromRGB(235, 236, 242),
            sub = Color3.fromRGB(145, 150, 170),
            ok = Color3.fromRGB(46, 204, 113),
            bad = Color3.fromRGB(231, 76, 90),
            dark = Color3.fromRGB(20, 20, 26),
        }

        local function new(class, props, parent)
            local o = Instance.new(class)
            for k, v in pairs(props) do o[k] = v end
            o.Parent = parent
            return o
        end
        local function corner(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, p) end

        local gui = new("ScreenGui", {
            Name = "AyzHubKey", ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100,
        })
        local okParent = pcall(function()
            gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        end)
        if not okParent or not gui.Parent then
            gui.Parent = lp:WaitForChild("PlayerGui")
        end

        -- arka plan karartma
        local dim = new("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
        }, gui)
        TweenService:Create(dim, TweenInfo.new(0.3), { BackgroundTransparency = 0.45 }):Play()

        local card = new("Frame", {
            Size = UDim2.fromOffset(380, 270), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 20), BackgroundColor3 = T.bg, BorderSizePixel = 0,
            BackgroundTransparency = 1,
        }, gui)
        corner(card, 14)
        local stroke = new("UIStroke", { Color = T.panel2, Thickness = 1.5, Transparency = 1 }, card)
        new("UIScale", { Scale = 1 }, card)

        TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quint),
            { Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 0 }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.35), { Transparency = 0 }):Play()

        -- ust aksan seridi
        local bar = new("Frame", {
            Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = T.accent, BorderSizePixel = 0,
        }, card)
        corner(bar, 14)

        -- baslik
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 20), Size = UDim2.new(1, -80, 0, 26),
            Text = "AyzHub", TextColor3 = T.text, Font = Enum.Font.GothamBold, TextSize = 22,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, card)
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 48), Size = UDim2.new(1, -48, 0, 18),
            Text = "Bee Swarm Simulator  |  Key verification", TextColor3 = T.sub,
            Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        }, card)

        local closeBtn = new("TextButton", {
            Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -42, 0, 16),
            BackgroundColor3 = T.panel2, Text = "x", TextColor3 = T.bad,
            Font = Enum.Font.GothamBold, TextSize = 16, BorderSizePixel = 0, AutoButtonColor = false,
        }, card)
        corner(closeBtn, 7)

        -- key kutusu
        local inputWrap = new("Frame", {
            Position = UDim2.fromOffset(24, 88), Size = UDim2.new(1, -48, 0, 42),
            BackgroundColor3 = T.panel, BorderSizePixel = 0,
        }, card)
        corner(inputWrap, 9)
        local inputStroke = new("UIStroke", { Color = T.panel2, Thickness = 1.2 }, inputWrap)
        local box = new("TextBox", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0),
            Text = "", PlaceholderText = "Enter your key...", PlaceholderColor3 = T.sub,
            TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
        }, inputWrap)

        box.Focused:Connect(function()
            TweenService:Create(inputStroke, TweenInfo.new(0.15), { Color = T.accent }):Play()
        end)
        box.FocusLost:Connect(function()
            TweenService:Create(inputStroke, TweenInfo.new(0.15), { Color = T.panel2 }):Play()
        end)

        -- durum yazisi
        local status = new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 138), Size = UDim2.new(1, -48, 0, 18),
            Text = "Paste your key and press Verify.", TextColor3 = T.sub,
            Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        }, card)

        local function setStatus(text, color)
            status.Text = text
            status.TextColor3 = color or T.sub
        end

        -- butonlar
        local verifyBtn = new("TextButton", {
            Position = UDim2.fromOffset(24, 168), Size = UDim2.new(1, -48, 0, 40),
            BackgroundColor3 = T.accent, Text = "Verify Key", TextColor3 = T.dark,
            Font = Enum.Font.GothamBold, TextSize = 14, BorderSizePixel = 0, AutoButtonColor = false,
        }, card)
        corner(verifyBtn, 9)

        local getBtn = new("TextButton", {
            Position = UDim2.fromOffset(24, 216), Size = UDim2.new(0.5, -28, 0, 34),
            BackgroundColor3 = T.panel2, Text = "Get Key", TextColor3 = T.text,
            Font = Enum.Font.GothamBold, TextSize = 12, BorderSizePixel = 0, AutoButtonColor = false,
        }, card)
        corner(getBtn, 8)

        local pasteBtn = new("TextButton", {
            Position = UDim2.new(0.5, 4, 0, 216), Size = UDim2.new(0.5, -28, 0, 34),
            BackgroundColor3 = T.panel2, Text = "Paste", TextColor3 = T.text,
            Font = Enum.Font.GothamBold, TextSize = 12, BorderSizePixel = 0, AutoButtonColor = false,
        }, card)
        corner(pasteBtn, 8)

        -- hover efekti
        local function hover(btn, base, over)
            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = over }):Play()
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
            end)
        end
        hover(verifyBtn, T.accent, Color3.fromRGB(255, 205, 100))
        hover(getBtn, T.panel2, Color3.fromRGB(52, 56, 76))
        hover(pasteBtn, T.panel2, Color3.fromRGB(52, 56, 76))
        hover(closeBtn, T.panel2, Color3.fromRGB(60, 40, 48))

        -- surukleme
        local dragging, dragStart, startPos
        card.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                local rel = i.Position.Y - card.AbsolutePosition.Y
                if rel < 76 then
                    dragging, dragStart, startPos = true, i.Position, card.Position
                end
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - dragStart
                card.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        local function shake()
            local base = card.Position
            for _, dx in ipairs({ 8, -8, 5, -5, 0 }) do
                TweenService:Create(card, TweenInfo.new(0.05), {
                    Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset),
                }):Play()
                task.wait(0.05)
            end
        end

        local done = Instance.new("BindableEvent")
        local busy = false
        local cancelled = false

        local function submit()
            if busy then return end
            local k = (box.Text or ""):gsub("%s+", "")
            if k == "" then
                setStatus("Please enter a key first.", T.bad)
                task.spawn(shake)
                return
            end
            busy = true
            verifyBtn.Text = "Verifying..."
            verifyBtn.BackgroundColor3 = Color3.fromRGB(150, 118, 40)
            setStatus("Checking key...", T.sub)

            local ok, msg, res = tryValidate(k)
            if ok then
                saveKey(k)
                passed, passedResult = true, res
                verifyBtn.Text = "Success"
                verifyBtn.BackgroundColor3 = T.ok
                setStatus(res.isPremium and "Key accepted  |  Premium" or "Key accepted  |  Free", T.ok)
                task.wait(0.8)
                done:Fire()
            else
                verifyBtn.Text = "Verify Key"
                verifyBtn.BackgroundColor3 = T.accent
                setStatus(msg, T.bad)
                task.spawn(shake)
                busy = false
            end
        end

        verifyBtn.MouseButton1Click:Connect(submit)
        box.FocusLost:Connect(function(enter)
            if enter then submit() end
        end)

        getBtn.MouseButton1Click:Connect(function()
            local okUrl, url = pcall(PUSL.getKeyUrl)
            if okUrl and url then
                local copied = pcall(function() setclipboard(url) end)
                setStatus(copied and "Key link copied to clipboard." or ("Key link: " .. tostring(url)),
                    copied and T.ok or T.sub)
            else
                setStatus("Could not get the key link.", T.bad)
            end
        end)

        pasteBtn.MouseButton1Click:Connect(function()
            local okClip, clip = pcall(function()
                return getclipboard and getclipboard() or nil
            end)
            if okClip and type(clip) == "string" and clip ~= "" then
                box.Text = (clip:gsub("%s+", ""))
                setStatus("Pasted from clipboard.", T.sub)
            else
                setStatus("Clipboard is not available. Paste manually.", T.sub)
            end
        end)

        closeBtn.MouseButton1Click:Connect(function()
            cancelled = true
            done:Fire()
        end)

        done.Event:Wait()
        done:Destroy()
        TweenService:Create(card, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(dim, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        task.wait(0.2)
        gui:Destroy()

        if cancelled or not passed then
            warn("[Panda] Get a key: " .. tostring(PUSL.getKeyUrl()))
            genv.AyzHubKeyFailed = true
        end
    end

    if not passed then
        genv.AyzHubKeyFailed = nil
        return
    end

    genv.AyzHubPremium = passedResult and passedResult.isPremium or false
    print("[Panda] Authenticated. Premium:", genv.AyzHubPremium)
end

