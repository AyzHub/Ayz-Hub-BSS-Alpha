--- getOptions() -> {string}, get() -> string, set(string)
function dropdown(tab, text, getOptions, get, set)
    local container = new("Frame", {
        Size = UDim2.new(1, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = nextOrder(tab),
    }, host(tab))
    new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, container)

    local header = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = THEME.panel2, TextColor3 = THEME.text,
        Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0, AutoButtonColor = false,
        Text = "", LayoutOrder = 1, TextTruncate = Enum.TextTruncate.AtEnd,
    }, container)
    round(header, 4)
    new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 22) }, header)
    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(1, 14, 0, 0), Size = UDim2.fromOffset(16, 28),
        Text = "▼", TextColor3 = THEME.text, Font = Enum.Font.Gotham, TextSize = 10,
    }, header)

    local list = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = THEME.side, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = THEME.accent, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, LayoutOrder = 2,
    }, container)
    round(list, 4)
    new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 6),
    }, list)

    local isOpen = false
    local function refresh()
        local cur = get()
        header.Text = text .. ": " .. (cur ~= "" and cur or "(pick one)")
    end
    local function close()
        isOpen = false
        list.Visible = false
    end
    local function rebuild()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local opts = getOptions()
        if #opts == 0 then
            opts = { "(nothing found)" }
        end
        list.Size = UDim2.new(1, 0, 0, math.min(#opts * 29 + 8, 172))
        local cur = get()
        for i, o in ipairs(opts) do
            local b = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, Text = tostring(o),
                BackgroundColor3 = (o == cur) and THEME.accentDim or THEME.panel,
                TextColor3 = (o == cur) and THEME.text or THEME.sub,
                Font = Enum.Font.Gotham, TextSize = 12, BorderSizePixel = 0,
            }, list)
            round(b, 4)
            connect(b.MouseButton1Click, function()
                if string.sub(tostring(o), 1, 1) ~= "(" then
                    set(o)
                    save()
                end
                close()
                refresh()
            end)
        end
    end
    connect(header.MouseButton1Click, function()
        if isOpen then
            close()
        else
            rebuild()
            isOpen = true
            list.Visible = true
        end
    end)
    refresh()
    refreshers[#refreshers + 1] = function() close() refresh() end
    register(tab, container, text)
end

