local function diagnose()
    local missing = {}
    local function need(label, inst)
        if not inst then
            missing[#missing + 1] = label
        end
    end
    local events = RS:FindFirstChild("Events")
    need("ReplicatedStorage.Events", events)
    if events then
        need("Events.ClaimHive", events:FindFirstChild("ClaimHive"))
        need("Events.PlayerHiveCommand", events:FindFirstChild("PlayerHiveCommand"))
        if S.PolarQuest then
            if S.QuestLearnGive == "" then
                need("a quest ACCEPT remote (Events.GiveQuest*) - or use Learn ACCEPT", questState.remotes("give")[1])
            end
            if S.QuestLearnComplete == "" then
                need("a quest TURN-IN remote (Events.CompleteQuest*) - or use Learn TURN-IN", questState.remotes("complete")[1])
            end
        end
    end
    need("workspace.FlowerZones", workspace:FindFirstChild("FlowerZones"))
    need("workspace.Honeycombs", workspace:FindFirstChild("Honeycombs"))
    need("workspace.Collectibles", workspace:FindFirstChild("Collectibles"))
    if S.PolarQuest then
        need("workspace.NPCs.Polar Bear", workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("Polar Bear"))
    end
    local cs = player:FindFirstChild("CoreStats")
    need("Player.CoreStats", cs)
    if cs then
        need("CoreStats.Pollen", cs:FindFirstChild("Pollen"))
        need("CoreStats.Capacity", cs:FindFirstChild("Capacity"))
    end
    return missing
end

