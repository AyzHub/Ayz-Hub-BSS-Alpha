    -- ---------------------------------------------------------- Rainbow (renk) algilama
    -- Sticker tokenler rengarenk: token'in uzerindeki / icindeki renkleri (ParticleEmitter,
    -- UIGradient, Beam, Trail, Light, Decal / Texture / Image rengi, Part rengi) toplar,
    -- doygun renklerin 6 ton kovasindan (kirmizi, sari, yesil, cyan, mavi, magenta) kacina
    -- dustugune bakar. Renk zamanla degisiyorsa (animasyonlu gokkusagi) ornekler biriktirilir.
    -- Honey Token ve Token Link her zaman haric tutulur.
    local rbRec = setmetatable({}, { __mode = "k" })   -- token -> { mask, samples, last, born }
    local rbFinal = setmetatable({}, { __mode = "k" }) -- token -> true / false (kesinlesti)
    tokenKit.rainbowSkip = setmetatable({}, { __mode = "k" })

    local function hueBit(c)
        local ok, h, s, v = pcall(function() return c:ToHSV() end)
        if not ok or not h then
            return 0
        end
        if s < 0.35 or v < 0.35 then
            return 0 -- gri / siyah / beyaz / soluk: renk sayma
        end
        return bit32.lshift(1, math.floor(h * 6) % 6)
    end

    local function seqMask(seq)
        local m = 0
        local ok, kps = pcall(function() return seq.Keypoints end)
        if ok and kps then
            for _, kp in ipairs(kps) do
                m = bit32.bor(m, hueBit(kp.Value))
            end
        end
        return m
    end

    local function popcount(m)
        local n = 0
        for i = 0, 5 do
            if bit32.band(m, bit32.lshift(1, i)) ~= 0 then
                n = n + 1
            end
        end
        return n
    end

    -- Bu andaki renk maskesi (token + tum alt nesneleri)
    local function colorMaskOf(p)
        local mask = 0
        local okd, list = pcall(function() return p:GetDescendants() end)
        local items = okd and list or {}
        items[#items + 1] = p
        for _, d in ipairs(items) do
            pcall(function()
                if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
                    mask = bit32.bor(mask, seqMask(d.Color))
                elseif d:IsA("UIGradient") then
                    mask = bit32.bor(mask, seqMask(d.Color))
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    mask = bit32.bor(mask, hueBit(d.Color3))
                elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
                    mask = bit32.bor(mask, hueBit(d.ImageColor3))
                elseif d:IsA("Light") then
                    mask = bit32.bor(mask, hueBit(d.Color))
                elseif d:IsA("Sparkles") then
                    mask = bit32.bor(mask, hueBit(d.SparkleColor))
                elseif d:IsA("Fire") then
                    mask = bit32.bor(mask, hueBit(d.Color) , hueBit(d.SecondaryColor))
                elseif d:IsA("Smoke") then
                    mask = bit32.bor(mask, hueBit(d.Color))
                elseif d:IsA("BasePart") then
                    mask = bit32.bor(mask, hueBit(d.Color))
                end
            end)
        end
        return mask
    end

    -- Token rengarenk mi? (true = evet, false = hayir / henuz belli degil)
    local function isRainbowToken(p)
        local fin = rbFinal[p]
        if fin ~= nil then
            return fin
        end
        if isHoneyToken(p) or isTokenLink(p) or isMoonToken(p) then
            rbFinal[p] = false
            return false
        end
        local now = tick()
        local rec = rbRec[p]
        if not rec then
            rec = { mask = 0, samples = 0, last = 0, born = now }
            rbRec[p] = rec
        end
        if now - rec.last >= 0.2 then -- en fazla 0.2 sn'de bir ornek (performans)
            rec.last = now
            rec.samples = rec.samples + 1
            rec.mask = bit32.bor(rec.mask, colorMaskOf(p))
        end
        local need = math.clamp(math.floor(S.RainbowMinHues or 3), 1, 6)
        if popcount(rec.mask) >= need then
            rbFinal[p] = true
            return true
        end
        -- ~1.4 sn gozlendi ve hala rengarenk degil: kesin "degil"
        if rec.samples >= 7 then
            rbFinal[p] = false
        end
        return false
    end
    tokenKit.isRainbow = isRainbowToken

    -- Menzildeki en yakin rengarenk sticker token (tarla siniri YOK). 0.15 sn onbellekli.
    local rbNext, rbResult = 0, nil
    tokenKit.nearestRainbow = function(origin, range)
        local now = tick()
