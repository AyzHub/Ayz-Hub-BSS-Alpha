local angle = 0
-- forceMove: "Stay" deseni secili olsa bile hareket et (Vicious savasinda kullanilir)
local function patternTarget(center, radius, forceMove)
    local pattern = S.Pattern
    if pattern == 3 then
        if not forceMove then
            return nil
        end
        pattern = 1 -- Stay secili ise savasta spiral kullan
    end
    angle = angle + S.PatternSpeed / 10
    local size = radius * (S.PatternSize / 100)
    if pattern == 1 then
        local r = (math.sin(angle / 7) * 0.5 + 0.5) * size + 2
        return center + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
    end
    local x = math.sin(angle * 0.5) * size
    local z = ((angle * 0.4) % (size * 2)) - size
    return center + Vector3.new(x, 0, z)
end

