local function applyFarmState()
    refreshStart()
    if not S.AutoFarm then
        setStatus("stopped")
        local h, root = hum(), hrp()
        if h and root then
            h:MoveTo(root.Position)
        end
    else
        questState.nextVisit = 0
        setStatus("starting...")
    end
    for _, fn in ipairs(refreshers) do
        pcall(fn) -- ayar anahtarinin gorunumunu de guncelle
    end
end

