local skipped = {}

-- Her mod kendi onbellegini kullanir; zamanlayici dolmadan son sonuc doner.
local scanState = {
    [1] = { t = 0, result = nil },
    [2] = { t = 0, result = nil },
}

local nearestCollectible
local tokenKit = {}
do
    -- Token Link'in dokusu (Decal) -- Token debug ile dogrulanabilir
    local LINK_ID = "1629547638"
    local linkCache = setmetatable({}, { __mode = "k" })
    -- Honey Token dokusu -- Token debug ile dogrulanabilir
    local HONEY_ID = "1472135114"
    local honeyCache = setmetatable({}, { __mode = "k" })

    local function textureOf(d)
        if d:IsA("Decal") or d:IsA("Texture") then
            return d.Texture
        elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
            return d.Image
        elseif d:IsA("SpecialMesh") then
            return d.TextureId
        elseif d:IsA("MeshPart") then
            return d.TextureID
        end
        return nil
    end

    -- Adinda `key` gecen ya da dokusu `id` iceren token mi? (sonuc onbellekte)
    local function tokenMatches(p, cache, id, key)
        local c = cache[p]
        if c ~= nil then
            return c
        end
        if string.find(string.lower(p.Name), key, 1, true) then
            cache[p] = true
            return true
        end
        local inspected = false
        local okd, list = pcall(function() return p:GetDescendants() end)
        local candidates = okd and list or {}
        candidates[#candidates + 1] = p
        for _, d in ipairs(candidates) do
            local okt, tex = pcall(textureOf, d)
            if okt and tex and tex ~= "" then
                inspected = true
                if string.find(tex, id, 1, true) then
                    cache[p] = true
                    return true
                end
            end
        end
        if inspected then
            cache[p] = false -- dokusu yuklendi ve eslesmedi
        end
        return false
    end

    local function isTokenLink(p)
        return tokenMatches(p, linkCache, LINK_ID, "link")
    end

    local function isHoneyToken(p)
        return tokenMatches(p, honeyCache, HONEY_ID, "honey")
    end
    tokenKit.isHoney = isHoneyToken

    local function nearestToken(center, radius, bubblesOnly, zone)
        local st = scanState[bubblesOnly and 2 or 1]
        local now = tick()
        if now - st.t < 0.15 then
            local r = st.result
            if r then
                if r.Parent and (skipped[r] or 0) < now then
                    return r
                end
                -- onbellekteki hedef toplandi / atlandi: BEKLEME, hemen yeniden tara
            else
                return nil -- az once hicbir sey bulunmadi; her karede tarama yapma
            end
        end
        st.t = now

        local root = hrp()
        if not root then
            st.result = nil
            return nil
        end

        local folders = {}
        local col = workspace:FindFirstChild("Collectibles")
        if col then
            folders[#folders + 1] = col
        end
        if bubblesOnly then
            -- baloncuklar bazi surumlerde Particles altinda duruyor
            local particles = workspace:FindFirstChild("Particles")
            if particles then
                folders[#folders + 1] = particles
            end
        end

        local strict = S.StayInField and zone
        local prio = (not bubblesOnly) and S.PrioTokenLink
        local best, bestD = nil, math.huge
        local bestLink, bestLinkD = nil, math.huge
        for _, folder in ipairs(folders) do
            for _, p in ipairs(folder:GetChildren()) do
                if (skipped[p] or 0) < now
                    and (p:IsA("BasePart") or p:IsA("Model"))
                    and (not bubblesOnly or string.find(string.lower(p.Name), "bubble"))
                    and (bubblesOnly or S.CollectHoney or not isHoneyToken(p)) then
                    local ok, ppos = pcall(posOf, p)
                    if ok and ppos then
                        local allowed
                        if strict then
                            allowed = inField(zone, ppos, 0) -- sadece tarlanin icindekiler
                        else
                            allowed = flat(ppos, center) <= radius
                        end
                        if allowed and math.abs(ppos.Y - root.Position.Y) < 15 then
                            local d = (ppos - root.Position).Magnitude
                            if d < bestD then
                                best, bestD = p, d
                            end
                            if prio and d < bestLinkD and isTokenLink(p) then
                                bestLink, bestLinkD = p, d
                            end
                        end
                    end
                end
            end
        end
        best = bestLink or best -- Token Link varsa her zaman o once
        st.result = best
        return best
    end

    -- Token ve baloncuklar arasinda: Token Link once, sonra oyuncuya EN YAKIN olan.
    nearestCollectible = function(center, radius, zone)
        local bubble = S.AutoPopBubbles and nearestToken(center, radius, true, zone) or nil
        local token = S.Tokens and nearestToken(center, radius, false, zone) or nil
        if token and S.PrioTokenLink and isTokenLink(token) then
            return token
        end
        if bubble and token and bubble ~= token then
            local root = hrp()
            local bp, tp = posOf(bubble), posOf(token)
            if root and bp and tp then
                return ((bp - root.Position).Magnitude <= (tp - root.Position).Magnitude) and bubble or token
            end
        end
        return bubble or token
    end

    -- Yakindaki tokenlerin adini / dokusunu yazdirir (Token Link dokusunu dogrulamak icin)
    tokenKit.debug = function()
        print("[BSSFarm] ---------------- token debug ----------------")
        local col = workspace:FindFirstChild("Collectibles")
        local root = hrp()
        if not col or not root then
            print("[BSSFarm] workspace.Collectibles or character missing")
            return
        end
        local list = {}
        for _, p in ipairs(col:GetChildren()) do
            local pos = posOf(p)
            if pos then
                list[#list + 1] = { p = p, d = (pos - root.Position).Magnitude }
            end
        end
        table.sort(list, function(a, b) return a.d < b.d end)
        for i = 1, math.min(15, #list) do
            local p = list[i].p
            local texs = {}
            for _, d in ipairs(p:GetDescendants()) do
                local okt, tex = pcall(textureOf, d)
                if okt and tex and tex ~= "" then
                    texs[#texs + 1] = tex
                end
            end
            local okt, tex = pcall(textureOf, p)
            if okt and tex and tex ~= "" then
                texs[#texs + 1] = tex
            end
            print("[BSSFarm] token:", p.Name, p.ClassName, string.format("%.0f st", list[i].d),
                "| link:", tostring(isTokenLink(p)), "| honey:", tostring(isHoneyToken(p)), "| tex:", table.concat(texs, ", "))
        end
        print("[BSSFarm] collectibles total:", #list)
        setStatus("token debug printed to the console (F9)")
    end
end

local function chaseToken(token, zone)
    local root = hrp()
    if not root or not token or not token.Parent then
        return false
    end
    local tokenPos = posOf(token)
    if not tokenPos then
        return false
    end

    local destination
    if S.StayInField and zone then
        destination = clampToField(zone, tokenPos) -- tarlanin ICINDE, zemin seviyesinde
    else
        destination = tokenPos + Vector3.new(0, 2, 0)
    end

    local startCFrame = root.CFrame
    local goalCFrame = CFrame.new(destination) * (startCFrame - startCFrame.Position)
    local distance = (destination - root.Position).Magnitude
    if distance < 3 then
        task.wait()
        if token.Parent then
            skipped[token] = tick() + 1
        end
        return not token.Parent
    end

    local duration = distance / S.TokenTweenSpeed
    if duration < 0.25 then
        duration = 0.25
    end
    if duration > S.TweenMaxTime then
        duration = S.TweenMaxTime
    end
    local started = tick()
    while running and S.AutoFarm and token.Parent and tick() - started < duration do
        local alpha = (tick() - started) / duration
        if alpha > 1 then
            alpha = 1
        end
        local eased = alpha * alpha * (3 - 2 * alpha)
        root = hrp()
        if not root then
            return false
        end
        if S.Noclip and env.BSSMondo and env.BSSMondo.loot then
            env.BSSNoclipUntil = tick() + 0.3
        end
        root.CFrame = startCFrame:Lerp(goalCFrame, eased)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        RunService.Heartbeat:Wait()
    end

    root = hrp()
    if root then
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
    if token.Parent then
        skipped[token] = tick() + 1
    end
    return not token.Parent
end

-- Konum alinabilen bir hedef (Folder ise ilk BasePart'i kullanir)
local function targetPos(inst)
    if not inst then
        return nil
    end
    local p = posOf(inst)
    if p then
        return p
    end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BasePart") then
            return d.Position
        end
    end
    return nil
end

-- Klasorlerde (2 seviye derinlige kadar) isim kalibina gore hedef ara
local function scanFor(rootNames, needle, wantModelOnly, filter)
    for _, rn in ipairs(rootNames) do
        local folder = workspace:FindFirstChild(rn)
        if folder then
            for _, inst in ipairs(folder:GetChildren()) do
                local function check(i)
                    local nameOk
                    if filter then
                        nameOk = filter(i)
                    else
                        nameOk = string.find(string.lower(i.Name), needle, 1, true) ~= nil
                    end
                    if nameOk
                        and (i:IsA("Model") or i:IsA("BasePart") or (not wantModelOnly and i:IsA("Folder"))) then
                        local h = i:FindFirstChildOfClass("Humanoid")
                        if (not h or h.Health > 0) and targetPos(i) then
                            return true
                        end
                    end
                    return false
                end
                if check(inst) then
                    return inst
                end
                if inst:IsA("Folder") or inst:IsA("Model") then
                    for _, sub in ipairs(inst:GetChildren()) do
                        if check(sub) then
                            return sub
                        end
                    end
                end
            end
        end
    end
    return nil
end

