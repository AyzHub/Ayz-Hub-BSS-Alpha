-- ------------------------------------------------------- Precise Bee: Target Practice
-- Precise Bee tarlada 3 hedef (target) olusturur; hepsinin USTUNDEN gecmek (kosmak) bonus verir.
-- Hedefler oyun sirasinda olustugu icin sadece workspace'e SONRADAN eklenenler alinir
-- (haritadaki sabit dekorlar karismasin).
--
-- v17 duzeltmeleri:
--   * Hedef tek bir Part/Model olmayabilir: "Targets" gibi bir Folder / Model icinde 3 parca
--     olabilir ve parcalarin adinda "target" gecmeyebilir. Kapsayici bulununca icindeki her
--     parca ayri hedef sayilir (her adimda yeniden okunur, cocuklar gec gelse de yakalanir).
--   * Ad arama genisledi: target / bullseye / crosshair / practice.
--   * Sadece DescendantAdded'a guvenilmiyor: Particles / Collectibles klasorleri de taranir
--     (oyun ayni nesneyi yeniden kullaniyorsa DescendantAdded tetiklenmez).
--   * Hedefin USTUNE isinlanip havada durmak yerine, zemine (ayakta durma yuksekligine) inilir
--     ve kisa sure hedefin uzerinde YURUNUR; boylece "uzerinden gecti" kontrolu gercek hareketle
--     tetiklenir. Duvar-gecme (noclip) bu sirada kapatilir.
--   * Hedef adimi artik canta DOLU olsa bile kovana donmeden once calisir (hedefler kisa omurlu).
--   * "Target debug (F9)" artik son eklenen nesneleri ve Particles / Collectibles icindeki
--     adlari da yazdirir: ad yine uymuyorsa buradan hemen gorulur.
local targetKit = { set = {}, done = setmetatable({}, { __mode = "k" }),
    seen = setmetatable({}, { __mode = "k" }), donePos = {},
    recent = {}, recentIdx = 0, scanAt = 0,
    sess = { active = false, startAt = 0, lastAt = 0, count = 0 } }

targetKit.KEYS = { "target", "bullseye", "crosshair", "practice" }
targetKit.BAD = { "gui", "monster", "dummy", "enemy", "mob", "lock", "position", "beam", "attach" }

-- ucuz on-filtre (kucuk harfe cevirip yeni string uretmez)
targetKit.mayMatch = function(name)
    return string.find(name, "[Tt][Aa][Rr][Gg][Ee][Tt]") ~= nil
        or string.find(name, "[Bb][Uu][Ll][Ll][Ss]") ~= nil
        or string.find(name, "[Cc][Rr][Oo][Ss][Ss][Hh]") ~= nil
        or string.find(name, "[Pp][Rr][Aa][Cc][Tt][Ii][Cc][Ee]") ~= nil
end

targetKit.nameOk = function(name)
    local n = string.lower(name)
    local hit = false
    for _, k in ipairs(targetKit.KEYS) do
        if string.find(n, k, 1, true) then
            hit = true
            break
        end
    end
    if not hit then
        return false
    end
    for _, w in ipairs(targetKit.BAD) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    return true
end

-- Hedef ya da hedef KAPSAYICISI (Part / Model / Folder) mi?
targetKit.check = function(inst)
    if not (inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Folder")) then
        return false
    end
    if not targetKit.nameOk(inst.Name) then
        return false
    end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
        return false
    end
    if inOwnArea(inst) then
        return false
    end
    return true
end

targetKit.register = function(inst)
    -- ust nesnesi zaten listedeyse (ayni hedefin parcasi) ekleme
    local a = inst.Parent
    while a and a ~= workspace do
        if targetKit.set[a] then
            return
        end
        a = a.Parent
    end
    targetKit.done[inst] = nil -- oyun nesneyi yeniden kullaniyorsa yeni hedef say
    targetKit.seen[inst] = true
    targetKit.set[inst] = tick()
end

connect(workspace.DescendantAdded, function(inst)
    if not S.PreciseTargets then
        return
    end
    -- son eklenenler (sadece debug icin): workspace ve ust klasorlerinin dogrudan cocuklari
    local par = inst.Parent
    if par and (par == workspace or par.Parent == workspace) then
        local idx = targetKit.recentIdx % 80 + 1
        targetKit.recentIdx = idx
        targetKit.recent[idx] = { n = inst.Name, c = inst.ClassName, p = par.Name, t = tick() }
    end
    if targetKit.mayMatch(inst.Name) and targetKit.check(inst) then
        targetKit.register(inst)
    end
end)

-- Particles / Collectibles klasorlerini ara sira tara (nesne yeniden kullaniliyorsa
-- DescendantAdded tetiklenmez). Sadece daha once gorulmemis olanlar eklenir.
targetKit.scan = function()
    for _, fname in ipairs({ "Particles", "Collectibles" }) do
        local folder = workspace:FindFirstChild(fname)
        if folder then
            for _, ch in ipairs(folder:GetChildren()) do
                if not targetKit.seen[ch] and targetKit.mayMatch(ch.Name) and targetKit.check(ch) then
                    targetKit.register(ch)
                elseif ch:IsA("Folder") then
                    -- ic ice klasor (ornegin Particles/Targets/...): bir seviye icine de bak
                    local subs = ch:GetChildren()
                    if #subs <= 200 then
                        for _, sub in ipairs(subs) do
                            if not targetKit.seen[sub] and targetKit.mayMatch(sub.Name) and targetKit.check(sub) then
                                targetKit.register(sub)
                            end
                        end
                    end
                end
            end
        end
    end
end

targetKit.endSession = function(clearAll)
    targetKit.sess.active = false
    targetKit.sess.count = 0
    if clearAll then
        targetKit.set = {}
    end
end

-- Kapsayici / hedef icindeki gercek hedef parcalarini listeler
targetKit.expand = function(inst, out, depth)
    if inst:IsA("BasePart") then
        out[#out + 1] = inst
        return
    end
    if inst:IsA("Folder") then
        if depth < 3 then
            for _, ch in ipairs(inst:GetChildren()) do
                if ch:IsA("BasePart") or ch:IsA("Model") or ch:IsA("Folder") then
                    targetKit.expand(ch, out, depth + 1)
                end
            end
        end
        return
    end
    if inst:IsA("Model") then
        -- Model icinde birbirinden uzak parcalar varsa (3 hedef tek modelde) her biri ayri hedef
        local parts = {}
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") and d.Size.Magnitude <= 40 then
                parts[#parts + 1] = d
                if #parts >= 60 then
                    break
                end
            end
        end
        if #parts >= 2 then
            local p1 = parts[1].Position
            for i = 2, #parts do
                if (parts[i].Position - p1).Magnitude > 10 then
                    for _, part in ipairs(parts) do
                        out[#out + 1] = part
                    end
                    return
                end
            end
        end
        out[#out + 1] = inst
    end
end

targetKit.isDonePos = function(p, now)
    local list = targetKit.donePos
    for i = #list, 1, -1 do
        if list[i].untilT < now then
            table.remove(list, i)
        elseif (list[i].pos - p).Magnitude < 4 then
            return true
        end
    end
    return false
end

-- Hedefin uzerinde ayakta durulacak nokta (zemin + ayakta durma yuksekligi)
targetKit.standPos = function(p, root)
    local h = hum()
    local hip = ((h and h.HipHeight) or 2) + root.Size.Y / 2
    if hip < 2.5 then
        hip = 3 -- R6 gibi HipHeight = 0 olan karakterler
    end
    local z = fieldOfPos(p)
    local gy = z and groundY(z, p.X, p.Z) or p.Y
    if p.Y - gy > 4 then
        return Vector3.new(p.X, p.Y + 1, p.Z) -- havada duran hedef
    end
    return Vector3.new(p.X, gy + hip, p.Z)
end

-- Bir adim: hedeflerin uzerine sirayla gel. Bir sey yaptiysa true; yoksa false (normal is surer).
targetKit.step = function(root)
    if not S.PreciseTargets then
        return false
    end
    local now = tick()
    if now >= targetKit.scanAt then
        targetKit.scanAt = now + 1
        pcall(targetKit.scan)
    end
    local sess = targetKit.sess
    local cands = {}
    for cont, t in pairs(targetKit.set) do
        if not cont.Parent or now - t > 45 then
            targetKit.set[cont] = nil
        else
            local leaves = {}
            pcall(targetKit.expand, cont, leaves, 0)
            for _, leaf in ipairs(leaves) do
                if leaf.Parent and not targetKit.done[leaf] then
                    local p = targetPos(leaf)
                    if p and (p - root.Position).Magnitude <= 150 and fieldOfPos(p)
                        and not targetKit.isDonePos(p, now) then
                        local dup = false
                        for _, c in ipairs(cands) do
                            if (c.pos - p).Magnitude < 4 then
                                dup = true
                                break
                            end
                        end
                        if not dup then
                            cands[#cands + 1] = { inst = leaf, pos = p, t = t, cont = cont }
                        end
                    end
                end
            end
        end
    end

    if sess.active then
        if sess.count >= 3 then
            targetKit.endSession(true) -- 3 hedef tamam: normal ise don
            return false
        end
        if now - sess.startAt > 25 + 3 * S.TargetHoldSec or (#cands == 0 and now - sess.lastAt > 2.5) then
            targetKit.endSession(false)
            return false
        end
    end
    if #cands == 0 then
        return false
    end

    -- diger hedeflerin / parcalarin da olusmasi icin ilkini gorunce kisa bekle
    if not sess.active then
        local oldest = now
        for _, c in ipairs(cands) do
            oldest = math.min(oldest, c.t)
        end
        if #cands < 3 and now - oldest < 0.8 then
            task.wait(0.15)
            return true
        end
        sess.active, sess.startAt, sess.lastAt, sess.count = true, now, now, 0
    end

    -- sira: adlarinda numara varsa numaraya gore, yoksa en yakindan baslayip birbirine yakin sirayla
    local pick
    local numbered = true
    for _, c in ipairs(cands) do
        c.num = tonumber(string.match(c.inst.Name, "%d+"))
        if not c.num then
            numbered = false
        end
    end
    if numbered and #cands > 1 then
        for _, c in ipairs(cands) do
            if not pick or c.num < pick.num then
                pick = c
            end
        end
    else
        local from = (targetKit.lastVisited and targetKit.lastVisitedAt and now - targetKit.lastVisitedAt < 6)
            and targetKit.lastVisited or root.Position
        local bestD
        for _, c in ipairs(cands) do
            local d = (c.pos - from).Magnitude
            if not bestD or d < bestD then
                pick, bestD = c, d
            end
        end
    end

    local inst = pick.inst
    setStatus(string.format("Precise Bee: target %d/3...", sess.count + 1))
    -- 1) hizlica hedefin ustune (zemin yuksekligine) in
    tweenFollow(function()
        if not inst.Parent then
            return nil
        end
        local p = targetPos(inst)
        local r = hrp()
        return (p and r) and targetKit.standPos(p, r) or nil
    end, 2, 8)

    -- 2) hedefin uzerinde YURU: kisa bir daire cizerek (gercek hareket, noclip kapali)
    local h = hum()
    local hold = tick()
    local k = 0
    while running and S.AutoFarm and inst.Parent and tick() - hold < S.TargetHoldSec do
        local r, p = hrp(), targetPos(inst)
        if not r or not p then
            break
        end
        env.BSSNoclipUntil = 0 -- zemine bas: noclip'i birak
        local stand = targetKit.standPos(p, r)
        if flat(r.Position, p) > 3.5 or math.abs(r.Position.Y - stand.Y) > 4 then
            -- uzaklastiysa tekrar ustune isinla
            r.CFrame = CFrame.new(stand) * (r.CFrame - r.CFrame.Position)
            r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        if h then
            k = k + 1
            local a = k * 1.7
            h:MoveTo(Vector3.new(p.X + math.cos(a) * 1.6, stand.Y, p.Z + math.sin(a) * 1.6))
        end
        task.wait(0.1)
    end
    if h then
        local r2 = hrp()
        if r2 then
            h:MoveTo(r2.Position)
        end
    end

    local vp = targetPos(inst) or pick.pos
    targetKit.lastVisited = vp
    targetKit.lastVisitedAt = tick()
    targetKit.done[inst] = true
    targetKit.donePos[#targetKit.donePos + 1] = { pos = vp, untilT = tick() + 20 }
    sess.count = sess.count + 1
    sess.lastAt = tick()
    return true
end

