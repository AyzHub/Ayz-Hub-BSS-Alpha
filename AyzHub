-- ------------------------------------------------------- Precise Bee: Target Practice
-- Precise Bee tarlada 3 hedef (target) olusturur; hepsinin USTUNDEN gecmek (kosmak) bonus verir.
-- Hedefler oyun sirasinda olustugu icin sadece workspace'e SONRADAN eklenenler alinir
-- (haritadaki sabit dekorlar karismasin).
--
-- v17 duzeltmeleri:
--   * Hedef tek bir Part/Model olmayabilir: "Targets" gibi bir Folder / Model icinde 3 parca
--     olabilir ve parcalarin adinda "target" gecmeyebilir. Kapsayici bulununca icindeki her
--     parca ayri hedef sayilir (her adimda yeniden okunur, cocuklar gec gelse de yakalanir).
--   * Ad arama genisledi: target / bullseye / crosshair / practice.
--   * Sadece DescendantAdded'a guvenilmiyor: Particles / Collectibles klasorleri de taranir
--     (oyun ayni nesneyi yeniden kullaniyorsa DescendantAdded tetiklenmez).
--   * Hedefin USTUNE isinlanip havada durmak yerine, zemine (ayakta durma yuksekligine) inilir
--     ve kisa sure hedefin uzerinde YURUNUR; boylece "uzerinden gecti" kontrolu gercek hareketle
--     tetiklenir. Duvar-gecme (noclip) bu sirada kapatilir.
--   * Hedef adimi artik canta DOLU olsa bile kovana donmeden once calisir (hedefler kisa omurlu).
--   * "Target debug (F9)" artik son eklenen nesneleri ve Particles / Collectibles icindeki
--     adlari da yazdirir: ad yine uymuyorsa buradan hemen gorulur.
local targetKit = { set = {}, done = setmetatable({}, { __mode = "k" }),
    seen = setmetatable({}, { __mode = "k" }), donePos = {},
    recent = {}, recentIdx = 0, scanAt = 0,
    sess = { active = false, startAt = 0, lastAt = 0, count = 0 } }

targetKit.KEYS = { "target", "bullseye", "crosshair", "practice" }
targetKit.BAD = { "gui", "monster", "dummy", "enemy", "mob", "lock", "position", "beam", "attach" }

-- ucuz on-filtre (kucuk harfe cevirip yeni string uretmez)
targetKit.mayMatch = function(name)
    return string.find(name, "[Tt][Aa][Rr][Gg][Ee][Tt]") ~= nil
        or string.find(name, "[Bb][Uu][Ll][Ll][Ss]") ~= nil
        or string.find(name, "[Cc][Rr][Oo][Ss][Ss][Hh]") ~= nil
        or string.find(name, "[Pp][Rr][Aa][Cc][Tt][Ii][Cc][Ee]") ~= nil
end

targetKit.nameOk = function(name)
    local n = string.lower(name)
    local hit = false
    for _, k in ipairs(targetKit.KEYS) do
        if string.find(n, k, 1, true) then
            hit = true
            break
        end
    end
    if not hit then
        return false
    end
    for _, w in ipairs(targetKit.BAD) do
        if string.find(n, w, 1, true) then
            return false
        end
    end
    return true
end

-- Hedef ya da hedef KAPSAYICISI (Part / Model / Folder) mi?
targetKit.check = function(inst)
    if not (inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Folder")) then
        return false
    end
    if not targetKit.nameOk(inst.Name) then
        return false
    end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
        return false
    end
    if inOwnArea(inst) then
        return false
    end
    return true
end

targetKit.register = function(inst)
    -- ust nesnesi zaten listedeyse (ayni hedefin parcasi) ekleme
    local a = inst.Parent
    while a and a ~= workspace do
        if targetKit.set[a] then
            return
        end
        a = a.Parent
    end
    targetKit.done[inst] = nil -- oyun nesneyi yeniden kullaniyorsa yeni hedef say
    targetKit.seen[inst] = true
    targetKit.set[inst] = tick()
end

connect(workspace.DescendantAdded, function(inst)
    if not S.PreciseTargets then
        return
    end
    -- son eklenenler (sadece debug icin): workspace ve ust klasorlerinin dogrudan cocuklari
    local par = inst.Parent
    if par and (par == workspace or par.Parent == workspace) then
        local idx = targetKit.recentIdx % 80 + 1
        targetKit.recentIdx = idx
        targetKit.recent[idx] = { n = inst.Name, c = inst.ClassName, p = par.Name, t = tick() }
    end
    if targetKit.mayMatch(inst.Name) and targetKit.check(inst) then
        targetKit.register(inst)
    end
end)

-- Particles / Collectibles klasorlerini ara sira tara (nesne yeniden kullaniliyorsa
-- DescendantAdded tetiklenmez). Sadece daha once gorulmemis olanlar eklenir.
targetKit.scan = function()
    for _, fname in ipairs({ "Particles", "Collectibles" }) do
        local folder = workspace:FindFirstChild(fname)
        if folder then
            for _, ch in ipairs(folder:GetChildren()) do
                if not targetKit.seen[ch] and targetKit.mayMatch(ch.Name) and targetKit.check(ch) then
                    targetKit.register(ch)
                elseif ch:IsA("Folder") then
                    -- ic ice klasor (ornegin Particles/Targets/...): bir seviye icine de bak
                    local subs = ch:GetChildren()
                    if #subs <= 200 then
                        for _, sub in ipairs(subs) do
                            if not targetKit.seen[sub] and targetKit.mayMatch(sub.Name) and targetKit.check(sub) then
                                targetKit.register(sub)
                            end
                        end
                    end
                end
            end
        end
    end
end

targetKit.endSession = function(clearAll)
    targetKit.sess.active = false
    targetKit.sess.count = 0
    if clearAll then
        targetKit.set = {}
    end
end

-- Kapsayici / hedef icindeki gercek hedef parcalarini listeler
targetKit.expand = function(inst, out, depth)
    if inst:IsA("BasePart") then
        out[#out + 1] = inst
        return
    end
    if inst:IsA("Folder") then
        if depth < 3 then
            for _, ch in ipairs(inst:GetChildren()) do
                if ch:IsA("BasePart") or ch:IsA("Model") or ch:IsA("Folder") then
                    targetKit.expand(ch, out, depth + 1)
                end
            end
        end
        return
    end
    if inst:IsA("Model") then
        -- Model icinde birbirinden uzak parcalar varsa (3 hedef tek modelde) her biri ayri hedef
        local parts = {}
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") and d.Size.Magnitude <= 40 then
                parts[#parts + 1] = d
                if #parts >= 60 then
                    break
                end
            end
        end
        if #parts >= 2 then
            local p1 = parts[1].Position
            for i = 2, #parts do
                if (parts[i].Position - p1).Magnitude > 10 then
                    for _, part in ipairs(parts) do
                        out[#out + 1] = part
                    end
                    return
                end
            end
        end
        out[#out + 1] = inst
    end
end

targetKit.isDonePos = function(p, now)
    local list = targetKit.donePos
    for i = #list, 1, -1 do
        if list[i].untilT < now then
            table.remove(list, i)
        elseif (list[i].pos - p).Magnitude < 4 then
            return true
        end
    end
    return false
end

-- Hedefin uzerinde ayakta durulacak nokta (zemin + ayakta durma yuksekligi)
targetKit.standPos = function(p, root)
    local h = hum()
    local hip = ((h and h.HipHeight) or 2) + root.Size.Y / 2
    if hip < 2.5 then
        hip = 3 -- R6 gibi HipHeight = 0 olan karakterler
    end
    local z = fieldOfPos(p)
    local gy = z and groundY(z, p.X, p.Z) or p.Y
    if p.Y - gy > 4 then
        return Vector3.new(p.X, p.Y + 1, p.Z) -- havada duran hedef
    end
    return Vector3.new(p.X, gy + hip, p.Z)
end

-- Bir adim: hedeflerin uzerine sirayla gel. Bir sey yaptiysa true; yoksa false (normal is surer).
targetKit.step = function(root)
    if not S.PreciseTargets then
        return false
    end
    local now = tick()
    if now >= targetKit.scanAt then
        targetKit.scanAt = now + 1
        pcall(targetKit.scan)
    end
    local sess = targetKit.sess
    local cands = {}
    for cont, t in pairs(targetKit.set) do
        if not cont.Parent or now - t > 45 then
            targetKit.set[cont] = nil
        else
            local leaves = {}
            pcall(targetKit.expand, cont, leaves, 0)
            for _, leaf in ipairs(leaves) do
                if leaf.Parent and not targetKit.done[leaf] then
                    local p = targetPos(leaf)
                    if p and (p - root.Position).Magnitude <= 150 and fieldOfPos(p)
                        and not targetKit.isDonePos(p, now) then
                        local dup = false
                        for _, c in ipairs(cands) do
                            if (c.pos - p).Magnitude < 4 then
                                dup = true
                                break
                            end
                        end
                        if not dup then
                            cands[#cands + 1] = { inst = leaf, pos = p, t = t, cont = cont }
                        end
                    end
                end
            end
        end
    end

    if sess.active then
        if sess.count >= 3 then
            targetKit.endSession(true) -- 3 hedef tamam: normal ise don
            return false
        end
        if now - sess.startAt > 25 + 3 * S.TargetHoldSec or (#cands == 0 and now - sess.lastAt > 2.5) then
            targetKit.endSession(false)
            return false
        end
    end
    if #cands == 0 then
        return false
    end

    -- diger hedeflerin / parcalarin da olusmasi icin ilkini gorunce kisa bekle
    if not sess.active then
        local oldest = now
        for _, c in ipairs(cands) do
            oldest = math.min(oldest, c.t)
        end
        if #cands < 3 and now - oldest < 0.8 then
            task.wait(0.15)
            return true
        end
        sess.active, sess.startAt, sess.lastAt, sess.count = true, now, now, 0
    end

    -- sira: adlarinda numara varsa numaraya gore, yoksa en yakindan baslayip birbirine yakin sirayla
    local pick
    local numbered = true
    for _, c in ipairs(cands) do
        c.num = tonumber(string.match(c.inst.Name, "%d+"))
        if not c.num then
            numbered = false
        end
    end
    if numbered and #cands > 1 then
        for _, c in ipairs(cands) do
            if not pick or c.num < pick.num then
                pick = c
            end
        end
    else
        local from = (targetKit.lastVisited and targetKit.lastVisitedAt and now - targetKit.lastVisitedAt < 6)
            and targetKit.lastVisited or root.Position
        local bestD
        for _, c in ipairs(cands) do
            local d = (c.pos - from).Magnitude
            if not bestD or d < bestD then
                pick, bestD = c, d
            end
        end
    end

    local inst = pick.inst
    setStatus(string.format("Precise Bee: target %d/3...", sess.count + 1))
    -- 1) hizlica hedefin ustune (zemin yuksekligine) in
    tweenFollow(function()
        if not inst.Parent then
            return nil
        end
        local p = targetPos(inst)
        local r = hrp()
        return (p and r) and targetKit.standPos(p, r) or nil
    end, 2, 8)

    -- 2) hedefin uzerinde YURU: kisa bir daire cizerek (gercek hareket, noclip kapali)
    local h = hum()
    local hold = tick()
    local k = 0
    while running and S.AutoFarm and inst.Parent and tick() - hold < S.TargetHoldSec do
        local r, p = hrp(), targetPos(inst)
        if not r or not p then
            break
        end
        env.BSSNoclipUntil = 0 -- zemine bas: noclip'i birak
        local stand = targetKit.standPos(p, r)
        if flat(r.Position, p) > 3.5 or math.abs(r.Position.Y - stand.Y) > 4 then
            -- uzaklastiysa tekrar ustune isinla
            r.CFrame = CFrame.new(stand) * (r.CFrame - r.CFrame.Position)
            r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        if h then
            k = k + 1
            local a = k * 1.7
            h:MoveTo(Vector3.new(p.X + math.cos(a) * 1.6, stand.Y, p.Z + math.sin(a) * 1.6))
        end
        task.wait(0.1)
    end
    if h then
        local r2 = hrp()
        if r2 then
            h:MoveTo(r2.Position)
        end
    end

    local vp = targetPos(inst) or pick.pos
    targetKit.lastVisited = vp
    targetKit.lastVisitedAt = tick()
    targetKit.done[inst] = true
    targetKit.donePos[#targetKit.donePos + 1] = { pos = vp, untilT = tick() + 20 }
    sess.count = sess.count + 1
    sess.lastAt = tick()
    return true
end

targetKit.debug = function()
    print("[BSSFarm] ---------------- target (Precise) debug ----------------")
    local n = 0
    for _ in pairs(targetKit.set) do
        n = n + 1
    end
    print("[BSSFarm] PreciseTargets:", tostring(S.PreciseTargets), "tracked now:", n,
        "session:", tostring(targetKit.sess.active), targetKit.sess.count .. "/3")
    local root = hrp()
    -- 1) adinda target / bullseye / crosshair / practice gecen her sey
    local shown = 0
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if (d:IsA("BasePart") or d:IsA("Model") or d:IsA("Folder")) and targetKit.mayMatch(d.Name) then
                shown = shown + 1
                if shown > 40 then
                    print("[BSSFarm] ...")
                    break
                end
                local pos = targetPos(d)
                print("[BSSFarm] target candidate:", d.ClassName, d:GetFullName(),
                    "-> accepted:", tostring(targetKit.check(d)),
                    "tracked:", tostring(targetKit.set[d] ~= nil),
                    pos and root and string.format("%.0f st", (pos - root.Position).Magnitude) or "")
            end
        end
    end)
    if shown == 0 then
        print("[BSSFarm] nothing named *target/bullseye/crosshair/practice* is in the workspace right now")
        print("[BSSFarm] (press this button while the Precise Bee targets are visible)")
    end
    -- 2) son 60 sn icinde eklenen nesneler: hedefin gercek adi burada gorunur
    print("[BSSFarm] objects added in the last 60 s (workspace / top-level folders):")
    local now = tick()
    local lines = {}
    for _, e in pairs(targetKit.recent) do
        if now - e.t < 60 then
            lines[#lines + 1] = e
        end
    end
    table.sort(lines, function(a, b) return a.t > b.t end)
    for i = 1, math.min(30, #lines) do
        local e = lines[i]
        print("[BSSFarm]   ", string.format("%.0fs ago", now - e.t), e.c, e.p .. "." .. e.n)
    end
    if #lines == 0 then
        print("[BSSFarm]   (none recorded)")
    end
    -- 3) Particles / Collectibles icindeki adlarin ozeti (ad -> adet)
    for _, fname in ipairs({ "Particles", "Collectibles" }) do
        local folder = workspace:FindFirstChild(fname)
        if folder then
            local counts, order = {}, {}
            for _, ch in ipairs(folder:GetChildren()) do
                local key = ch.ClassName .. ":" .. ch.Name
                if not counts[key] then
                    counts[key] = 0
                    order[#order + 1] = key
                end
                counts[key] = counts[key] + 1
            end
            table.sort(order, function(a, b) return counts[a] > counts[b] end)
            local parts = {}
            for i = 1, math.min(25, #order) do
                parts[#parts + 1] = order[i] .. " x" .. counts[order[i]]
            end
            print("[BSSFarm] workspace." .. fname .. " (" .. #folder:GetChildren() .. "): "
                .. (#parts > 0 and table.concat(parts, ", ") or "empty"))
        end
    end
    setStatus("target debug printed to the console (F9)")
end

-- ------------------------------------------------------------ Vicious savasi
-- BSS'te oyuncu dogrudan vurmaz: Vicious'i senin bee'lerin oldurur, bee'ler de yakindaki
-- canavara saldirir. Bu yuzden onemli olan Vicious'in HEMEN YANINDA kalmak ve onun
-- saldirilarindan kacmak. Eski kod tarlaya girince rastgele dolasiyordu (bee'den uzaklasip
-- bee'lerin vurmasini engelliyordu) ya da yanina gidip hareketsiz bekliyordu (olunuyordu).
viciousSignal.fightState = { angle = 0, dir = 1, flipAt = 0, jumpAt = 0, stepAt = 0,
    seenAt = 0, lastPos = nil, fought = false, lootUntil = 0 }

viciousSignal.fight = function(vicious, vpos, vzone, zname)
    local fs = viciousSignal.fightState
    local root, h = hrp(), hum()
    if not root or not h then
        task.wait(0.2)
        return
    end
    fs.seenAt = tick()
    fs.lastPos = vpos
    fs.fought = true
    local R = math.clamp(S.ViciousDistance, 6, 30)
    local dist = flat(root.Position, vpos)

    -- uzaktaysak once yanina git (bee hareket ederse takip et)
    if dist > R + 14 or math.abs(root.Position.Y - vpos.Y) > 40 then
        setStatus("Wild Vicious Bee" .. zname .. ": tweening to it...")
        tweenFollow(function()
            local p = viciousPositionOf(findViciousBee())
            if not p then
                return nil
            end
            local z = fieldOfPos(p)
            local gy = z and (groundY(z, p.X, p.Z) + S.TweenHeight) or p.Y
            return Vector3.new(p.X, gy, p.Z)
        end, R + 2, 12)
        fs.stepAt = 0
        return
    end

    -- Yakindaki tokenlari topla (Vicious'in cevresinde kalarak)
    local tok = tokenNear(vpos, math.max(R + 8, 18))
    if tok then
        setStatus("fighting Wild Vicious Bee" .. zname .. " (grabbing a token)...")
        chaseToken(tok, vzone)
        return
    end

    setStatus("fighting Wild Vicious Bee" .. zname .. " (staying close, dodging)...")
    if tick() - fs.stepAt > 1 then
        -- yeni basladik: bee'nin etrafindaki mevcut acimizdan devam et
        fs.angle = math.atan2(root.Position.Z - vpos.Z, root.Position.X - vpos.X)
    end
    local t0 = tick()
    while running and S.AutoFarm and tick() - t0 < 0.6 do
        local r, hh = hrp(), hum()
        if not r or not hh or hh.Health <= 0 or not viciousAlive(vicious) then
            break
        end
        local vp = viciousPositionOf(vicious) or vpos
        fs.stepAt = tick()
        fs.seenAt = tick()
        fs.lastPos = vp
        if tick() > fs.flipAt then
            fs.dir = -fs.dir -- yonu ara sira degistir: tahmin edilemez ol
            fs.flipAt = tick() + 2.5 + math.random() * 3
        end
        fs.angle = fs.angle + fs.dir * 0.06
        local target = vp + Vector3.new(math.cos(fs.angle) * R, 0, math.sin(fs.angle) * R)
        if vzone then
            target = clampToField(vzone, target)
        end
        hh:MoveTo(target)
        if tick() > fs.jumpAt then
            hh.Jump = true
            fs.jumpAt = tick() + 1.2 + math.random() * 1.5
        end
        task.wait(0.05)
    end
end

-- Bir tarlanin icindeki (yukleniyorsa) Vicious Bee ya da sivrisini ara. Eskiden sadece
-- 8000 nesnelik genel tarama vardi ve tarlada olan bee bazen hic bulunmuyordu.
viciousSignal.scanField = function(z)
    local bee, spike
    local ok, parts = pcall(function()
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = {}
        if player.Character then
            ignore[#ignore + 1] = player.Character
        end
        local col = workspace:FindFirstChild("Collectibles")
        if col then
            ignore[#ignore + 1] = col
        end
        params.FilterDescendantsInstances = ignore
        local cf = (z.CFrame - z.CFrame.Position) + Vector3.new(z.Position.X, fieldTop(z) + 25, z.Position.Z)
        return workspace:GetPartBoundsInBox(cf, Vector3.new(z.Size.X + 30, 90, z.Size.Z + 30), params)
    end)
    if not ok or not parts then
        return nil, nil
    end
    local seen = {}
    for i, part in ipairs(parts) do
        if i > 2000 then
            break
        end
        local a = part
        for _ = 1, 6 do
            if not a or a == workspace then
                break
            end
            if not seen[a] then
                seen[a] = true
                if a:IsA("Model") and isViciousBee(a) and viciousAlive(a) then
                    bee = a
                    break
                elseif not spike and (viciousSignal.skip[a] or 0) < tick() and viciousSignal.isSpike(a) then
                    spike = a
                end
            end
            a = a.Parent
        end
        if bee then
            break
        end
    end
    return bee, spike
end

local function farmStep()
    local h, root = hum(), hrp()
    if not h or not root or h.Health <= 0 then
        task.wait(1)
        return
    end

    if not myHive() then
        setStatus("claiming a hive...")
        claimHive()
        if not myHive() then
            setStatus("could not claim a hive (is one free?)")
            task.wait(2)
            return
        end
    end

    local cap = stat("Capacity")
    local pollen = stat("Pollen")
    local bagFull = S.Convert and cap > 0 and pollen >= cap * (S.ConvertAt / 100)

    -- Vicious Bee dogduysa (canta DOLU olsa bile) her seyden once onun fieldine git ve savas
    if S.KillVicious then
        local vicious = findViciousBee()
        local viciousPos = viciousPositionOf(vicious)
        local fs = viciousSignal.fightState
        if viciousPos then
            local vzone = fieldOfPos(viciousPos)
            local zname = vzone and (" in " .. vzone.Name) or ""
            viciousSignal.fight(vicious, viciousPos, vzone, zname)
            return
        end

        -- Savastaydik ve bee kayboldu: yakindaysak oldu demektir. Gece boyu tekrar arama,
        -- yerine dusen tokenlari (loot) topla.
        if fs.fought then
            fs.fought = false
            if fs.lastPos and flat(root.Position, fs.lastPos) < 70 then
                fs.lootUntil = tick() + 10
                viciousSignal.killedAt = tick()
                for _, key in ipairs(PATROL_KEYS) do
                    patrolVisited[key] = true
                end
            end
        end
        if tick() < fs.lootUntil and fs.lastPos then
            local ltok = tokenNear(fs.lastPos, 60)
            setStatus("Vicious Bee is down: collecting loot...")
            if ltok then
                chaseToken(ltok, nil)
            else
                task.wait(0.3)
            end
            return
        end

        -- Tarlada Vicious'in sivrisi (spike) varsa: bee'yi dogurmak icin ONCE ona dokun
        local spike = viciousSignal.findSpike()
        if spike then
            local sp = targetPos(spike)
            if sp then
                local sz = fieldOfPos(sp)
                setStatus("Vicious spike" .. (sz and (" in " .. sz.Name) or "") .. ": touching it to summon the bee...")
                tweenFollow(function()
                    if not spike.Parent then
                        return nil
                    end
                    local p = targetPos(spike)
                    return p and (p + Vector3.new(0, 1, 0)) or nil
                end, 2, 15)
                -- uzerinde kisa bir sure dur (dokunma / yakinlik tetiklensin)
                local hold = tick()
                while running and S.AutoFarm and spike.Parent and tick() - hold < 0.8 do
                    local r = hrp()
                    local p = targetPos(spike)
                    if not r or not p then
                        break
                    end
                    if S.Noclip then
                        env.BSSNoclipUntil = tick() + 0.3
                    end
                    r.CFrame = CFrame.new(p + Vector3.new(0, 1, 0)) * (r.CFrame - r.CFrame.Position)
                    r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    RunService.Heartbeat:Wait()
                end
                if spike.Parent then
                    -- hala duruyorsa (sarmal dekor olabilir) uzun sure tekrar gitme
                    viciousSignal.skip[spike] = tick() + 600
                else
                    -- dokunduk: bee dogacak, yuklenmesini o tarlada bekle
                    viciousSignal.at = tick()
                    viciousSignal.zone = sz
                    viciousSignal.text = "touched spike"
                end
                viciousScanAt = 0
                return
            end
        end

        -- Oyun "Vicious spawn oldu" dedi ama model henuz gorunmuyor: tarlaya git, yuklenmesini bekle
        local hintZone = viciousHintZone()
        if hintZone then
            if not inField(hintZone, root.Position, 10) then
                setStatus("game says Vicious spawned in " .. hintZone.Name .. ", going there...")
                travelTo(clampToField(hintZone, hintZone.Position), 3)
            else
                setStatus("waiting for Vicious Bee to load in " .. hintZone.Name .. "...")
                task.wait(0.5)
            end
            viciousScanAt = 0
            return
        end

        -- Gece: Vicious'in cikabilecegi tarlalari tek tek gez (her gece bir kez)
        -- (canta doluysa once kovana donulur; arama turu sonra devam eder)
        if S.ViciousPatrol and (nightInfo.night or S.ViciousPatrolAlways) and not bagFull then
            local pz, pkey = nextPatrolZone(root.Position)
            if not pz then
                -- Tur bitti. Vicious gece herhangi bir anda dogabilir; bu yuzden bir sure farm
                -- ettikten sonra (gece suruyorsa) turu bastan baslat. Vicious oldurulduyse bekle.
                viciousSignal.patrolDoneAt = viciousSignal.patrolDoneAt or tick()
                local killedRecently = tick() - (viciousSignal.killedAt or 0) < 600
                local rounds = nightInfo.patrolRounds or 1
                -- "Patrol rounds per night": 0 = sinirsiz, N = en fazla N tur
                local roundsLeft = S.ViciousPatrolRounds <= 0 or rounds < S.ViciousPatrolRounds
                if not roundsLeft and not nightInfo.night
                    and tick() - viciousSignal.patrolDoneAt > 600 then
                    -- gece algilanmiyor (Always modu): sayaci 10 dk sonra sifirla
                    nightInfo.patrolRounds = 1
                    rounds, roundsLeft = 1, true
                end
                if not killedRecently and roundsLeft
                    and tick() - viciousSignal.patrolDoneAt > math.max(5, S.ViciousPatrolRest) then
                    patrolVisited = {}
                    nightInfo.patrolFails = {}
                    nightInfo.patrolRounds = rounds + 1
                    viciousSignal.patrolDoneAt = nil
                    pz, pkey = nextPatrolZone(root.Position)
                end
            else
                viciousSignal.patrolDoneAt = nil
            end
            if pz then
                setStatus("night: checking " .. pz.Name .. " for Vicious Bee...")
                -- once oyundan o tarlanin yuklenmesini iste; varsa dogrudan oraya gidilir
                pcall(function() player:RequestStreamAroundAsync(pz.Position, 2) end)
                task.wait(0.4)
                viciousScanAt = 0
                if findViciousBee() then
                    viciousSignal.at = tick()
                    viciousSignal.zone = pz
                    patrolVisited[pkey] = true
                    return
                end
                local reached = inField(pz, root.Position, 6) or travelTo(clampToField(pz, pz.Position), 3)
                if reached then
                    task.wait(1.5) -- bee'nin yuklenmesi icin kisa bekleme
                    -- tarlanin icini dogrudan tara: Vicious Bee ya da sivrisi
                    local sbee, sspike = viciousSignal.scanField(pz)
                    if sbee then
                        viciousHint = sbee
                    elseif sspike then
                        viciousSignal.spikeCache = sspike
                    end
                    viciousScanAt = 0
                    findViciousBee()
                    patrolVisited[pkey] = true
                else
                    -- ulasilamadi (zaman asimi / olum): ayni tarlayi sonsuza kadar deneme,
                    -- 2 basarisiz denemeden sonra bu tur icin gecilmis say
                    nightInfo.patrolFails = nightInfo.patrolFails or {}
                    nightInfo.patrolFails[pkey] = (nightInfo.patrolFails[pkey] or 0) + 1
                    if nightInfo.patrolFails[pkey] >= 2 then
                        nightInfo.patrolFails[pkey] = nil
                        patrolVisited[pkey] = true
                    end
                end
                return
            end
        end
    end

    -- Mondo Chick: dogunca Mountain Top'a git, ustunde uc, oldur, loot'u topla (canta dolu olsa bile once bu)
    if S.KillMondo and env.BSSMondo.step(root) then
        return
    end

    -- Precise Bee hedefleri (kisa omurlu): 3 hedefin uzerinden sirayla gec, sonra normal isine don.
    -- Canta dolu olsa bile kovana donmeden once calisir.
    if S.PreciseTargets and targetKit.step(root) then
        return
    end

    -- Vicious yoksa: canta doluysa kovana don ve polen donustur
    if bagFull then
        convert()
        return
    end

    if S.AutoDispensers and tick() >= nextDispenserAt then
        if collectAllDispensers() then
            nextDispenserAt = tick() + S.DispenserMinutes * 60
        else
            nextDispenserAt = tick() + 10
        end
        return
    end

    if S.PolarQuest and (S.QuestAutoAccept or S.QuestAutoTurnIn) and tick() >= questState.nextVisit then
        questState.nextVisit = tick() + math.max(1, S.QuestRetryMin) * 60
        polarVisit()
        return
    end

    -- (gece bitse bile bekleyen moon charm toplanir: charm gece sonunda degil, bocekler toplaninca verilir)
    if fireflyActive() or (S.ChaseFireflies and fireflyState.charmCenter) then
        local firefly = findFirefly()
        local fireflyPos = targetPos(firefly)
        if fireflyPos then
            setStatus((S.FireflyNightOnly and "night: chasing fireflies" or "chasing fireflies")
                .. (fireflyState.lastCount > 1 and (" (" .. fireflyState.lastCount .. " around)") or "") .. "...")
            fireflyState.charmCenter = nil -- yeni grup basladi: eski charm beklemesi gecersiz
            -- bu tarlaya geldik: "yukleniyor" diye bekleme
            fireflySignal.arrivedAt = tick() - 9
            local goal = fireflyPos + Vector3.new(0, 1.5, 0)
            local d = (goal - root.Position).Magnitude
            if d > 90 then
                -- cok uzaksa once hizlica yaklas (25 st'ye kadar), sonra tween
                travelTo(goal + (root.Position - goal).Unit * 25, 3)
                root = hrp()
                if not root then
                    return
                end
                d = (goal - root.Position).Magnitude
            end

            -- dogrudan firefly'in USTUNE tween et
            local start = root.CFrame
            local dur = math.clamp(d / S.TokenTweenSpeed, 0.15, S.TweenMaxTime)
            local t0 = tick()
            local lifted = false
            while running and S.AutoFarm and firefly.Parent and tick() - t0 < dur do
                local a = (tick() - t0) / dur
                root = hrp()
                if not root then
                    return
                end
                local cur = targetPos(firefly) or fireflyPos
                if not fireflyState.onGround(cur) then
                    lifted = true -- havalandi: pesinden gitme
                    break
                end
                local goalCF = CFrame.new(cur + Vector3.new(0, 1.5, 0)) * (start - start.Position)
                if S.Noclip then
                    env.BSSNoclipUntil = tick() + 0.3
                end
                root.CFrame = start:Lerp(goalCF, a * a * (3 - 2 * a))
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                RunService.Heartbeat:Wait()
            end
            -- ustunde kisa bir sure dur (temas / yakinlik tetiklensin)
            local hold = tick()
            while running and S.AutoFarm and firefly.Parent and not lifted and tick() - hold < 0.35 do
                root = hrp()
                if not root then
                    return
                end
                local cur = targetPos(firefly) or fireflyPos
                if not fireflyState.onGround(cur) then
                    lifted = true
                    break
                end
                if S.Noclip then
                    env.BSSNoclipUntil = tick() + 0.3
                end
                root.CFrame = CFrame.new(cur + Vector3.new(0, 1.5, 0)) * (root.CFrame - root.CFrame.Position)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                RunService.Heartbeat:Wait()
            end

            root = hrp()
            local cur = (firefly.Parent and targetPos(firefly)) or fireflyPos
            -- bocek kovaladik: bir sure ayni bolgede kalip yenilerini aramaya devam edilir
            if tick() >= (fireflyState.lingerUntil or 0) then
                fireflyState.sessPos = {} -- yeni firefly oturumu
            end
            fireflyState.sessPos[#fireflyState.sessPos + 1] = cur
            fireflyState.lastPos = cur
            fireflyState.lingerUntil = tick() + 8
            if lifted then
                -- havalandi: kisa sure birak, sonra tekrar dene
                fireflyState.markDone(firefly, cur, 5)
            elseif not firefly.Parent then
                -- toplandi / yok oldu
                fireflyTries[firefly] = nil
                fireflyState.markDone(nil, fireflyPos, 3)
            elseif root and (cur - root.Position).Magnitude < 6 then
                -- uzerine ciktik ama hala duruyor: kisa sure birak, sonra tekrar kovala
                fireflyTries[firefly] = nil
                fireflyState.markDone(firefly, cur, 10)
            else
                fireflyTries[firefly] = (fireflyTries[firefly] or 0) + 1
                if fireflyTries[firefly] >= 4 then
                    fireflyTries[firefly] = nil
                    fireflyState.markDone(firefly, cur, S.FireflySkipSec)
                end
            end
            return
        end

        -- Hepsi toplandi: ortada cikan moon charm'i (ve yakindaki tokenleri) topla
        local st = fireflyState
        if not st.charmCenter and tick() >= (st.charmBlockUntil or 0) then
            if st.center and st.size >= 3 and tick() - st.lastSeen < 10 then
                st.charmCenter = st.center
                st.center, st.size = nil, 0
                st.centerUntil = tick() + 40
            elseif st.lastCount == 0 and st.lastPos and #st.sessPos >= 1 and tick() < (st.lingerUntil or 0) then
                -- dunyada hic bocek kalmadi: hepsi toplandi, charm cemberin ortasinda
                local sum = Vector3.new(0, 0, 0)
                for _, q in ipairs(st.sessPos) do
                    sum = sum + q
                end
                st.charmCenter = sum / #st.sessPos
            end
            if st.charmCenter then
                st.charmUntil = tick() + 15 -- token hic dusmezse en gec bu kadar bekle
                st.charmHard = tick() + 40
                st.charmGot, st.charmQuietAt = false, nil
            end
        end
        if st.charmCenter then
            if tick() > st.charmHard or (tick() > st.charmUntil and not st.charmGot) then
                fireflyState.finish() -- token gelmedi: olay bitti, normal farma don
            else
                -- Moon charm, bir tarladaki TUM bocekler toplaninca gece sirasinda token olarak duser
                -- (gece sonunda degil) ve bir gece icinde birden cok kez olabilir. Ortadaki ve son
                -- bocegin yanindaki tokenlari topla; etrafta token kalmayinca olayi bitir.
                local c = st.charmCenter
                local tok = tokenNear(c, 35) or (st.lastPos and tokenNear(st.lastPos, 25)) or nil
                if tok then
                    st.charmQuietAt = nil
                    setStatus("fireflies done: collecting the moon charm...")
                    if chaseToken(tok, nil) then
                        st.charmGot = true
                    end
                    return
                end
                if st.charmGot then
                    -- topladik, etrafta token kalmadi: art arda dusebilir diye kisa bekle, sonra bitir
                    st.charmQuietAt = st.charmQuietAt or tick()
                    if tick() - st.charmQuietAt > 2.5 then
                        fireflyState.finish()
                        return
                    end
                end
                setStatus("fireflies done: waiting for the moon charm...")
                if flat(root.Position, c) > 8 then
                    travelTo(c + Vector3.new(0, 3, 0), 3)
                else
                    task.wait(0.3)
                end
                return
            end
        end

        -- Oyun "ates bocekleri su tarlada" dedi ama nesneler henuz yuklenmedi: oraya git
        local fh = fireflyHint()
        if fh then
            local target
            if fh.pos then
                target = fh.pos + Vector3.new(0, 3, 0)
            else
                target = clampToField(fh.zone, fh.zone.Position)
            end
            local near = (fh.zone and inField(fh.zone, root.Position, 10)) or flat(root.Position, target) < 25
            if not near then
                setStatus("game says fireflies are in " .. (fh.zone and fh.zone.Name or "a field") .. ", going there...")
                travelTo(target, 4)
            else
                fh.arrivedAt = fh.arrivedAt or tick()
                setStatus("waiting for fireflies to load...")
                if tick() > fireflyState.deepAt then
                    fireflyState.deepAt = tick() + 3
                    deepScanFireflies()
                end
                task.wait(0.5)
            end
            return
        end

        -- Son bocekten sonra hemen farma donme: ayni bolgede kal, yeni bocek var mi diye tara,
        -- ortada dusen tokenlari (moon charm dahil) topla.
        local lp = fireflyState.lastPos
        if lp and tick() < (fireflyState.lingerUntil or 0) then
            setStatus("fireflies: looking for more...")
            if flat(root.Position, lp) > 35 then
                travelTo(lp + Vector3.new(0, 3, 0), 3)
            else
                if tick() > fireflyState.deepAt then
                    fireflyState.deepAt = tick() + 3
                    deepScanFireflies()
                end
                local tok = tokenNear(lp, 45)
                if tok then
                    chaseToken(tok, nil)
                else
                    task.wait(0.3)
                end
            end
            return
        end

    end

    -- Etraftaki sticker'lari topla (menzilde varsa), sonra farma don
    if S.AutoStickers and stickerKit.step(root) then
        return
    end

    local zone = fieldZone()
    if not zone then
        setStatus("pick a field first")
        task.wait(0.5)
        return
    end
    local center = zone.Position
    local radius = math.max(8, math.min(zone.Size.X, zone.Size.Z) / 2 - math.max(2, S.FieldMargin))

    -- tarlanin disindaysak, tarlanin ICINE (zemin seviyesine) gidiyoruz
    if not inField(zone, root.Position, 10) then
        setStatus("going to " .. zone.Name .. "...")
        local gx, gz = center.X, center.Z
        moveTo(Vector3.new(gx, groundY(zone, gx, gz) + S.TweenHeight, gz))
        return
    end

    local pct = cap > 0 and math.floor(pollen / cap * 100) or 0
    local tag = (zone.Name ~= S.Field) and "  (quest)" or ""
    setStatus(string.format("farming %s%s   bag %d%%", zone.Name, tag, pct))

    local pick = nearestCollectible(center, radius + S.TokenRange, zone)
    if pick then
        chaseToken(pick, zone)
        return
    end

    local target = patternTarget(center, radius)
    if target then
        walkTo(target, 0.6, function()
            return nearestCollectible(center, radius + S.TokenRange, zone) ~= nil
        end)
    else
        task.wait(0.2)
    end
end

