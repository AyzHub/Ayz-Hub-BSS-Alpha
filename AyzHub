-- true = bu adimda Mondo Chick ile ilgilendik (farmStep geri donsun), false = yapacak is yok
env.BSSMondo.step = function(root)
    local C = env.BSSMondo
    local now = tick()
    if now < C.ignoreUntil then
        return false
    end

    local mondo = C.find()
    if mondo then
        C.firstSeen = C.firstSeen or now
        if now - C.firstSeen > S.MondoGiveUpMin * 60 then
            C.ignoreUntil = now + 600
            C.firstSeen, C.lastPos, C.lootUntil, C.loot, C.holdBase = nil, nil, nil, false, nil
            C.signalAt = 0
            setStatus("Mondo Chick: giving up for 10 min")
            return false
        end
        C.lootUntil, C.loot = nil, false
        C.lootGot = now
        C.holdBase = C.holdBase or C.posOf(mondo)
        setStatus(string.format("Mondo Chick: flying %d st above it...", S.MondoFlyHeight))
        local t0 = tick()
        local speed = math.max(20, S.TravelSpeed)
        while running and S.AutoFarm and S.KillMondo and C.alive(mondo) and tick() - t0 < 3 do
            local cp = C.posOf(mondo)
            if cp then
                C.lastPos = cp
                if S.MondoFollow then
                    C.holdBase = cp
                end
            end
            if S.Noclip then
                env.BSSNoclipUntil = tick() + 0.3
            end
            local goal = C.holdBase + Vector3.new(0, S.MondoFlyHeight, 0)
            RunService.Heartbeat:Wait()
            local r = hrp()
            if not r then
                return true
            end
            local delta = goal - r.Position
            local dist = delta.Magnitude
            local newPos = goal
            if dist > 0.5 then
                newPos = r.Position + delta.Unit * math.min(dist, speed * 0.016)
            end
            r.CFrame = CFrame.new(newPos) * (r.CFrame - r.CFrame.Position)
            r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        return true
    end

    -- Mondo Chick yok: daha once gorduysek oldu demektir -> loot'u topla
    if C.lastPos then
        C.firstSeen, C.holdBase, C.signalAt = nil, nil, 0
        if S.MondoLoot then
            if not C.lootUntil then
                C.lootUntil = now + S.MondoLootSec
                C.lootGot = now
            end
            if now < C.lootUntil then
                local tok = tokenNear(C.lastPos, S.MondoLootRadius)
                if tok then
                    C.lootGot = now
                    C.loot = true
                    setStatus("Mondo Chick dead: collecting loot...")
                    chaseToken(tok, nil)
                    return true
                end
                if now - C.lootGot < 4 then
                    C.loot = true
                    setStatus("Mondo Chick dead: waiting for loot...")
                    if flat(root.Position, C.lastPos) > 10 then
                        travelTo(C.lastPos + Vector3.new(0, 3, 0), 4)
                    else
                        task.wait(0.3)
                    end
                    return true
                end
            end
        end
        C.lastPos, C.lootUntil, C.loot = nil, nil, false
        setStatus("Mondo Chick: done")
    end

    -- bildirim geldi ama model henuz yok: Mountain Top'a git, yuklenmesini bekle
    if now - C.signalAt < 90 then
        local zone = C.zone()
        if zone then
            if not inField(zone, root.Position, 6) then
                setStatus("Mondo Chick spawned: going to Mountain Top...")
                travelTo(clampToField(zone, zone.Position), 3)
            else
                setStatus("Mondo Chick: waiting for it to load...")
                task.wait(0.3)
            end
            return true
        end
    end
    return false
end

-- ------------------------------------------------------------ Sticker toplama
-- Haritada / tarlalarda duran sticker'lari (adinda "sticker" gecen Model / Part ya da uzerinde
-- "sticker" yazan ProximityPrompt) bulur, yanina gider, dokunur / tetikler. Sadece
-- StickerRange icindekileri toplar (oyun streaming kullandigi icin zaten yakindakiler yuklu olur).
-- Adlari kesin bilinmedigi icin "Sticker debug (F9)" butonu eklendi.
local stickerKit = { set = {}, count = 0, scanning = false,
    skip = setmetatable({}, { __mode = "k" }), tries = setmetatable({}, { __mode = "k" }) }
stickerKit.BAD = { "printer", "seeker", "stack", "shop", "npc", "board", "sign", "poster", "statue",
    "display", "decor", "hologram", "dispenser", "icon", "machine", "book", "stand", "frame", "trophy" }

local function stickerBadName(n)
    for _, w in ipairs(stickerKit.BAD) do
        if string.find(n, w, 1, true) then
            return true
        end
    end
    return false
end

-- byPrompt: adi "sticker" icermese de uzerindeki ProximityPrompt "sticker" diyorsa kabul
stickerKit.check = function(inst, byPrompt)
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then
        return false
    end
    local n = string.lower(inst.Name)
    if not byPrompt and not string.find(n, "sticker", 1, true) then
        return false
    end
    if stickerBadName(n) then
        return false
    end
    local a, depth = inst.Parent, 0
    while a and a ~= workspace and depth < 4 do
        if stickerBadName(string.lower(a.Name)) then
            return false
        end
        a, depth = a.Parent, depth + 1
    end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
        return false
    end
    if inOwnArea(inst) then
        return false
    end
    return targetPos(inst) ~= nil
end

connect(workspace.DescendantAdded, function(inst)
    if (S.AutoStickers or S.RemoteStickers) and string.find(inst.Name, "[Ss][Tt][Ii][Cc][Kk][Ee][Rr]") and stickerKit.check(inst) then
        stickerKit.set[inst] = true
    end
end)

stickerKit.scan = function()
    if stickerKit.scanning then
        return
    end
    stickerKit.scanning = true
    task.spawn(function()
        pcall(function()
            local col = workspace:FindFirstChild("Collectibles")
            if col then
                for _, c in ipairs(col:GetChildren()) do
                    if string.find(c.Name, "[Ss][Tt][Ii][Cc][Kk][Ee][Rr]") and stickerKit.check(c) then
                        stickerKit.set[c] = true
                    end
                end
            end
            boundedWalk(workspace, 6, 25000, function(d)
                if string.find(d.Name, "[Ss][Tt][Ii][Cc][Kk][Ee][Rr]") then
                    if stickerKit.check(d) then
                        stickerKit.set[d] = true
                    end
                elseif d:IsA("BasePart") then
                    local pp = d:FindFirstChildOfClass("ProximityPrompt")
                    if pp then
                        local t = string.lower((pp.ObjectText or "") .. " " .. (pp.ActionText or ""))
                        if string.find(t, "sticker", 1, true) and stickerKit.check(d, true) then
                            stickerKit.set[d] = true
                        end
                    end
                end
                return false
            end)
        end)
        stickerKit.scanning = false
    end)
end

task.spawn(function()
    task.wait(3)
    while running do
        if S.AutoStickers or S.RemoteStickers then
            stickerKit.scan()
        end
        task.wait(25)
    end
end)

stickerKit.isSkipped = function(inst, now)
    local a, depth = inst, 0
    while a and a ~= workspace and depth < 4 do
        if (stickerKit.skip[a] or 0) > now then
            return true
        end
        a, depth = a.Parent, depth + 1
    end
    return false
end

-- Menzildeki en yakin sticker
stickerKit.nearest = function(origin)
    local now = tick()
    local best, bestD
    for inst in pairs(stickerKit.set) do
        if not inst.Parent then
            stickerKit.set[inst] = nil
        elseif not stickerKit.isSkipped(inst, now) then
            local p = targetPos(inst)
            if p then
                local d = (p - origin).Magnitude
                if d <= S.StickerRange and (not bestD or d < bestD) and not (env.BSSSprout and env.BSSSprout.blocksPickup and env.BSSSprout.blocksPickup(p)) then
                    best, bestD = inst, d
                end
            end
        end
    end
    return best, bestD
end

-- Dokunmak yetmezse: tiklama / yakinlik tetikleyicileri (executor destekliyorsa)
stickerKit.trigger = function(inst)
    local root = hrp()
    local fpp, fcd, fti = env.fireproximityprompt, env.fireclickdetector, env.firetouchinterest
    local items = { inst }
    for i, d in ipairs(inst:GetDescendants()) do
        items[#items + 1] = d
        if i >= 40 then
            break
        end
    end
    for _, d in ipairs(items) do
        if d:IsA("ProximityPrompt") and type(fpp) == "function" then
            pcall(fpp, d)
        elseif d:IsA("ClickDetector") and type(fcd) == "function" then
            pcall(fcd, d)
        elseif d:IsA("BasePart") and root and type(fti) == "function" and d:FindFirstChildOfClass("TouchTransmitter") then
            pcall(fti, root, d, 0)
            pcall(fti, root, d, 1)
        end
    end
end

-- ------------------------------------------------------------ Uzaktan sticker toplama
-- Duvarda / dekorda / haritada duran TUM sticker'lari karakteri hic hareket ettirmeden,
-- oldugun yerden tetikler: ProximityPrompt (mesafe / bekleme suresi / gorus hatti kontrolu
-- istemci tarafinda gevsetilir), ClickDetector ve dokunma (firetouchinterest). Executor'in
-- bu fonksiyonlari desteklemesi gerekir. Aday listesi stickerKit.set'ten gelir (isimden ve
-- "sticker" yazan ProximityPrompt'lardan; 25 sn'de bir otomatik taranir). Oyun streaming
-- kullandigi icin sadece yuklenmis (yakindaki) sticker'lar gorunur.
-- (Yeni top-level local acilmasin diye stickerKit.remote icinde.)
stickerKit.remote = {
    count = 0, busy = false, label = nil, info = "Remote stickers: off",
    last = setmetatable({}, { __mode = "k" }), tries = setmetatable({}, { __mode = "k" }),
}

stickerKit.remote.fire = function(inst)
    local R = stickerKit.remote
    local root = hrp()
    if not root then
        return false
    end
    local fpp = env.fireproximityprompt or fireproximityprompt
    local fcd = env.fireclickdetector or fireclickdetector
    local fti = env.firetouchinterest or firetouchinterest
    local items = { inst }
    for i, d in ipairs(inst:GetDescendants()) do
        items[#items + 1] = d
        if i >= 60 then
            break
        end
    end
    local did = false
    local inCollectibles = false
    do
        local col = workspace:FindFirstChild("Collectibles")
        inCollectibles = col ~= nil and inst:IsDescendantOf(col)
    end
    for _, d in ipairs(items) do
        if d:IsA("ProximityPrompt") and type(fpp) == "function" then
            pcall(function()
                d.Enabled = true
                d.HoldDuration = 0
                d.RequiresLineOfSight = false
                d.MaxActivationDistance = 100000
            end)
            if pcall(fpp, d) then
                did = true
            end
        elseif d:IsA("ClickDetector") and type(fcd) == "function" then
            pcall(function() d.MaxActivationDistance = 100000 end)
            if pcall(fcd, d) then
                did = true
            end
        elseif d:IsA("BasePart") and type(fti) == "function"
            and (inCollectibles or d:FindFirstChildOfClass("TouchTransmitter")) then
            if pcall(fti, root, d, 0) then
                pcall(fti, root, d, 1)
                did = true
            end
        end
    end
    return did
end

-- Bir tur: bilinen tum sticker'lari (menzil sinirsizsa mesafe fark etmeden) tetikler.
-- Kac sticker tetiklendigini dondurur.
stickerKit.remote.run = function()
    local R = stickerKit.remote
    if R.busy then
        return 0
    end
    local root = hrp()
    if not root then
        return 0
    end
    if not ((env.fireproximityprompt or fireproximityprompt) or (env.fireclickdetector or fireclickdetector)
        or (env.firetouchinterest or firetouchinterest)) then
        R.info = "Remote stickers: your executor has no fireproximityprompt / fireclickdetector / firetouchinterest"
        return 0
    end
    R.busy = true
    local fired, taken = 0, 0
    local ok, err = pcall(function()
        local now = tick()
        local list = {}
        for inst in pairs(stickerKit.set) do
            if not inst.Parent then
                stickerKit.set[inst] = nil
            else
                list[#list + 1] = inst
            end
        end
        for _, inst in ipairs(list) do
            if not running then
                break
            end
            local r2 = hrp()
            if not r2 then
                break
            end
            now = tick()
            local tries = R.tries[inst] or 0
            local wait = tries >= 3 and 300 or 20 -- 3 denemede de gitmediyse (dekor olabilir) 5 dk dokunma
            if inst.Parent and (R.last[inst] or 0) + wait < now then
                local p = targetPos(inst)
                local inRange = true
                if p and S.RemoteStickerRange > 0 then
                    inRange = (p - r2.Position).Magnitude <= S.RemoteStickerRange
                end
                if p and inRange then
                    R.last[inst] = now
                    if R.fire(inst) then
                        fired = fired + 1
                        task.wait(0.15)
                        if not inst.Parent then
                            taken = taken + 1
                            R.count = R.count + 1
                            R.tries[inst] = nil
                        else
                            R.tries[inst] = tries + 1
                        end
                    else
                        R.tries[inst] = tries + 1
                    end
                end
            end
        end
    end)
    R.busy = false
    if not ok then
        warn("[BSSFarm] remote stickers: " .. tostring(err))
    end
    local known = 0
    for _ in pairs(stickerKit.set) do
        known = known + 1
    end
    R.info = string.format("Remote stickers: %d known, %d triggered this round (%d collected so far)",
        known, fired, R.count)
    return fired
end

