-- Tam KELIME eslesmesi: "ant" artik "wanted" / "giant" / "pleasant" icinde bulunmaz
viciousSignal.hasWord = function(t, w)
    local init = 1
    while true do
        local s, e = string.find(t, w, init, true)
        if not s then
            return false
        end
        local before = (s == 1) or not string.match(string.sub(t, s - 1, s - 1), "%a")
        local after = (e == #t) or not string.match(string.sub(t, e + 1, e + 1), "%a")
        if before and after then
            return true
        end
        init = s + 1
    end
end

-- onlySpawn = true: sadece Vicious'in dogabildigi tarlalar aday olur
local function zoneFromText(text, onlySpawn)
    local fz = workspace:FindFirstChild("FlowerZones")
    if not fz then
        return nil
    end
    local t = string.lower(text)
    local best, bestLen = nil, 0
    for _, z in ipairs(fz:GetChildren()) do
        if z:IsA("BasePart") and (not onlySpawn or viciousSignal.isSpawnZone(z)) then
            local full = string.lower(z.Name)
            local short = string.gsub(full, " field$", "")
            local len = 0
            if viciousSignal.hasWord(t, full) then
                len = #full
            elseif viciousSignal.hasWord(t, short) then
                len = #short
            end
            if len > bestLen then
                best, bestLen = z, len
            end
        end
    end
    return best
end

