-- Oyunun RemoteEvent'lerini dinle (sadece okur, hicbir seyi degistirmez)
local function hookRemote(r)
    if not r:IsA("RemoteEvent") then
        return
    end
    local winStart, hits = 0, 0
    connect(r.OnClientEvent, function(...)
        if not (S.KillVicious or S.ChaseFireflies or S.KillMondo) then
            return
        end
        -- saniyede 10'dan cok tetiklenen olaylar duyuru olamaz (token, polen vb.): atla
        local t = os.clock()
        if t - winStart > 1 then
            winStart, hits = t, 0
        end
        hits = hits + 1
        if hits > 10 then
            return
        end
        if fireflyArgsHandler then
            pcall(fireflyArgsHandler, r, ...)
        end
        if not (S.KillVicious or S.KillMondo) then
            return
        end
        local n = select("#", ...)
        for i = 1, math.min(n, 6) do
            local a = select(i, ...)
            if type(a) == "string" then
                onViciousText(a)
            elseif type(a) == "table" then
                local c = 0
                for _, v in pairs(a) do
                    c = c + 1
                    if c > 30 then
                        break
                    end
                    if type(v) == "string" then
                        onViciousText(v)
                    end
                end
            end
        end
    end)
end

